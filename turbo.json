{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["API_URL"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "outputs": ["test-dist/**"]
    },
    "clean": {
      "cache": false
    },
    "@acropora/api#test": {
      "dependsOn": ["build", "^build"],
      "outputs": ["test-dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/mobile/src/**",
        "$TURBO_ROOT$/apps/mobile/tsconfig.test.json",
        "$TURBO_ROOT$/apps/web/src/**"
      ]
    }
  }
}
