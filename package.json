{
  "name": "acropora-os",
  "version": "0.1.0",
  "private": true,
  "description": "Magyar nyelvű, moduláris vállalatirányítási rendszer.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@acropora/web --filter=@acropora/api",
    "dev:mobile": "npm --prefix apps/mobile run dev",
    "dev:mobile:go": "npm --prefix apps/mobile run start:go",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:validate": "pnpm --filter @acropora/database db:validate",
    "db:format": "pnpm --filter @acropora/database db:format",
    "prisma:generate": "pnpm --filter @acropora/database prisma:generate",
    "prisma:deploy": "pnpm --filter @acropora/database prisma:deploy",
    "prisma:migrate": "pnpm --filter @acropora/database prisma:migrate",
    "prisma:push": "pnpm --filter @acropora/database prisma:push",
    "prisma:studio": "pnpm --filter @acropora/database prisma:studio",
    "prisma:seed": "pnpm --filter @acropora/database prisma:seed",
    "mobile:doctor": "npm --prefix apps/mobile run doctor",
    "mobile:lint": "npm --prefix apps/mobile run lint",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "mobile:test": "npm --prefix apps/mobile run test",
    "mobile:export:web": "npm --prefix apps/mobile run export:web"
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1.1.16": "1.1.18",
      "brace-expansion@2.0.2": "2.1.4",
      "brace-expansion@5.0.7": "5.0.9",
      "picomatch@4.0.3": "4.0.4",
      "sigstore@3.1.0": "4.1.1",
      "tar@7.5.11": "7.5.19",
      "sharp@0.34.5": "0.35.0"
    }
  }
}
