# Futási környezet. Helyi fejlesztéshez maradjon development.
NODE_ENV=development

# PostgreSQL kapcsolat a gyökér docker-compose.yml szolgáltatásához.
DATABASE_URL=postgresql://acropora:acropora@localhost:5432/acropora?schema=public&connect_timeout=2

# Redis kapcsolat queue-khoz, cache-hez és health ellenőrzéshez.
REDIS_URL=redis://localhost:6379

# A felhasználók által elért webalkalmazás publikus címe.
APP_URL=http://localhost:3000

# Szerveroldali sessionök aláírására szolgáló, hosszú véletlen titok.
SESSION_SECRET=replace_with_at_least_32_random_characters

# JWT-k aláírására fenntartott, hosszú véletlen titok.
JWT_SECRET=replace_with_a_different_long_random_secret

# Auth adapter kiválasztása. Jelenleg kizárólag development támogatott.
#
# EZ EGY BIZTONSÁGI KAPCSOLÓ, NEM ÍZLÉS KÉRDÉSE. A fejlesztői bejelentkezés
# (jelszó nélküli belépés a beépített fejlesztői azonosságokkal) CSAK akkor
# működik, ha ennek az értéke pontosan "development". A hiányzó érték TILT.
# Éles telepítésen ez a sor NEM szerepelhet.
#
# Miért külön változó, ha a NODE_ENV már véd: a NODE_ENV minden sablonban ott
# van, tehát egy másolt környezeti fájllal együtt utazik. Egy erre az egy célra
# elnevezett változót nem másol be senki véletlenül.
AUTH_PROVIDER=development

# Az API belső címe és a böngészőből engedélyezett web origin.
API_URL=http://localhost:3001

# A belső AI teszt-felület a szerveroldali rétegen át hívja az AI szolgáltatást.
# A böngésző SOHA nem kapja meg ezt a tokent: az API folyamatában marad.
# A cím a STAGE AI telepítésé; éles AI nem épül, mert a felület belső mérésre
# való, és ügyfél nem találkozik vele.
ACROPORA_AI_BASE_URL=https://ai-stage.acropora.hu
ACROPORA_AI_ACCESS_TOKEN=

# A Next.js átírás-proxy időkorlátja ezredmásodpercben. ÜRESEN 50000.
#
# FIGYELEM: ez ÉPÍTÉSI idejű érték, nem futásidejű. A next.config.ts az image
# építésekor olvassa ki, és az érték beleég a bundle-be; futó konténeren
# beállítva CSENDBEN nem csinál semmit. Az építéshez build argumentumként kell
# átadni, ugyanúgy, mint az API_URL értékét.
NEXT_PROXY_TIMEOUT_MS=
WEB_URL=http://localhost:3000
# A PARTNER-PORTÁL saját címe -- KÜLÖN alkalmazás, külön eredettel, tehát nem
# ugyanaz, mint a WEB_URL. Az aláírásra kiküldött munkalap levele ebből építi
# a linket (`partner-portal-link.ts`). ELHAGYHATÓ: hiányzó érték esetén a
# link üresen jelenik meg a levélben, a küldés NEM áll meg emiatt.
PARTNER_URL=http://localhost:3002
PORT=3001

# Az eszközmatricák QR deep link alapja. Fejlesztői buildhez a dev scheme,
# preview/production környezetben a megfelelő app.config.js scheme szükséges.
ASSET_QR_BASE_URL=acropora-os-dev://assets/scan

# UNAS integráció – üresen hagyandó, amíg nincs bekötve.
UNAS_API_KEY=
# Aktív DB credential titkosítási kulcs verziója és a hozzá tartozó pontosan
# 32 véletlen bájt base64 kódolva. Korábbi verziók rotáció alatt megőrzendők.
UNAS_CREDENTIAL_ACTIVE_KEY_VERSION=1
UNAS_CREDENTIAL_MASTER_KEY_V1=
UNAS_API_URL=https://api.unas.eu/shop
# Az UNAS Order.Date emberi, webshop-helyi idő; ebből lesz UTC időpont.
UNAS_SHOP_TIME_ZONE=Europe/Budapest
UNAS_PRODUCT_SYNC_ENABLED=false
UNAS_PRODUCT_SYNC_INTERVAL_MINUTES=15
UNAS_PRODUCT_SYNC_STARTUP_DELAY_SECONDS=30
UNAS_CUSTOMER_SYNC_ENABLED=false
UNAS_CUSTOMER_SYNC_INTERVAL_MINUTES=15
UNAS_CUSTOMER_SYNC_STARTUP_DELAY_SECONDS=30
UNAS_ORDER_SYNC_ENABLED=false
UNAS_ORDER_SYNC_INTERVAL_MINUTES=5
UNAS_ORDER_SYNC_STARTUP_DELAY_SECONDS=30
UNAS_WEBHOOK_SECRET=

# UNAS készletszinkron outbox worker - a leltár/beszerzés/POS/webshop
# folyamatok által (lásd apps/api/src/common/inventory-movement-writer.ts)
# ugyanabban a DB tranzakcióban írt UnasStockSyncOutbox sorokat dolgozza
# fel és publikálja a UNAS setStock API felé, retry/backoff és
# dead-letter kezeléssel. Lásd docs/architecture/inventory-consistency.md.
UNAS_STOCK_SYNC_WORKER_ENABLED=false
UNAS_STOCK_SYNC_WORKER_INTERVAL_SECONDS=15
UNAS_STOCK_SYNC_WORKER_STARTUP_DELAY_SECONDS=30
# Hány outbox-sort claimel egyszerre egy worker-tick.
UNAS_STOCK_SYNC_WORKER_BATCH_SIZE=20
# PROCESSING lease időtartama - ennél tovább PROCESSING állapotban maradt
# sort egy másik (vagy egy később induló) worker-példány elárvultnak
# tekinti és visszaveszi. Legyen érdemben hosszabb, mint a setStock hívás
# legrosszabb esetben várható időtartama (a UNAS kliens saját belső
# retry-jaival együtt).
UNAS_STOCK_SYNC_WORKER_LEASE_SECONDS=120
# Ennyi próbálkozás (nem-végleges hiba esetén) után kerül DEAD_LETTER
# állapotba egy sor - végleges hibánál (pl. érvénytelen kérés) azonnal.
UNAS_STOCK_SYNC_WORKER_MAX_ATTEMPTS=8
# Exponenciális backoff: min(MAX, BASE * 2^(attempts-1)) * jitter(0.75-1.25).
UNAS_STOCK_SYNC_WORKER_BASE_BACKOFF_SECONDS=30
UNAS_STOCK_SYNC_WORKER_MAX_BACKOFF_SECONDS=1800

# UNAS rendelés-törlés reconciliation worker - korlátozott, kötegelt
# létezés-ellenőrzés a helyben még nyitottnak tekintett UNAS-rendelésekre,
# a fizikailag (nem sztornóval!) törölt rendelések felismeréséhez és a
# kint maradt készlet visszaforgatásához. Lásd
# docs/INVENTORY-CONSISTENCY.md "UNAS-ból fizikailag törölt rendelések".
# Alapértelmezetten KIKAPCSOLVA - az egyedi "Rendelés frissítése" gomb
# (UNAS_ORDER_SYNC_ENABLED-től függetlenül mindig elérhető) önmagában is
# felismeri és reconciliálja a törlést, ez a worker csak azokra az
# esetekre ad automatikus védőhálót, amikor egy törölt rendelést senki nem
# frissít kézzel és az sosem kerül elő újra egy inkrementális ablakban.
UNAS_ORDER_DELETION_RECONCILIATION_ENABLED=false
UNAS_ORDER_DELETION_RECONCILIATION_INTERVAL_MINUTES=30
UNAS_ORDER_DELETION_RECONCILIATION_STARTUP_DELAY_SECONDS=60
# Hány rendelést claimel egyszerre egy worker-tick - kicsi és óvatos, mert
# ugyanazt az óránkénti UNAS API-limitet osztja meg minden más UNAS-hívással
# (lásd unas.hu/tudastar/api/limitaciok).
UNAS_ORDER_DELETION_RECONCILIATION_BATCH_SIZE=10
UNAS_ORDER_DELETION_RECONCILIATION_LEASE_SECONDS=120
# Egy megerősítetten még létező rendelés legközelebb ennyi óra múlva kerül
# újra ellenőrzésre - ritka esemény elleni védőháló, nem az inkrementális
# szinkron/kézi frissítés helyettesítője.
UNAS_ORDER_DELETION_RECONCILIATION_RECHECK_HOURS=24
# Átmeneti hiba (hálózat/timeout/hitelesítés/rate limit/5xx/hibás válasz)
# esetén ennyivel rövidebb backoff-fal próbálkozunk újra - ilyen hiba SOHA
# nem minősül törlésnek, csak magát az ellenőrzést ütemezzük újra.
UNAS_ORDER_DELETION_RECONCILIATION_BASE_BACKOFF_SECONDS=60
UNAS_ORDER_DELETION_RECONCILIATION_MAX_BACKOFF_MINUTES=60

# Számlázz.hu integráció – üresen hagyandó, amíg nincs bekötve.
SZAMLAZZ_AGENT_KEY=
SZAMLAZZ_API_URL=https://www.szamlazz.hu/szamla/
SZAMLAZZ_INVOICE_PREFIX=

# NAV Online Számla – adószám alapú cégadat-lekérdezéshez (queryTaxpayer).
# A technikai felhasználót a NAV Online Számla felületén kell létrehozni.
# Teszteléshez: NAV_API_URL=https://api-test.onlineszamla.nav.gov.hu/invoiceService/v3
NAV_API_URL=https://api.onlineszamla.nav.gov.hu/invoiceService/v3
# A Beállítások / NAV oldalon mentett credentialek AES-256-GCM
# titkosításához. Generálás: openssl rand -base64 32
NAV_CREDENTIAL_ACTIVE_KEY_VERSION=1
NAV_CREDENTIAL_MASTER_KEY_V1=
# Első beállítás előtti kompatibilis env-fallback. Sikeres UI-mentés után
# a rendszer már az adatbázisban titkosított készletet használja.
NAV_TECHNICAL_USER_LOGIN=
NAV_TECHNICAL_USER_PASSWORD=
# A technikai felhasználót birtokló saját cég 8 jegyű törzsszáma.
NAV_TECHNICAL_USER_TAX_NUMBER=
NAV_TECHNICAL_USER_SIGN_KEY=
NAV_SOFTWARE_ID=
NAV_SOFTWARE_NAME=Acropora OS
NAV_SOFTWARE_VERSION=1.0
NAV_SOFTWARE_DEV_NAME=
NAV_SOFTWARE_DEV_CONTACT=
NAV_SOFTWARE_DEV_COUNTRY_CODE=HU
NAV_SOFTWARE_DEV_TAX_NUMBER=
NAV_INVOICE_SYNC_ENABLED=false
NAV_INVOICE_SYNC_INTERVAL_MINUTES=15
NAV_INVOICE_SYNC_STARTUP_DELAY_SECONDS=30

# Gmail -> Foxpost heti elszámolás. A Google OAuth kliensnek kizárólag a
# https://www.googleapis.com/auth/gmail.readonly scope szükséges; a folyamat
# nem módosít levelet és nem helyez át/olvasottra semmit. A két forrásfájl
# (Foxpost XLSX + számla PDF) ugyanabban a levélben érkezik.
GMAIL_FOXPOST_SYNC_ENABLED=false
GMAIL_FOXPOST_CLIENT_ID=
GMAIL_FOXPOST_CLIENT_SECRET=
GMAIL_FOXPOST_REFRESH_TOKEN=
GMAIL_FOXPOST_USER=info@acropora.hu
GMAIL_FOXPOST_QUERY=has:attachment filename:xlsx filename:pdf newer_than:90d
GMAIL_FOXPOST_MAX_PAGES=5
GMAIL_FOXPOST_SYNC_INTERVAL_MINUTES=60
GMAIL_FOXPOST_SYNC_STARTUP_DELAY_SECONDS=60
# Teszt/mock végpontokhoz; üresen a Google éles URL-jei használódnak.
GMAIL_API_URL=
GOOGLE_OAUTH_TOKEN_URL=

# Optional external service overrides. Empty values use the application's
# built-in production endpoints where supported.
VIES_API_URL=
MNB_API_URL=

# Git commit SHA exposed by the production build for release diagnostics.
RELEASE_COMMIT_SHA=
# The image-build commit SHA. Docker sets this from its build argument; do not
# copy the runtime value here unless intentionally testing an image override.
RELEASE_IMAGE_COMMIT_SHA=

# Record id (ServiceToken.id) of the one dedicated service token the AI
# user-context endpoint accepts. Not the token itself: the raw value never
# enters configuration, only its hash reaches the ServiceToken table.
#
# Empty means the endpoint rejects everything. A missing allowlist is not the
# same as no restriction.
ACROPORA_AI_USER_CONTEXT_TOKEN_ID=

# -----------------------------------------------------------------------------
# Medusa (webshop) integráció
# -----------------------------------------------------------------------------
# EGYIK MEDUSA-VÁLTOZÓ SEM ÁLLT ITT 2026-09-04-ig, holott a kód kilencet olvas.
# Aki a telepítést állította be, ebből a fájlból nem tudhatta meg, mi kell.
#
# A bolt admin API-jának címe. Nem titok, ezért marad a környezetben.
MEDUSA_ADMIN_URL=
#
# A KULCS KÉT ÚTON JÖHET, és hogy melyiken, azt az adatbázisban tárolt
# kapcsolat-sor `credentialMode` mezője dönti el, NEM ez a fájl:
#
#   ENV_FALLBACK  -> az alábbi MEDUSA_ADMIN_API_KEY KELL, különben a vetítés
#                    MEDUSA_CONNECTION_NOT_CONFIGURED hibával áll meg
#   (tárolt)      -> a kulcs titkosítva ül az adatbázisban, és a lenti
#                    mesterkulccsal oldódik fel; ez a mező akkor ÜRESEN HELYES
#   DISABLED      -> a kapcsolat le van tiltva
#
# Üresen hagyva tehát nem feltétlenül hiány: a Beállítások oldalon megadott,
# tárolt kulcs a preferált út, mert így a titok nem a folyamat környezetében él.
MEDUSA_ADMIN_API_KEY=
#
# A tárolt kulcs mesterkulcsa és az aktív verziószám. A verziószám a VÁLTOZÓ
# NEVÉNEK része: a 2-es verzióhoz MEDUSA_CREDENTIAL_MASTER_KEY_V2 tartozik.
MEDUSA_CREDENTIAL_ACTIVE_KEY_VERSION=1
MEDUSA_CREDENTIAL_MASTER_KEY_V1=
#
# A bolt értékesítési csatornája, amire a vetített termék rákerül. Enélkül a
# vetítés minden terméknél megáll -- nem hibázik, hanem kimondja, hogy nincs
# hova tenni a terméket.
MEDUSA_STOREFRONT_SALES_CHANNEL_ID=

# --- A vetítés ütemezője ---
# ALAPÉRTELMEZÉSBEN KIKAPCSOLT, ÉS EZ VÉDELEM, NEM KÉNYELEM: a vetítés ÍR a
# boltba. Három szint, és a harmadik nem a fejlesztőké:
#
#   a kapcsoló alapértelmezése KIKAPCSOLT;
#   a TESZT környezetben bekapcsolható, a fejlesztésvezető döntésével;
#   az ÉLES bolt ellen bekapcsolni KÜLÖN DÖNTÉS, ÉS AZ BALÁZSÉ.
#
# A bekapcsolás a változó beállítása PLUSZ a szolgáltatás újraindítása: az
# ütemező az alkalmazás indulásakor olvassa a beállítást, egyszer.
MEDUSA_PROJECTION_SCHEDULE_ENABLED=false
# Percben, 5 és 1440 között. Rossz érték INDULÁSKOR dob, nem csendben esik vissza.
MEDUSA_PROJECTION_SCHEDULE_INTERVAL_MINUTES=60

# -----------------------------------------------------------------------------
# Számlázz.hu Agent Key (ADR-014, karbantartási piszkozat-számla)
# -----------------------------------------------------------------------------
# A KULCS KÉT ÚTON JÖHET, a Medusa mintájára -- itt viszont az ENV_FALLBACK út
# a gyakorlatban NEM tervezett: az Agent Key kizárólag a Beállítások oldalon,
# titkosítva kerül be. Ez a változó szándékosan ÜRESEN HELYES.
SZAMLAZZ_AGENT_KEY=
#
# A tárolt kulcs mesterkulcsa és az aktív verziószám -- ugyanaz az alak, mint
# a MEDUSA_CREDENTIAL_MASTER_KEY_V<n> családnál.
SZAMLAZZ_CREDENTIAL_ACTIVE_KEY_VERSION=1
SZAMLAZZ_CREDENTIAL_MASTER_KEY_V1=
# Másodpercben, 0 és 3600 között: ennyit vár az első futás előtt indulás után.
MEDUSA_PROJECTION_SCHEDULE_STARTUP_DELAY_SECONDS=60
# Hány terméket vetít egy kör, 1 és 500 között. A felső korlát nem kényelmi:
# korlátlan kör egy első feltöltésnél az egész katalógust kiküldené egyszerre.
MEDUSA_PROJECTION_SCHEDULE_BATCH_SIZE=25

# -----------------------------------------------------------------------------
# Dokumentum-tároló (a termékképek mestere)
# -----------------------------------------------------------------------------
# HA EZ HIÁNYZIK, A KÖVETKEZŐ TÖRTÉNIK, ÉS EGYIK LÉPÉS SEM HIBÁZIK:
#
#   a képmásoló és a kép-publikáló KÉT KÜLÖN memóriabeli tárolót épít;
#   a másoló beleír az egyikbe, és a sor `storageKey` mezője frissül is;
#   a publikáló a MÁSIKBÓL olvasna, nem talál bájtokat, és kihagyja a képet;
#   a vetítés SIKERESEN lefut, a termék kimegy, csak kép nélkül.
#
# Vagyis a hiánya nem hibát ad, hanem CSENDBEN más viselkedést. Beállítva a
# fájlrendszeres tároló használódik erre a gyökérre, és a két hívás ugyanazt a
# tárolót kapja.
#
# ÉS A BEÁLLÍTÁSA NEM ELÉG: az alkalmazás felhasználójának ÍRNIA is kell tudnia
# oda. Mérve 2026-09-04 a teszt telepítésen: a változó be volt állítva, a kötet
# csatolva volt, ötven giga szabad hellyel -- mindhárom ellenőrizve, két
# embertől, két irányból. A képmásoló mégis elhasalt:
#
#   EACCES: permission denied, mkdir '/data/document-store/products'
#
# A kötet gazdája root volt, az alkalmazás uid 1001 alatt fut. Egy chown
# oldotta fel, és a következő futás vitte át az első képet a boltba.
#
# Amit OLVASNI tudunk, az a beállítás. Amit TUDNI akarunk, az az eredmény.
DOCUMENT_STORE_ROOT=

# -----------------------------------------------------------------------------
# Acropora AI: a token-azonosítók
# -----------------------------------------------------------------------------
# REKORD-AZONOSÍTÓK (ServiceToken.id), NEM a tokenek: a nyers érték soha nem
# kerül a beállításba, csak a lenyomata jut el a ServiceToken táblába.
#
# AZ ÜRES ÉRTÉK "SEMMIT NEM ENGED", nem "mindent enged" -- és az őrző saját
# kommentje mondja meg, miért így van megírva: egy üres engedélylista, ami
# "nincs korlátozás"-t jelentene, egy elfelejtett környezeti változóból nyitott
# ajtót csinálna az egész katalógusra, és a válaszon semmi nem látszana belőle.
ACROPORA_AI_PRODUCT_SEARCH_TOKEN_ID=
# Ugyanez, VESSZŐVEL elválasztott LISTA. Üres lista esetén az őrző elutasít:
# "Szolgáltatás-token szükséges."
ACROPORA_CONTENT_AGENT_TOKEN_IDS=

# -----------------------------------------------------------------------------
# Apple push értesítések (APNs)
# -----------------------------------------------------------------------------
# MIND A NÉGY EGYÜTT KELL. Ha bármelyik hiányzik, a push KIKAPCSOL, és a napló
# megnevezi, mi hiányzik -- a hiány és az értelmezhetetlen érték KÉT KÜLÖN
# naplósor, szándékosan: egy beállítatlan rendszer rendben van (fejlesztői
# gépen nincs kulcs), egy értelmezhetetlen érték viszont hiba.
#
# A kulcs ALAKJÁT a kód FELISMERI, nem a névre épít: a változó neve base64-et
# állít, de egy ide illesztett PEM különben base64-dekódolva szemétként kerülne
# a crypto alá, és a hibaüzenet nem az lenne, hogy rossz a beállítás.
APNS_PRIVATE_KEY_BASE64=
APNS_KEY_ID=
APNS_TEAM_ID=
# Pontosan a `production` vagy a `sandbox` szó. BÁRMI MÁS HIBA, NEM PEDIG OK
# ARRA, HOGY ALAPÉRTELMEZÉST VÁLASSZUNK: egy elgépelés miatt csendben
# productionre váltani éles értesítést küldene egy teszt telepítésből.
APNS_ENVIRONMENT=sandbox

# ANDROIDOS PUSH (Firebase Cloud Messaging, HTTP v1).
#
# EGY VÁLTOZÓ, NEM NÉGY: az Apple oldalán négy külön adat kell, a Google
# oldalán mind a három (projekt, fiók, kulcs) EGY szolgáltatásfiók-JSON-ban áll.
# Szétbontva a telepítő három darabra vágna egy fájlt, és egy darab elcsúszhat.
#
# A NÉV base64-et állít, de a kód FELISMERI AZ ALAKOT: egy ide illesztett nyers
# JSON is átmegy. Enélkül a beillesztés base64-dekódolva szemétté válna, és a
# hiba a JSON-elemzőben jelenne meg -- ott, ahol már nem látszik, hogy a
# beállítás volt rossz.
#
# ÜRESEN HAGYVA AZ ANDROIDOS ÚT KIMARAD, és ez rendben van: a naplóban egy sor
# mondja meg, hogy kikapcsolva fut. Az iOS-út ettől függetlenül működik.
FCM_SERVICE_ACCOUNT_BASE64=

# -----------------------------------------------------------------------------
# Dokumentum-tároló keret
# -----------------------------------------------------------------------------
# ENÉLKÜL NINCS KERET, és ez szándékos: egy kitalált alapértelmezett határ egy
# nap csendben elutasítana egy feltöltést, amiről senki nem döntött. A hiányzó,
# a nulla és az értelmezhetetlen érték ugyanaz -- az ellenőrzés azonnal
# visszatér.
DOCUMENT_STORE_LIMIT_BYTES=

# The new shop hostname joins this comma-separated list after migration; shop.unas.hu is intentionally absent because it is the old platform and will disappear with its subscription.
OWN_IMAGE_REFERENCE_HOSTS=shop.acropora.hu

# -----------------------------------------------------------------------------
# Időkorlátok és release
# -----------------------------------------------------------------------------
# Az API keep-alive időkorlátja. Hiányzó vagy érvénytelen érték esetén 65000 ms.
# A szerver headersTimeout értéke 5000 ms-mal MINDIG e FÖLÖTT áll, hogy ne
# süljön el egy pusztán várakozó kapcsolaton.
API_KEEP_ALIVE_TIMEOUT_MS=
# Melyik repository számít a miénknek a release evidence ellenőrzésekor.
# Üresen a KratoBal/acropora-os értékre esik vissza.
RELEASE_EVIDENCE_EXPECTED_REPOSITORY=

# --- UNAS kapcsolat-újraépítés napi ütemezője ---------------------------------
#
# A teljes kapcsolat-újraépítés (hasonló és kiegészítő termékek) napi egy
# körben, csendes órákban. Azért kell ütemezve, mert a szinkron a VÁLTOZATLAN
# termékek kapcsolatait nem írja újra, tehát az elsodrás az egyszeri
# törlesztés után is termelődik.
#
# HÁROM ZÁR VAN RAJTA, ÉS MIND A HÁROM MÁST FOG MEG:
#   1. az ütemező alapértelmezése KIKAPCSOLT (a futás TÖRÖL, mielőtt újraír);
#   2. az ÍRÁS külön kapcsoló: bekapcsolt ütemező APPLY nélkül csak TERVET
#      készít, és feljegyzi a számokat -- az elsodrás így írás nélkül látszik;
#   3. a nagy változás határát az ütemező SOHA nem lépi át (a
#      `--nagy-valtozas-is` kapcsolót nem adja át), tehát egy elromlott
#      pillanatkép-kinyerés után megáll, nem ír.
UNAS_RELATION_REBUILD_SCHEDULE_ENABLED=false
# Ír-e a futás. `false` mellett terv készül, és a számok akkor is feljegyződnek.
UNAS_RELATION_REBUILD_SCHEDULE_APPLY=false
# A csendes ablak HELYI órákban. A záróóra kizárólag, és az éjfél átlépését a
# beállítás elutasítja (a napi egy kör a helyi naptári napra szól).
UNAS_RELATION_REBUILD_SCHEDULE_WINDOW_START_HOUR=2
UNAS_RELATION_REBUILD_SCHEDULE_WINDOW_END_HOUR=5
# Másodpercben, 0 és 3600 között: ennyit vár az indulás után az első
# ellenőrzéssel. Egy telepítés-hullám ellen ez önmagában NEM elég -- a napi egy
# kört az adatbázisban álló utolsó futás kezdete zárja le, nem ez.
UNAS_RELATION_REBUILD_SCHEDULE_STARTUP_DELAY_SECONDS=300
# Percben, 1 és 720 között: milyen sűrűn ÉBREDÜNK FEL megnézni, hogy esedékes-e.
# Nem ilyen sűrűn futunk: egy naptári napon egy kör megy le.
UNAS_RELATION_REBUILD_SCHEDULE_CHECK_INTERVAL_MINUTES=15

# === A HIBAJEGY NYITÓJÁNAK KÜLDÖTT ÉRTESÍTŐ LEVÉL ===
#
# Balázs döntése (2026-09-21): a levél feladója a ticket@acropora.hu.
#
# A KAPU ALAPÉRTELMEZÉSBEN ZÁRVA, és nem a kulcsok hiányára bízzuk: egy staging
# környezetbe a kulcsok könnyen átmásolódnak, és akkor az a védelem CSENDBEN
# elesik. Csak a kimondott "live" érték nyit; minden más (üres, "true", "on",
# elgépelés) zárva marad.
#
# Hiányzó kulcsokkal az API ELINDUL és NEM küld: a hiányzó beállítás állapot,
# nem hiba.
TICKET_MAIL_MODE=off
# ÚTANKÉNTI KAPCSOLÓK -- a fő kapcsoló ALATT, és mindegyik külön (Balázs kérése,
# 2026-09-22).
#
# A `TICKET_MAIL_MODE` a FŐ kapu: ha az nem "live", ezek közül egyik sem számít.
# Ha viszont a fő kapu nyitva van, akkor MINDEN levélfajtát KÜLÖN kell kinyitni.
#
# MIND AZ ÖT ALAPÉRTELMEZÉSBEN ZÁRVA, és az irány indoka a FELEJTÉS alakja:
# nyitott alapértelmezésnél az elfelejtett beállítás LEVELET KÜLD (a vevőnél
# jelenik meg, visszafordíthatatlan); zártnál NÉMA marad (panasz, nem kár).
#
# Ha a fő kapu nyitva van és egy levél mégsem megy ki, a kihagyás oka
# "path-off" -- az azt mondja meg, hogy EZT az egy kulcsot kell kinyitni, és
# semmi mást.
TICKET_MAIL_WORKSHEET_SIGNED=off
TICKET_MAIL_JOB_OPENED=off
TICKET_MAIL_HANDOVER=off
# A NEGYEDIK: MUNKALAP KIKULDVE ALAIRASRA (Balazs kerese, 2026-09-22).
TICKET_MAIL_WORKSHEET_SEND_FOR_SIGNATURE=off
# AZ OTODIK: A KARBANTARTASI LAP DOKUMENTUMCSOMAGJANAK KIKULDESE (acrobot
# kerese, 2026-09-24, "3.5" szelet -- a hibajegyes HANDOVER mintaja).
TICKET_MAIL_MAINTENANCE_PACKAGE=off
# ÁTIRÁNYÍTÁS EGY PRÓBACÍMRE -- MINDEN KIMENŐ LEVÉLRE, MIND AZ ÖT ÚTRA.
#
# HÁROM ÁLLAPOTA VAN, és a HIÁNYZÓ érték NEM ugyanaz, mint a kimondott `off`:
#
#   <üres vagy beállítatlan>   EGYETLEN levél sem megy ki, semelyik úton.
#                              A napló oka: `no-redirect`.
#   off   vagy   none          A levél a VALÓDI címzettnek megy. Ez a végállapot.
#   egy e-mail cím             Minden levél ERRE a címre megy, a valódi helyett.
#
# MIÉRT MÁS EZ, MINT A FENTI HAT KAPCSOLÓ. Azok azt döntik el, MIT küldünk: egy
# elfelejtett érték ott csendben NEM küld, és az panasz, nem kár. Ez azt dönti
# el, HOVÁ: egy elfelejtett érték itt csendben KIKÜLDENE, és az a vevőnél jelenik
# meg. A két irányú tévedés ára nem egyforma, tehát az alapértelmezésük sem az.
#
# EZÉRT A VÉGÁLLAPOT KIMONDOTT ÉRTÉKEN ÁLL: amikor tényleg a vevőnek kell mennie,
# ide `off` kerül. Így az éles küldés POZITÍV állítás, nem egy üresen hagyott
# mező -- és az "elfelejtettem" meg a "szándékosan" állapot nem néz ki egyformának.
#
# Ha cím áll itt, a törzs ELEJÉN ott áll, kinek ment volna, a tárgy
# `[ÁTIRÁNYÍTVA]` előtagot kap, és a napló-sor kimondja, hogy a címzett NEM
# kapta meg.
#
# A terítés a küldő BURKÁBAN áll, nem a három szolgáltatásban -- így egyik út sem
# tudja megkerülni. Őrző áll rá: `mail-sender-wiring.spec.ts`.
TICKET_MAIL_REDIRECT_TO=
# A LEVELBEN KULDHETO CSATOLMANY FELSO HATARA, BAJTBAN, A BASE64 UTAN SZAMOLVA.
#
# Alapertelmezes 4 MB (4194304). A dokumentalt Gmail-hatar az egyszeru
# `messages/send` vegponton 5 MB; a kulonbseg a level sajat reszenek (targy,
# torzs, fejlecek) hagy helyet.
#
# A MAI MERES, HOGY A KOVETKEZO OLVASO TUDJA, MIHEZ KEPEST ALL ITT EZ A SZAM:
# a legnagyobb eles jegy-csomag 58 553 bajt (2026-09-21, eles adatbazis) --
# base64 utan egyutt 97 204 bajt (a ZIP- es PDF-keret nelkul, tehat ALSO
# becsles). A hatar ehhez kepest ~43-szoros tartalek, nem szazszoros: a
# "szazszoros" eliras volt, a visszameres javitotta. A szam tehat nem a mai
# adathoz van szabva, hanem a vegponthoz.
#
# Hatar felett a kuldes MEGTAGADVA, nem csonkitva: a csomag letoltessel
# atadhato.
HANDOVER_MAIL_MAX_ATTACHMENT_BYTES=4194304

GMAIL_TICKET_CLIENT_ID=
GMAIL_TICKET_CLIENT_SECRET=
GMAIL_TICKET_REFRESH_TOKEN=
# A feladó postafiók. Üresen a kód alapértelmezése a ticket@acropora.hu.
GMAIL_TICKET_USER=
# A `ticket@`-ról menő levelek megjelenített NEVE -- Balázs döntése,
# 2026-09-24 17:06 UTC (emlék 1827): "Acropora Hibajegy kezelő"
# <ticket@acropora.hu>. Üresen ez az alapértelmezés -- NEM a névtelen alak.
# A From fejléc innentől MINDEN ticket@-ról menő levélnél névvel megy, még
# akkor is, ha ez a mező üres marad.
GMAIL_TICKET_USER_NAME=
# A VÍZMÉRÉS-LEVÉL FELADÓJA -- Balázs kérése, 2026-09-24 (Akváriumok szál,
# message_id 1552727165714563153): az ügyfélnek szóló vízmérés-levél az
# info@acropora.hu címről menjen, a többi levél a GMAIL_TICKET_USER-ről.
#
# NEM ÚJ TOKEN: a küldés ugyanazon a `ticket@` Gmail-hitelesítésen megy, ez a
# mező csak a `From:` fejlécet írja felül -- ehhez Balázs a ticket@ fiókban
# beállítja az info@acropora.hu "send as" aliast.
#
# ÜRES ÉRTÉKNÉL a mai viselkedés marad: a GMAIL_TICKET_USER (a fenti névvel
# párosítva) megy feladóként.
AQUARIUM_MEASUREMENT_MAIL_FROM=
# A VÍZMÉRÉS-LEVÉL FELADÓJÁNAK NEVE -- Balázs döntése, 2026-09-24 17:06 UTC
# (emlék 1827): "Acropora Kft." <info@acropora.hu>. Csak akkor kerül a From
# fejlécbe, ha a fenti cím be van állítva. Üresen "Acropora Kft." az
# alapértelmezés -- lásd aquarium-measurement-mail.service.ts.
AQUARIUM_MEASUREMENT_MAIL_FROM_NAME=
