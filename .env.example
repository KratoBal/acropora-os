# Futási környezet. Helyi fejlesztéshez maradjon development.
NODE_ENV=development

# PostgreSQL kapcsolat a gyökér docker-compose.yml szolgáltatásához.
DATABASE_URL=postgresql://acropora:acropora@localhost:5432/acropora?schema=public&connect_timeout=2

# Redis kapcsolat queue-khoz, cache-hez és health ellenőrzéshez.
REDIS_URL=redis://localhost:6379

# A felhasználók által elért webalkalmazás publikus címe.
APP_URL=http://localhost:3000

# Szerveroldali sessionök aláírására szolgáló, hosszú véletlen titok.
SESSION_SECRET=replace_with_at_least_32_random_characters

# JWT-k aláírására fenntartott, hosszú véletlen titok.
JWT_SECRET=replace_with_a_different_long_random_secret

# Auth adapter kiválasztása. Jelenleg kizárólag development támogatott.
#
# EZ EGY BIZTONSÁGI KAPCSOLÓ, NEM ÍZLÉS KÉRDÉSE. A fejlesztői bejelentkezés
# (jelszó nélküli belépés a beépített fejlesztői azonosságokkal) CSAK akkor
# működik, ha ennek az értéke pontosan "development". A hiányzó érték TILT.
# Éles telepítésen ez a sor NEM szerepelhet.
#
# Miért külön változó, ha a NODE_ENV már véd: a NODE_ENV minden sablonban ott
# van, tehát egy másolt környezeti fájllal együtt utazik. Egy erre az egy célra
# elnevezett változót nem másol be senki véletlenül.
AUTH_PROVIDER=development

# Az API belső címe és a böngészőből engedélyezett web origin.
API_URL=http://localhost:3001

# A belső AI teszt-felület a szerveroldali rétegen át hívja az AI szolgáltatást.
# A böngésző SOHA nem kapja meg ezt a tokent: az API folyamatában marad.
# A cím a STAGE AI telepítésé; éles AI nem épül, mert a felület belső mérésre
# való, és ügyfél nem találkozik vele.
ACROPORA_AI_BASE_URL=https://ai-stage.acropora.hu
ACROPORA_AI_ACCESS_TOKEN=

# A Next.js átírás-proxy időkorlátja ezredmásodpercben. ÜRESEN 50000.
#
# FIGYELEM: ez ÉPÍTÉSI idejű érték, nem futásidejű. A next.config.ts az image
# építésekor olvassa ki, és az érték beleég a bundle-be; futó konténeren
# beállítva CSENDBEN nem csinál semmit. Az építéshez build argumentumként kell
# átadni, ugyanúgy, mint az API_URL értékét.
NEXT_PROXY_TIMEOUT_MS=
WEB_URL=http://localhost:3000
PORT=3001

# Az eszközmatricák QR deep link alapja. Fejlesztői buildhez a dev scheme,
# preview/production környezetben a megfelelő app.config.js scheme szükséges.
ASSET_QR_BASE_URL=acropora-os-dev://assets/scan

# UNAS integráció – üresen hagyandó, amíg nincs bekötve.
UNAS_API_KEY=
# Aktív DB credential titkosítási kulcs verziója és a hozzá tartozó pontosan
# 32 véletlen bájt base64 kódolva. Korábbi verziók rotáció alatt megőrzendők.
UNAS_CREDENTIAL_ACTIVE_KEY_VERSION=1
UNAS_CREDENTIAL_MASTER_KEY_V1=
UNAS_API_URL=https://api.unas.eu/shop
# Az UNAS Order.Date emberi, webshop-helyi idő; ebből lesz UTC időpont.
UNAS_SHOP_TIME_ZONE=Europe/Budapest
UNAS_PRODUCT_SYNC_ENABLED=false
UNAS_PRODUCT_SYNC_INTERVAL_MINUTES=15
UNAS_PRODUCT_SYNC_STARTUP_DELAY_SECONDS=30
UNAS_CUSTOMER_SYNC_ENABLED=false
UNAS_CUSTOMER_SYNC_INTERVAL_MINUTES=15
UNAS_CUSTOMER_SYNC_STARTUP_DELAY_SECONDS=30
UNAS_ORDER_SYNC_ENABLED=false
UNAS_ORDER_SYNC_INTERVAL_MINUTES=5
UNAS_ORDER_SYNC_STARTUP_DELAY_SECONDS=30
UNAS_WEBHOOK_SECRET=

# UNAS készletszinkron outbox worker - a leltár/beszerzés/POS/webshop
# folyamatok által (lásd apps/api/src/common/inventory-movement-writer.ts)
# ugyanabban a DB tranzakcióban írt UnasStockSyncOutbox sorokat dolgozza
# fel és publikálja a UNAS setStock API felé, retry/backoff és
# dead-letter kezeléssel. Lásd docs/architecture/inventory-consistency.md.
UNAS_STOCK_SYNC_WORKER_ENABLED=false
UNAS_STOCK_SYNC_WORKER_INTERVAL_SECONDS=15
UNAS_STOCK_SYNC_WORKER_STARTUP_DELAY_SECONDS=30
# Hány outbox-sort claimel egyszerre egy worker-tick.
UNAS_STOCK_SYNC_WORKER_BATCH_SIZE=20
# PROCESSING lease időtartama - ennél tovább PROCESSING állapotban maradt
# sort egy másik (vagy egy később induló) worker-példány elárvultnak
# tekinti és visszaveszi. Legyen érdemben hosszabb, mint a setStock hívás
# legrosszabb esetben várható időtartama (a UNAS kliens saját belső
# retry-jaival együtt).
UNAS_STOCK_SYNC_WORKER_LEASE_SECONDS=120
# Ennyi próbálkozás (nem-végleges hiba esetén) után kerül DEAD_LETTER
# állapotba egy sor - végleges hibánál (pl. érvénytelen kérés) azonnal.
UNAS_STOCK_SYNC_WORKER_MAX_ATTEMPTS=8
# Exponenciális backoff: min(MAX, BASE * 2^(attempts-1)) * jitter(0.75-1.25).
UNAS_STOCK_SYNC_WORKER_BASE_BACKOFF_SECONDS=30
UNAS_STOCK_SYNC_WORKER_MAX_BACKOFF_SECONDS=1800

# UNAS rendelés-törlés reconciliation worker - korlátozott, kötegelt
# létezés-ellenőrzés a helyben még nyitottnak tekintett UNAS-rendelésekre,
# a fizikailag (nem sztornóval!) törölt rendelések felismeréséhez és a
# kint maradt készlet visszaforgatásához. Lásd
# docs/INVENTORY-CONSISTENCY.md "UNAS-ból fizikailag törölt rendelések".
# Alapértelmezetten KIKAPCSOLVA - az egyedi "Rendelés frissítése" gomb
# (UNAS_ORDER_SYNC_ENABLED-től függetlenül mindig elérhető) önmagában is
# felismeri és reconciliálja a törlést, ez a worker csak azokra az
# esetekre ad automatikus védőhálót, amikor egy törölt rendelést senki nem
# frissít kézzel és az sosem kerül elő újra egy inkrementális ablakban.
UNAS_ORDER_DELETION_RECONCILIATION_ENABLED=false
UNAS_ORDER_DELETION_RECONCILIATION_INTERVAL_MINUTES=30
UNAS_ORDER_DELETION_RECONCILIATION_STARTUP_DELAY_SECONDS=60
# Hány rendelést claimel egyszerre egy worker-tick - kicsi és óvatos, mert
# ugyanazt az óránkénti UNAS API-limitet osztja meg minden más UNAS-hívással
# (lásd unas.hu/tudastar/api/limitaciok).
UNAS_ORDER_DELETION_RECONCILIATION_BATCH_SIZE=10
UNAS_ORDER_DELETION_RECONCILIATION_LEASE_SECONDS=120
# Egy megerősítetten még létező rendelés legközelebb ennyi óra múlva kerül
# újra ellenőrzésre - ritka esemény elleni védőháló, nem az inkrementális
# szinkron/kézi frissítés helyettesítője.
UNAS_ORDER_DELETION_RECONCILIATION_RECHECK_HOURS=24
# Átmeneti hiba (hálózat/timeout/hitelesítés/rate limit/5xx/hibás válasz)
# esetén ennyivel rövidebb backoff-fal próbálkozunk újra - ilyen hiba SOHA
# nem minősül törlésnek, csak magát az ellenőrzést ütemezzük újra.
UNAS_ORDER_DELETION_RECONCILIATION_BASE_BACKOFF_SECONDS=60
UNAS_ORDER_DELETION_RECONCILIATION_MAX_BACKOFF_MINUTES=60

# Számlázz.hu integráció – üresen hagyandó, amíg nincs bekötve.
SZAMLAZZ_AGENT_KEY=
SZAMLAZZ_API_URL=https://www.szamlazz.hu/szamla/
SZAMLAZZ_INVOICE_PREFIX=

# NAV Online Számla – adószám alapú cégadat-lekérdezéshez (queryTaxpayer).
# A technikai felhasználót a NAV Online Számla felületén kell létrehozni.
# Teszteléshez: NAV_API_URL=https://api-test.onlineszamla.nav.gov.hu/invoiceService/v3
NAV_API_URL=https://api.onlineszamla.nav.gov.hu/invoiceService/v3
# A Beállítások / NAV oldalon mentett credentialek AES-256-GCM
# titkosításához. Generálás: openssl rand -base64 32
NAV_CREDENTIAL_ACTIVE_KEY_VERSION=1
NAV_CREDENTIAL_MASTER_KEY_V1=
# Első beállítás előtti kompatibilis env-fallback. Sikeres UI-mentés után
# a rendszer már az adatbázisban titkosított készletet használja.
NAV_TECHNICAL_USER_LOGIN=
NAV_TECHNICAL_USER_PASSWORD=
# A technikai felhasználót birtokló saját cég 8 jegyű törzsszáma.
NAV_TECHNICAL_USER_TAX_NUMBER=
NAV_TECHNICAL_USER_SIGN_KEY=
NAV_SOFTWARE_ID=
NAV_SOFTWARE_NAME=Acropora OS
NAV_SOFTWARE_VERSION=1.0
NAV_SOFTWARE_DEV_NAME=
NAV_SOFTWARE_DEV_CONTACT=
NAV_SOFTWARE_DEV_COUNTRY_CODE=HU
NAV_SOFTWARE_DEV_TAX_NUMBER=
NAV_INVOICE_SYNC_ENABLED=false
NAV_INVOICE_SYNC_INTERVAL_MINUTES=15
NAV_INVOICE_SYNC_STARTUP_DELAY_SECONDS=30

# Gmail -> Foxpost heti elszámolás. A Google OAuth kliensnek kizárólag a
# https://www.googleapis.com/auth/gmail.readonly scope szükséges; a folyamat
# nem módosít levelet és nem helyez át/olvasottra semmit. A két forrásfájl
# (Foxpost XLSX + számla PDF) ugyanabban a levélben érkezik.
GMAIL_FOXPOST_SYNC_ENABLED=false
GMAIL_FOXPOST_CLIENT_ID=
GMAIL_FOXPOST_CLIENT_SECRET=
GMAIL_FOXPOST_REFRESH_TOKEN=
GMAIL_FOXPOST_USER=info@acropora.hu
GMAIL_FOXPOST_QUERY=has:attachment filename:xlsx filename:pdf newer_than:90d
GMAIL_FOXPOST_MAX_PAGES=5
GMAIL_FOXPOST_SYNC_INTERVAL_MINUTES=60
GMAIL_FOXPOST_SYNC_STARTUP_DELAY_SECONDS=60
# Teszt/mock végpontokhoz; üresen a Google éles URL-jei használódnak.
GMAIL_API_URL=
GOOGLE_OAUTH_TOKEN_URL=

# Optional external service overrides. Empty values use the application's
# built-in production endpoints where supported.
VIES_API_URL=
MNB_API_URL=

# Git commit SHA exposed by the production build for release diagnostics.
RELEASE_COMMIT_SHA=

# Record id (ServiceToken.id) of the one dedicated service token the AI
# user-context endpoint accepts. Not the token itself: the raw value never
# enters configuration, only its hash reaches the ServiceToken table.
#
# Empty means the endpoint rejects everything. A missing allowlist is not the
# same as no restriction.
ACROPORA_AI_USER_CONTEXT_TOKEN_ID=
