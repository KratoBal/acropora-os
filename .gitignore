# Dependencies
node_modules/
.pnpm-store/

# Build output and caches
.next/
# A Next SAJAT generalt fajlja, alkalmazasonkent kulonbozo tartalommal: minden
# `next build` ujrairja. Kovetve a fa MINDEN build utan piszkos lesz, es a
# valtozas elobb-utobb bekerul valakinek a PR-jebe eszrevetlenul -- pontosan az
# a fajta sor, amit senki nem nez meg, mert nem o irta. (Megtortent: a #709
# hozta be az elozo ilyen sort.)
#
# AMI EZT BIZTONSAGOSSA TESZI, ES AMI NEM: a fajl ket dolgot deklaral, az
# eszkoz-importok (kep, svg) tipusait es az utvonal-tipusokat. Merve
# 2026-09-18: a `tsc --noEmit` MINDKET alkalmazason zold a fajl NELKUL is, meg
# `.next` konyvtar nelkul is -- de ennek az oka az, hogy ma EGYETLEN eszkoz-
# import sincs a fanban. Ha egyszer lesz, a `turbo typecheck` (ami NEM fugg a
# buildtol) hianyolni fogja. Az a bukas HANGOS, es ket uton oldhato: vagy build
# fut elotte, vagy ez a sor kikerul innen, es a fajl visszakerul a repoba.
next-env.d.ts
dist/
# A renamed build directory (`mv dist dist.old-<timestamp>`, to keep a build
# around while rebuilding) no longer matches `dist/`, so git starts tracking
# it. That is exactly how apps/api/dist.old-1784904974 - 486 files of compiled
# output - ended up committed in 0dc1c65.
dist.*/
coverage/
test-dist/
test-dist.*/
.turbo/
*.tsbuildinfo
apps/api/tmp-*-check-dist/
apps/api/tsconfig.*-check.json

# Environment and secrets
.env
.env.*
!.env.example
!.env.production.example
!.env.staging.example

# Logs
*.log
logs/
pnpm-debug.log*

# Editors and operating systems
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Prisma
packages/database/src/generated/

# Local UNAS exports and dry-run artifacts
UnasShop_acropora-unas-hu_*.xlsx
*.unas-dry-run.json
*.import-report.json
import-reports/
tmp/unas-import/

# Database backups and local SQL dumps
*.backup
*.bak
*.dump
*.pgdump
*.sql
!packages/database/prisma/migrations/**/*.sql
!packages/database/prisma/diagnostics/**/*.sql
!**/fixtures/**/*.sql
!**/*.example.sql
acropora-pre-m1.sql

# Real import exports (synthetic fixtures remain allowed)
*.csv
*.xls
*.xlsx
!**/fixtures/**/*.csv
!**/fixtures/**/*.xls
!**/fixtures/**/*.xlsx
!**/*.example.csv
!**/*.example.xls
!**/*.example.xlsx

# Editor scratch files. Six empty ones reached the repository root in a single
# commit on 2026-07-26 and stayed tracked; nothing read them. The pattern is
# anchored to the root because that is where the tool writes them, and an
# unanchored `_tmp_*` would also swallow a deliberately named source file.
/_tmp_*
