# =============================================================================
# Acropora OS — isolated Hetzner/Coolify staging API
# =============================================================================
# Reference only. Store real values in Coolify and mark credentials as secrets.

NODE_ENV=production
PORT=3001

# Dedicated staging resources. Never point these at production.
DATABASE_URL=postgresql://<staging-user>:<staging-password>@<staging-postgres-host>:5432/acropora_staging?schema=public&connection_limit=5&pool_timeout=10
REDIS_URL=redis://<staging-redis-host>:6379

# Staging web origin, if one is deployed. Native apps do not rely on CORS.
WEB_URL=https://erp-staging.example.com

# A staging QR-matricák a külön telepíthető preview mobilappot nyitják meg.
ASSET_QR_BASE_URL=acropora-os-preview://assets/scan

# Required by the current production startup validator. Use staging-specific
# credentials and keep every scheduler disabled.
UNAS_API_KEY=
UNAS_CREDENTIAL_ACTIVE_KEY_VERSION=1
UNAS_CREDENTIAL_MASTER_KEY_V1=
UNAS_API_URL=https://api.unas.eu/shop
UNAS_PRODUCT_SYNC_ENABLED=false
UNAS_PRODUCT_SYNC_INTERVAL_MINUTES=15
UNAS_PRODUCT_SYNC_STARTUP_DELAY_SECONDS=30
UNAS_CUSTOMER_SYNC_ENABLED=false
UNAS_CUSTOMER_SYNC_INTERVAL_MINUTES=15
UNAS_CUSTOMER_SYNC_STARTUP_DELAY_SECONDS=30
UNAS_ORDER_SYNC_ENABLED=false
UNAS_ORDER_SYNC_INTERVAL_MINUTES=5
UNAS_ORDER_SYNC_STARTUP_DELAY_SECONDS=30

# The new shop hostname joins this comma-separated list after migration; shop.unas.hu is intentionally absent because it is the old platform and will disappear with its subscription.
# Without a value every absolute image URL in an imported description is classified as foreign, including our own: ownImageReferenceHosts() falls back to an empty set, so isOwn is false for all of them.
OWN_IMAGE_REFERENCE_HOSTS=shop.acropora.hu

# Leave external integrations disabled/unconfigured until a dedicated staging
# account and synthetic dataset exist.
NAV_INVOICE_SYNC_ENABLED=false
NAV_INVOICE_SYNC_INTERVAL_MINUTES=15
NAV_INVOICE_SYNC_STARTUP_DELAY_SECONDS=30
NAV_API_URL=https://api-test.onlineszamla.nav.gov.hu/invoiceService/v3
NAV_CREDENTIAL_ACTIVE_KEY_VERSION=1
NAV_CREDENTIAL_MASTER_KEY_V1=
NAV_TECHNICAL_USER_LOGIN=
NAV_TECHNICAL_USER_PASSWORD=
NAV_TECHNICAL_USER_TAX_NUMBER=
NAV_TECHNICAL_USER_SIGN_KEY=
NAV_SOFTWARE_ID=
NAV_SOFTWARE_NAME=Acropora OS
NAV_SOFTWARE_VERSION=1.0
NAV_SOFTWARE_DEV_NAME=
NAV_SOFTWARE_DEV_CONTACT=
NAV_SOFTWARE_DEV_COUNTRY_CODE=HU
NAV_SOFTWARE_DEV_TAX_NUMBER=

VIES_API_URL=
MNB_API_URL=
