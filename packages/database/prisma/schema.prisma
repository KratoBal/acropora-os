model UnasConnectionSetting {
  id                        String                 @id
  credentialMode            UnasCredentialMode     @default(ENV_FALLBACK)
  encryptedApiKey           Bytes?
  encryptionIv              Bytes?
  authenticationTag         Bytes?
  keyVersion                String?
  credentialRevision        Int                    @default(0)
  credentialUpdatedAt       DateTime?
  credentialUpdatedByUserId String?
  verificationStatus        UnasVerificationStatus @default(NEVER)
  lastVerifiedAt            DateTime?
  lastVerificationCode      String?
  credentialAttemptedAt     DateTime?
  testAttemptedAt           DateTime?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  credentialUpdatedBy User? @relation("UnasCredentialUpdatedBy", fields: [credentialUpdatedByUserId], references: [id], onDelete: SetNull)

  @@index([credentialUpdatedByUserId])
}

/// NAV Online Számla kapcsolatbeállítás. A teljes technikai felhasználói és
/// szoftver-azonosító készlet egyetlen, verziózott AES-GCM borítékban él:
/// egyik mező sem olvasható vissza a böngészőbe vagy tárolódik plaintextként.
model NavConnectionSetting {
  id                        String                @id
  credentialMode            NavCredentialMode     @default(ENV_FALLBACK)
  encryptedCredentials      Bytes?
  encryptionIv              Bytes?
  authenticationTag         Bytes?
  keyVersion                String?
  credentialRevision        Int                   @default(0)
  credentialUpdatedAt       DateTime?
  credentialUpdatedByUserId String?
  verificationStatus        NavVerificationStatus @default(NEVER)
  lastVerifiedAt            DateTime?
  lastVerificationCode      String?
  credentialAttemptedAt     DateTime?
  testAttemptedAt           DateTime?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  credentialUpdatedBy User? @relation("NavCredentialUpdatedBy", fields: [credentialUpdatedByUserId], references: [id], onDelete: SetNull)

  @@index([credentialUpdatedByUserId])
}

/// Számlázz.hu kapcsolatbeállítás (M8.1, ADR-005) - az UnasConnectionSetting
/// mintáját követi, de két, egymástól független titkosított credentiallel:
/// az Agent kulcs (kimenő automatikus számlázáshoz, M8.2) és a pénzügyi
/// adatkapcsolati kulcs (bejövő/kimenő push fogadás hitelesítéséhez, M8.3)
/// külön kezelendő, mert eltérő Számlázz.hu-oldali jogosultsághoz
/// tartoznak, és külön is rotálhatók/tilthatók.
model SzamlazzConnectionSetting {
  id             String                 @id
  credentialMode SzamlazzCredentialMode @default(ENV_FALLBACK)

  encryptedAgentKey         Bytes?
  agentKeyEncryptionIv      Bytes?
  agentKeyAuthenticationTag Bytes?
  agentKeyVersion           String?

  encryptedFinancialApiKey         Bytes?
  financialApiKeyEncryptionIv      Bytes?
  financialApiKeyAuthenticationTag Bytes?
  financialApiKeyVersion           String?

  credentialRevision        Int                        @default(0)
  credentialUpdatedAt       DateTime?
  credentialUpdatedByUserId String?
  verificationStatus        SzamlazzVerificationStatus @default(NEVER)
  lastVerifiedAt            DateTime?
  lastVerificationCode      String?
  credentialAttemptedAt     DateTime?
  testAttemptedAt           DateTime?
  /// M8.5: a visszamenőleges backfill kezdődátuma, a kapcsolat
  /// aktiválásakor rögzítve - a bulk betöltés ehhez képest dolgozik.
  backfillStartDate         DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  credentialUpdatedBy User? @relation("SzamlazzCredentialUpdatedBy", fields: [credentialUpdatedByUserId], references: [id], onDelete: SetNull)

  @@index([credentialUpdatedByUserId])
}

enum MedusaCredentialMode {
  ENV_FALLBACK
  DATABASE
  DISABLED
}

enum MedusaVerificationStatus {
  NEVER
  SUCCESS
  FAILED
  INDETERMINATE
}

/// Medusa admin kapcsolatbeállítás. Ugyanaz a szerkezet, mint az UNAS és a NAV
/// kapcsolatánál: a titkos admin kulcs verziózott AES-GCM borítékban él, és nem
/// olvasható vissza sem a böngészőbe, sem naplóba.
///
/// Két dolgot érdemes tudni róla, és mind a kettő MÉRT tény a Medusa 2.19.0
/// oldalán, nem feltevés. Az egyik: a titkos kulcs ott TELJES JOGÚ, mert
/// jogkör-választás nincs, tehát ami itt áll, az a kereskedelmi rendszer teljes
/// admin felületét nyitja. A másik: lejárat mint mező nincs, csak késleltetett
/// visszavonás, tehát a kulcs magától soha nem évül el; a csere szándékos
/// művelet, és a `credentialRevision` az, ami a cseréket megkülönbözteti.
model MedusaConnectionSetting {
  id                        String                   @id
  credentialMode            MedusaCredentialMode     @default(ENV_FALLBACK)
  encryptedApiKey           Bytes?
  encryptionIv              Bytes?
  authenticationTag         Bytes?
  keyVersion                String?
  credentialRevision        Int                      @default(0)
  credentialUpdatedAt       DateTime?
  credentialUpdatedByUserId String?
  verificationStatus        MedusaVerificationStatus @default(NEVER)
  lastVerifiedAt            DateTime?
  lastVerificationCode      String?
  credentialAttemptedAt     DateTime?
  testAttemptedAt           DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  credentialUpdatedBy User? @relation("MedusaCredentialUpdatedBy", fields: [credentialUpdatedByUserId], references: [id], onDelete: SetNull)

  @@index([credentialUpdatedByUserId])
}

model UnasProductSyncRun {
  id                        String                   @id @default(cuid())
  activeKey                 String?                  @unique
  kind                      UnasProductSyncKind
  status                    UnasProductSyncRunStatus @default(PENDING)
  windowStart               DateTime?
  windowEnd                 DateTime
  startedAt                 DateTime?
  completedAt               DateTime?
  productsSeen              Int                      @default(0)
  createdCount              Int                      @default(0)
  updatedCount              Int                      @default(0)
  unchangedCount            Int                      @default(0)
  conflictCount             Int                      @default(0)
  missingCount              Int                      @default(0)
  /// Ahány terméket a futás kihagyott, mert a törzsadatát nem a UNAS gondozza.
  /// A többi számláló mellett a helye: egy kihagyás, ami csak a válaszban
  /// látszik, holnap már nem visszakereshető.
  skippedCount              Int                      @default(0)
  /// A kihagyottak közül ahánynál a FORRÁS IS VÁLTOZOTT ugyanabban a futásban.
  ///
  /// Ez a szám a jelzés, nem a `skippedCount`. A kihagyás maga ÁLLANDÓ: minden
  /// futás ugyanazokat a termékeket hagyja ki, tehát a számuk futásról futásra
  /// ugyanaz, és egy szám, ami sosem változik, nem jelzés, hanem alapzaj.
  ///
  /// EZ viszont esemény: azt mondja meg, hogy egy átvett termék szövege a
  /// boltban megváltozott, és mi nem vettük át. A legtöbb futáson nulla, és
  /// pontosan akkor nem az, amikor egy termék elkezd elavulni nálunk.
  skippedSourceChangedCount Int                      @default(0)
  errorCode                 String?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([kind, completedAt])
}

/// Egy webshop (UNAS) rendelés-szinkron futás: a getOrder TimeModStart
/// kurzor alapján lekért, új vagy módosult rendelések feldolgozása.
/// Nincs FULL/INCREMENTAL megkülönböztetés (a UnasProductSyncRun-nal
/// ellentétben) - alacsony rendelésszám mellett minden futás ugyanazt az
/// egy "ami a kurzor óta módosult" ablakot dolgozza fel.
model UnasOrderSyncRun {
  id                 String                 @id @default(cuid())
  activeKey          String?                @unique
  status             UnasOrderSyncRunStatus @default(PENDING)
  windowStart        DateTime?
  windowEnd          DateTime
  startedAt          DateTime?
  completedAt        DateTime?
  ordersSeen         Int                    @default(0)
  createdCount       Int                    @default(0)
  updatedCount       Int                    @default(0)
  reversedCount      Int                    @default(0)
  stockMismatchCount Int                    @default(0)
  errorCode          String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([status, createdAt])
}

/// Egy webshop (UNAS) vásárló-szinkron futás: a getCustomer ModTimeStart
/// kurzoron alapuló, új vagy módosult vásárlók feldolgozása. Az
/// UnasOrderSyncRun mintáját követi: nincs FULL/INCREMENTAL megkülönböztetés,
/// minden futás a kurzor óta módosult ablakot dolgozza fel. A UNAS oldali
/// azonosítót (Customer.Id) kizárólag ExternalReference tárolja, a Customer
/// modellen nincs UNAS-specifikus mező (ld. ADR-0009).
model UnasCustomerSyncRun {
  id             String                    @id @default(cuid())
  activeKey      String?                   @unique
  status         UnasCustomerSyncRunStatus @default(PENDING)
  windowStart    DateTime?
  windowEnd      DateTime
  startedAt      DateTime?
  completedAt    DateTime?
  customersSeen  Int                       @default(0)
  createdCount   Int                       @default(0)
  updatedCount   Int                       @default(0)
  unchangedCount Int                       @default(0)
  errorCode      String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([status, createdAt])
}

/// A Gmailből automatikusan beolvasott, egy levélben érkező Foxpost heti
/// elszámolási XLSX és számla-PDF tartós, idempotens feldolgozási rekordja.
/// A forrásfájlok adatbázisban maradnak, így hibajavítás után külső
/// rendszerhívás nélkül újrafeldolgozhatók és auditálhatók.
model FoxpostSettlement {
  id                 String                  @id @default(cuid())
  gmailMessageId     String                  @unique
  gmailThreadId      String?
  gmailInternalDate  DateTime?
  gmailSubject       String?
  gmailFrom          String?
  xlsxAttachmentId   String
  xlsxFileName       String
  xlsxContent        Bytes
  xlsxSha256         String                  @unique
  pdfAttachmentId    String
  pdfFileName        String
  pdfContent         Bytes
  pdfSha256          String                  @unique
  partnerCode        String?
  settlementCode     String?
  periodStart        DateTime?
  periodEnd          DateTime?
  invoiceNumber      String?                 @unique
  invoiceIssueDate   DateTime?
  currency           String                  @default("HUF") @db.VarChar(3)
  collectedAmount    Decimal?                @db.Decimal(19, 4)
  invoiceGrossAmount Decimal?                @db.Decimal(19, 4)
  transferredAmount  Decimal?                @db.Decimal(19, 4)
  status             FoxpostSettlementStatus @default(PROCESSING)
  errorCode          String?
  processedAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  lines FoxpostSettlementLine[]

  @@unique([partnerCode, settlementCode])
  @@index([status, createdAt])
  @@index([invoiceIssueDate])
}

model FoxpostSettlementLine {
  id                     String                      @id @default(cuid())
  settlementId           String
  sourceRowNumber        Int
  referenceCode          String
  transactionDate        DateTime
  recipientName          String?
  parcelBarcode          String?
  collectedAmount        Decimal                     @db.Decimal(19, 4)
  salesOrderId           String?
  invoiceId              String?
  invoiceNumber          String?
  resolutionSource       FoxpostResolutionSource?
  status                 FoxpostSettlementLineStatus
  errorCode              String?
  manualApprovedByUserId String?
  manualApprovedAt       DateTime?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  settlement       FoxpostSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  salesOrder       SalesOrder?       @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  invoice          Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  manualApprovedBy User?             @relation("FoxpostLineManualApprovedBy", fields: [manualApprovedByUserId], references: [id], onDelete: SetNull)

  @@unique([settlementId, sourceRowNumber])
  @@index([referenceCode])
  @@index([status])
  @@index([salesOrderId])
  @@index([invoiceId])
  @@index([manualApprovedByUserId, manualApprovedAt])
}

/// A könyvelésnek átadható havi Foxpost XLSX mindig újragenerálódik, amikor
/// egy heti elszámolás teljesen feloldhatóvá válik. A bájtok megőrzése
/// garantálja, hogy a letöltött fájl pontosan az automatikus futás eredménye.
model FoxpostMonthlyReport {
  id                 String   @id @default(cuid())
  year               Int
  month              Int
  filename           String
  content            Bytes
  settlementCount    Int
  invoiceCount       Int
  collectedAmount    Decimal  @db.Decimal(19, 4)
  invoiceGrossAmount Decimal  @db.Decimal(19, 4)
  transferredAmount  Decimal  @db.Decimal(19, 4)
  generatedAt        DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([year, month])
  @@index([year, month])
}

model FoxpostSyncRun {
  id               String               @id @default(cuid())
  activeKey        String?              @unique
  status           FoxpostSyncRunStatus @default(RUNNING)
  startedAt        DateTime             @default(now())
  completedAt      DateTime?
  messagesSeen     Int                  @default(0)
  createdCount     Int                  @default(0)
  skippedCount     Int                  @default(0)
  needsReviewCount Int                  @default(0)
  failedCount      Int                  @default(0)
  errorCode        String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([status, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model DomainEvent {
  id            String    @id
  eventType     String
  aggregateType String
  aggregateId   String
  actorUserId   String?
  correlationId String?
  payload       Json
  schemaVersion Int       @default(1)
  occurredAt    DateTime
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([aggregateType, aggregateId, occurredAt])
  @@index([publishedAt, occurredAt])
  @@index([correlationId])
}

enum TaskStatus {
  OPEN
  DONE
}

/// Honnan jött a feladat. A gépi (AGENT) felvitel a flotta ügynökeitől
/// érkezik, egy kizárólag létrehozásra képes service tokennel - lásd a
/// docs/TASKS.md "Gépi felvitel" szakaszát.
enum TaskSource {
  MANUAL
  AGENT
}

/// Személyes feladat- és kérdéslista. Nem projektmenedzsment: egyetlen
/// felelőse van, két állapota, és a fő tartalma a `description` indoklás
/// (miért kérdezzük, mit blokkol), nem a cím.
model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(OPEN)
  /// Külső hivatkozás (jellemzően a Discord-szál URL-je), hogy a tétel a
  /// beszélgetés helyére vezessen vissza. Csak http/https engedett.
  linkUrl     String?
  source      TaskSource @default(MANUAL)
  /// A forrásrendszer saját azonosítója (pl. "polip:required-inputs#1.3").
  /// A [source, sourceRef] egyediség adja a gépi felvitel idempotenciáját:
  /// egy újraküldött tétel nem keletkezik kétszer. Kézi felvitelnél NULL,
  /// és PostgreSQL-ben a NULL minden más NULL-tól különbözik, ezért ez a
  /// kézi tételek számát nem korlátozza.
  sourceRef   String?
  assigneeId  String
  createdById String?
  closedById  String?
  closedAt    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  assignee  User  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  createdBy User? @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  closedBy  User? @relation("TaskClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  @@unique([source, sourceRef])
  @@index([assigneeId, status, createdAt])
}

/// Gépi (ember nélküli) hívó a feladat-felvitelhez. Szándékosan nem User és
/// nem Session: egy session token MINDEN végponton érvényes, és csak a
/// jogosultsági mátrix szűkíti. Ezt a tokent viszont egyetlen végpont
/// fogadja el (POST /tasks/ingest), mert a ServiceTokenGuard sehol máshol
/// nem szerepel a kódbázisban. A korlát így konstrukciós, nem
/// konfigurációs: a token nem azért nem tud mást csinálni, mert nincs rá
/// joga, hanem mert nincs másik végpont, amely elfogadná.
model ServiceToken {
  id        String @id @default(cuid())
  /// Emberi olvasásra szánt név, pl. "Flotta - polip".
  name      String
  /// Névtér-előtag. A token által felvitt minden feladat sourceRef-je
  /// "<slug>:<hivatkozás>" alakban tárolódik, a szerver által összefűzve.
  /// Így két gépi hívó nem tud ütközni egymás egyedi indexén, és nem tud
  /// egymás nevében tételt felvinni.
  slug      String @unique
  /// A nyers token sosem kerül adatbázisba, kizárólag a SHA-256 lenyomata -
  /// ugyanaz az elv, mint a Session.tokenHash mezőnél.
  tokenHash String @unique

  /// Melyik felhasználó NEVÉBEN jár el ez a token.
  ///
  /// NULLÁZHATÓ, mert a már kiadott tokeneknek nincs ilyenjük, és egy hozzáadó
  /// migráció nem találhat ki nekik egyet. AMI EBBŐL KÖVETKEZIK, ÉS AMIT AZ
  /// ŐRZŐNEK TARTANIA KELL: egy felhasználó nélküli token NEM eshet vissza
  /// semmilyen alapértelmezett fiókra, hanem el kell utasítani. Egy csendes
  /// visszaesés itt azt jelentené, hogy egy régi token hirtelen valaki
  /// nevében ír -- és a soron semmi nem mutatná, hogy nem ő volt.
  ///
  /// A `slug` NEM helyettesíti ezt: az a feladat-forrásokat névterezi, nem
  /// a szerzőséget, és nincs mögötte felhasználói jogosultság.
  userId     String?
  user       User?     @relation("ServiceTokenUser", fields: [userId], references: [id], onDelete: SetNull)
  /// Napi felvitel-plafon, elszabadult ügynök-ciklus ellen.
  dailyLimit Int       @default(200)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

/// A strukturalt termek-adatlap, TERMEK szinten.
///
/// Miert nem valtozat szinten: merve (nautilus, 2026-08-31) egy faj a boltban
/// tobb meretben is allhat, de EGY adatlapja van. Valtozat szinten ugyanaz a
/// szoveg tobbszor allna, es a peldanyok elcsuszhatnanak egymastol.
///
/// MINDEN MEZONEK HAROM ALLAPOTA VAN, NEM KETTO:
///   1. van ertek                 -> az oszlop NEM NULL
///   2. hatralek (meg nem nezte)  -> az oszlop NULL, es NINCS ProductDatasheetFieldRefusal sor
///   3. megtagadas (megneztuk, es felelosseggel nem irhato ra semmi)
///                                -> az oszlop NULL, es VAN sor, INDOKKAL
///
/// A 2. es a 3. eddig egyforman nezett ki, es pontosan ezt szunteti meg Balazs
/// dontese (2026-08-31 09:43). A megkulonboztetes NEM ezen a tablan all, hanem a
/// megtagadas-tablan: itt minden ertek-oszlop egyszeruen nullazhato.
model ProductDatasheet {
  id        String   @id @default(cuid())
  productId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A 13 eredeti mezo. A SZOVEG MARAD, a facetta MELLE jon, nem helyette:
  /// egy kulcsszo-kereso a "NEM konnyu" alaku mondatbol "konnyu"-t hozna ki.
  magyarNev           String?
  angolNev            String?
  /// Ma SZOVEG, nem hivatkozas. A taxon-szotar nem letezik, es egy ures
  /// szotarra mutato idegen kulcs MINDEN beszurast elutasitana. Relaciora akkor
  /// valt, ha a taxon-szotar elkeszul es fel van toltve.
  csaladTaxon         String?
  elohelySzoveg       String?
  akvariumMeretSzoveg String?
  maxMeretSzoveg      String?
  kulleme             String?
  tartasa             String?
  viselkedese         String?
  ajanlottEleseg      String?
  erzekenyseg         String?
  tarsithatosag       String?
  erdekesseg          String?

  /// Az ajanlott akvarium merete KET kulonbozo dolgot hordozott egy cellaban:
  /// minimum terfogatot es nepsuruseget. A ketto NEM valthato at egymasba, amig
  /// nem tudjuk, hany peldanyrol van szo. Negybol legalabb egy MINDIG ures lesz,
  /// es az itt NEM hiany, hanem "erre a tetelre nem ez a fajta adat vonatkozik".
  minLiter       Decimal?        @db.Decimal(10, 2)
  literPerEgyed  Decimal?        @db.Decimal(10, 2)
  meretKategoria MeretKategoria?

  /// A maximalis meretnel a szam mellé kell, hogy MIT mertek: a 25 cm
  /// karfesztavolsag es a 25 cm testhossz ugyanaz a szam, de mas allat.
  meretMin      Decimal?       @db.Decimal(10, 2)
  meretMax      Decimal?       @db.Decimal(10, 2)
  meretDimenzio MeretDimenzio?

  /// Harom oszlop, mert negy alak nem egyszeru binomialis, es ket tetelnel a FAJ
  /// sincs meghatarozva. Egy stringben a "nem tudjuk a fajt" es a "tudjuk" eset
  /// egyforman nezne ki. A `species IS NULL` itt ONMAGABAN jelentes: genus-szintu
  /// azonositas.
  ///
  /// ES AMI EBBOL A KITOLTESRE KOVETKEZIK -- HAROM SZABALY, ES NEM STILUS:
  ///
  /// 1. A `genus` MINDIG legyen kitoltve. Ez az egyetlen mezo, ami ket adatlapot
  ///    ossze tud kotni; enelkul ket azonos faju termek gepileg nem talal
  ///    egymasra. A `String?` NEM azt jelenti, hogy elhagyhato -- azt jelenti,
  ///    hogy a sor letrejohet elotte.
  /// 2. A `species` CSAK akkor, ha a faj tenylegesen meghatarozott. Ahol nem,
  ///    ott maradjon NULL: az a fentebb kimondott JELENTES, nem hianyos kitoltes.
  /// 3. A `genus` irasmodja legyen egyseges (kis/nagybetu, szokoz). ERRE MA
  ///    SEMMI NEM UGYEL: nincs egyedisegi megkotes es nincs normalizalo a
  ///    kodban (merve 2026-08-31). Amig nincs, ez emberi fegyelmen mulik.
  ///
  /// MIERT ITT ALL, ES MIERT NEM CSAK EGY TERVEZESI LAPON: ha kesobb faj-szintu
  /// entitas (`Species`) kerul a termek foles, a meglevo adatlapokat CSOPORTOSITANI
  /// kell. Ahol a `genus` egyseges, az gepi (`GROUP BY genus, species`). Ahol
  /// hianyzik vagy elteroen irt, ott EMBER dont, adatlaponkent.
  ///
  /// ES EGY FIGYELMEZTETES ANNAK, AKI AZT A CSOPORTOSITAST MEGIRJA: ket
  /// `species IS NULL` sor NEM vonhato ossze -- sem egy konkret fajjal, sem
  /// egymassal. Ket "Acropora, faj ismeretlen" nem ugyanaz a faj; csak annyit
  /// tudunk, hogy mindketto Acropora.
  genus           String?
  species         String?
  kereskedelmiNev String?

  careDifficulty CareDifficulty?
  /// NEM logikai. Ot eset all az adatban (igen, nem, felteteles, allitas nelkuli,
  /// nem faj-szintu), es egy Boolean mind az otot kettore lapitana.
  reefSafe       ReefSafe?
  socialKeeping  SocialKeeping?
  /// A scope nelkul az origin akkor is hazudik, ha kitoltjuk, es akkor is, ha nem:
  /// harom cella jelolve van, megis tartalmaz regiot, csak genus-szinten.
  originScope    OriginScope?

  /// Tobberteku facettak. Az URES TOMB itt "nincs ertek", NEM "megneztuk es semmi":
  /// Postgres alatt a lista alapertelmezese ures tomb, tehat oszlop-szinten nem
  /// kulonboztetheto meg a "nincs allapot"-tol. A kulonbseget MINDENHOL a
  /// megtagadas-tabla adja, igy a szabaly mind a 22 kulcsra azonos.
  feedingType FeedingType[]
  /// A BEKES ONALLO ERTEK. Ha a mezo csak akkor kapna erteket, amikor az allat
  /// agressziv, a hianya ket dolgot jelentene: "bekes" es "nem tudjuk".
  aggression  Aggression[]
  /// SZOVEG, nem felsorolas, es ez DONTES, nem hianyzo meres. A cellak HAROM
  /// kulonbozo foldrajzi felbontason beszelnek, egy sik felsorolasban a
  /// Karib-tenger es az Indo-csendes-oceani egy szinten allna. A legfelso szintre
  /// normalizalva viszont egyetlen ertek fedne le a kinalat 59 szazalekat, tehat
  /// alig szurne. Hivatkozassa akkor valik, ha valaki felveszi a regio-fat.
  origin      String[]

  /// A tarsithatosag KET kulon kerdes, es harom tetel MINDKETTOROL mond valamit,
  /// tehat nem kizaro bontas. Ma szoveg: a relacio celja (a tarsithato fajok
  /// szotara) nem letezik. Relaciora akkor valt, ha a szotar elkeszul.
  amitOVeszelyeztet  String?
  amiOtVeszelyezteti String?

  product  Product                        @relation(fields: [productId], references: [id], onDelete: Cascade)
  refusals ProductDatasheetFieldRefusal[]
}

/// EGY MEGTAGADOTT MEZO, INDOKKAL. A sor LETEZESE a megtagadas-allapot.
///
/// Ez a tabla teszi az indokot SZERKEZETILEG kotelezove, nem konvenciova: a
/// megtagadas nem allithato be sor nelkul, a sorban pedig az `indok` nem
/// nullazhato ES nem lehet ures (adatbazis-szintu CHECK, mert a NOT NULL az ures
/// stringet atengedne).
///
/// Egy indok nelkuli "megtagadva" ugyanolyan hasznalhatatlan, mint az ures cella
/// volt -- csak magabiztosabban nez ki.
model ProductDatasheetFieldRefusal {
  id          String         @id @default(cuid())
  datasheetId String
  /// ENUM, NEM szoveg. Egy elgepelt mezonev olyan sort hozna letre, amit soha
  /// senki nem talal meg: a mezo "hatralek" maradna, mikozben a tabla azt
  /// allitana, hogy megneztuk.
  mezo        DatasheetField
  indok       String
  /// A megtagadasnak KET oka van, es MAS a feloldasuk: a forrashianyt kutatas
  /// oldja fel, a dontesre varot ember. Egy kozos allapotbol nem derul ki, kinek
  /// a dolga.
  oka         RefusalReason
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  datasheet ProductDatasheet @relation(fields: [datasheetId], references: [id], onDelete: Cascade)

  @@unique([datasheetId, mezo])
  @@index([oka])
}

enum MeretKategoria {
  NANO
  NORMAL
}

enum MeretDimenzio {
  TESTHOSSZ
  KARFESZTAVOLSAG
  HEJMERET
  TELJES_KITERJEDES
}

enum CareDifficulty {
  KONNYU
  KOZEPES
  HALADO
}

enum ReefSafe {
  IGEN
  NEM
  FELTETELES
  ALLITAS_NELKULI
  NEM_FAJ_SZINTU
}

enum SocialKeeping {
  EGYEDUL
  PARBAN
  CSOPORTBAN
  TOBB_PELDANY_TARTHATO
}

enum OriginScope {
  FAJ
  GENUS
  CSALAD
}

enum FeedingType {
  SZURO_PLANKTON
  ALGAEVO
  HUSEVO
  MINDENEVO
  TORMELEKEVO
  FOTOSZINTETIZALO
  TISZTOGATO
}

enum Aggression {
  BEKES
  TERULETVEDO
  RAGADOZO
  CSALANOZ
  FAJTARSSAL_AGRESSZIV
  FELTETELES
}

enum RefusalReason {
  NINCS_FORRAS
  DONTESRE_VAR
}

/// A megtagadhato mezok kulcsai: HUSZONKETTO.
///
/// A tizenharom eredeti mezo, a nyolc uj, ES a tarsithatosag KET fele -- mert az
/// KET KULONBOZO KERDES ("mit tesz o a tarsaival" es "mi fenyegeti ot"), es
/// harom tetel mindkettorol mond valamit.
///
/// A SZABALY, AMI ELDONTI, MI KAP SAJAT KULCSOT: a MINOSITO oszlop NEM kap.
/// A meretDimenzio a MAX_MERET resze, nem onallo mezo -- egy dimenzio onmagaban,
/// szam nelkul, nem allitas. Ugyanezert az originScope az ORIGIN resze: a scope
/// azt mondja meg, milyen szinten ervenyes a regio, tehat regio nelkul nincs
/// mit minositenie. Kulon kulcsot adni neki azt engedne meg, hogy valaki a
/// scope-ot megtagadja, mikozben a regio all -- ket allapot egy tenyre.
enum DatasheetField {
  MAGYAR_NEV
  ANGOL_NEV
  CSALAD_TAXON
  ELOHELY
  AKVARIUM_MERET
  MAX_MERET
  KULLEME
  TARTASA
  VISELKEDESE
  AJANLOTT_ELESEG
  ERZEKENYSEG
  TARSITHATOSAG
  ERDEKESSEG
  SCIENTIFIC_NAME
  CARE_DIFFICULTY
  REEF_SAFE
  FEEDING_TYPE
  ORIGIN
  AGGRESSION
  SOCIAL_KEEPING
  AMIT_O_VESZELYEZTET
  AMI_OT_VESZELYEZTETI
}

/// A tartalom útja, kilenc állapottal. A részletes indoklás és az átmenetek
/// zárt listája az `apps/api/src/content/content-state.ts` fájlban áll, ott
/// mérve is van; itt csak a nevek.
///
/// A "KÉPRE VÁR" SZÁNDÉKOSAN NINCS KÖZTÜK. A kép nem a szöveg útjának egy
/// szakasza, hanem tőle független feltétel: ma NÉGY kész szövegű poszt vár
/// kizárólag fotóra, és ha ez állapot lenne, azoknál elveszne, hogy a szövegük
/// már jóváhagyott. A képet a `imageRequired` és az `imageAttachedAt` mezők
/// írják le.
enum ContentState {
  IDEA
  DRAFTING
  AWAITING_REVIEW
  AWAITING_REVISION
  AWAITING_APPROVAL
  READY_TO_SEND
  SCHEDULED
  SENT
  DISCARDED
}

/// Hova készül a tartalom. A felület első köre CSAK azt kezeli, amit mi
/// gyártunk (Balázs döntése, 2026-09-01 14:35): a Drive és a Facebook marad,
/// ahol van, azokra hivatkozunk.
enum ContentChannel {
  FACEBOOK_POST
  FACEBOOK_AD
  ARTICLE
  OTHER
}

/// Egy tartalom-tétel: poszt, hirdetésszöveg vagy cikk, a keletkezésétől a
/// kiküldéséig.
///
/// MIÉRT KELL EGYÁLTALÁN: ma három hely tükrözi ugyanazt az állapotot (a
/// kanban, egy kézzel karbantartott lap, és a kiküldés utólagos lekérdezése),
/// és egyik sem frissül a másiktól. Ez a tábla nem NEGYEDIK hely: azzal a
/// feltétellel készül, hogy átveszi a másik hármat.
///
/// A KIKÜLDÉS TÉNYE KÍVÜLRŐL ÉRKEZIK, és ez a legdrágább mai hiány, mert
/// CSENDES: egy elavult lap pontosan úgy néz ki, mint egy friss. Az
/// `externalPostId` és a `sentAt` ezért nem kézzel töltött mezők -- a flotta
/// meglévő olvasó eszköze (`scripts/fb-insights.sh posts`) adja őket, ami
/// `id`, `created_time`, `message` és `permalink_url` mezőket ad vissza.
///
/// MÉRVE 2026-09-01-én (barracuda, `measurement/2026-09-01-fb-posts-kikuldes-tenye.md`):
/// a lekérdezés fut, és a KÉZZEL kiküldött posztok is megjelennek benne. A
/// `sentAt` és az `externalPostId` töltése tehát nem feltevés többé.
///
/// AMI FELTEVÉS MARADT, ÉS EZÉRT NEM ÉPÜL RÁ SEMMI: az EREDET, vagyis hogy egy
/// poszt tőlünk ment-e ki vagy kézzel. A huszonöt lekérdezett posztból kettő
/// visel `application` mezőt, a többi huszonháromnál a mező nem szerepel -- de
/// az a kettő egyben a két legfrissebb is, tehát nem zárható ki, hogy a Graph
/// API a régebbieknél egyszerűen nem adja vissza a mezőt, származástól
/// függetlenül. **Ez a modell semmilyen döntést nem alapoz az eredetre**, mert
/// az egy még el nem dőlt kérdés lenne.
///
/// A BEHÚZÁSNAK VÉGIG KELL JÁRNIA A LAPOZÓT, és ez néma hiba forrása: a
/// lekérdezés alapértelmezett limitje TÍZ. Aki „minden posztot" kér a kurzor
/// követése nélkül, csendben az utolsó tízet kapja -- a hívás nem hibázik, csak
/// keveset ad, és a hiányt semmi nem jelzi. Egy hiányzó `sentAt` pontosan úgy
/// néz ki, mint egy ki nem küldött poszt.
///
/// AMI EBBŐL NEM KÖVETKEZIK: hogy a rendszer KI IS KÜLD. A flottában egyetlen
/// ágensnek van Facebook publikálási joga (a `sec-fb` csoport egyetlen tagja),
/// de Balázs szabálya 2026-09-01 14:28-ról az, hogy egyelőre semmi nem mehet ki
/// nélküle vagy Luca nélkül. A jog megléte NEM engedély, és ezt a mező
/// nevéből is látni kell: ami visszaérkezik, az egy MEGTÖRTÉNT kiküldés
/// azonosítója, nem egy kiküldési parancs.
model ContentItem {
  id      String         @id @default(cuid())
  title   String
  body    String?
  channel ContentChannel
  state   ContentState   @default(IDEA)

  /// A KÉP MINT FELTÉTEL, NEM ÁLLAPOT. A kettő független: egy vázlatnak is
  /// lehet kész képe, és egy jóváhagyott szöveg is várhat fotóra.
  imageRequired   Boolean   @default(false)
  imageAttachedAt DateTime?

  authorId   String?
  reviewerId String?

  /// A tervezett kiküldés napja, a naptár nézethez. Ez a SZÁNDÉK, nem az
  /// ütemezés: az utóbbi a `scheduledFor`.
  plannedFor DateTime?

  /// AZ ÜTEMEZÉS HORGONYA: a létrehozás, VAGY az utolsó DÁTUM-mozdítás.
  /// Szövegmódosítás nem írja át, és ez nem részletkérdés: a "piszkozat
  /// gyújtózsinórral" szabály szerint a 25. napon figyelmeztetés megy, két
  /// órával később a poszt törlődik, és a dátum mozdítása az EGYETLEN, ami
  /// "foglalkozott vele"-nek számít. Ha a szerkesztés is átírná, egy
  /// vesszőhiba javítása újraindítaná a határidőt.
  scheduleAnchoredAt DateTime?
  /// Mikorra van ütemezve. A feltöltés napja + 29 nap: a Graph API a +30-at
  /// elutasítja, és a távoli vég szándékos -- a hallgatás így NEMET jelent.
  scheduledFor       DateTime?

  /// A MEGTÖRTÉNT kiküldés azonosítója a külső felületen, és a tény ideje.
  /// Lekérdezésből jön, nem kézzel írjuk be.
  externalPostId String?
  externalUrl    String?
  sentAt         DateTime?

  /// Az elvetés oka KÖTELEZŐ, ha a tétel elvetett. Ezt az alkalmazás őrzi:
  /// egy adatbázis-szintű megkötés itt az állapotgép egészét kívánná a
  /// táblába, és a két hely külön romlana el.
  discardReason String?

  comments  ContentComment[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([state, plannedFor])
  @@index([channel, state])
}

/// A beszélgetés a tételen belül, hogy a felvetésre ott lehessen válaszolni, ne
/// egy külön csatornán. Balázs kérése szó szerint: "Valaszolni lehet a
/// felvetesekre."
model ContentComment {
  id        String      @id @default(cuid())
  contentId String
  content   ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  authorId  String?
  body      String
  createdAt DateTime    @default(now())

  @@index([contentId, createdAt])
}
