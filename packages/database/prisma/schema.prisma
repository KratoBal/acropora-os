  @@index([aggregateType, aggregateId, occurredAt])
  @@index([publishedAt, occurredAt])
  @@index([correlationId])
}

enum TaskStatus {
  OPEN
  DONE
}

/// Honnan jött a feladat. A gépi (AGENT) felvitel a flotta ügynökeitől
/// érkezik, egy kizárólag létrehozásra képes service tokennel - lásd a
/// docs/TASKS.md "Gépi felvitel" szakaszát.
enum TaskSource {
  MANUAL
  AGENT
}

/// Személyes feladat- és kérdéslista. Nem projektmenedzsment: egyetlen
/// felelőse van, két állapota, és a fő tartalma a `description` indoklás
/// (miért kérdezzük, mit blokkol), nem a cím.
model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(OPEN)
  /// Külső hivatkozás (jellemzően a Discord-szál URL-je), hogy a tétel a
  /// beszélgetés helyére vezessen vissza. Csak http/https engedett.
  linkUrl     String?
  source      TaskSource @default(MANUAL)
  /// A forrásrendszer saját azonosítója (pl. "polip:required-inputs#1.3").
  /// A [source, sourceRef] egyediség adja a gépi felvitel idempotenciáját:
  /// egy újraküldött tétel nem keletkezik kétszer. Kézi felvitelnél NULL,
  /// és PostgreSQL-ben a NULL minden más NULL-tól különbözik, ezért ez a
  /// kézi tételek számát nem korlátozza.
  sourceRef   String?
  assigneeId  String
  createdById String?
  closedById  String?
  closedAt    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  assignee  User  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  createdBy User? @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  closedBy  User? @relation("TaskClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  @@unique([source, sourceRef])
  @@index([assigneeId, status, createdAt])
}

/// Gépi (ember nélküli) hívó a feladat-felvitelhez. Szándékosan nem User és
/// nem Session: egy session token MINDEN végponton érvényes, és csak a
/// jogosultsági mátrix szűkíti. Ezt a tokent viszont egyetlen végpont
/// fogadja el (POST /tasks/ingest), mert a ServiceTokenGuard sehol máshol
/// nem szerepel a kódbázisban. A korlát így konstrukciós, nem
/// konfigurációs: a token nem azért nem tud mást csinálni, mert nincs rá
/// joga, hanem mert nincs másik végpont, amely elfogadná.
model ServiceToken {
  id        String @id @default(cuid())
  /// Emberi olvasásra szánt név, pl. "Flotta - polip".
  name      String
  /// Névtér-előtag. A token által felvitt minden feladat sourceRef-je
  /// "<slug>:<hivatkozás>" alakban tárolódik, a szerver által összefűzve.
  /// Így két gépi hívó nem tud ütközni egymás egyedi indexén, és nem tud
  /// egymás nevében tételt felvinni.
  slug      String @unique
  /// A nyers token sosem kerül adatbázisba, kizárólag a SHA-256 lenyomata -
  /// ugyanaz az elv, mint a Session.tokenHash mezőnél.
  tokenHash String @unique

  /// Melyik felhasználó NEVÉBEN jár el ez a token.
  ///
  /// NULLÁZHATÓ, mert a már kiadott tokeneknek nincs ilyenjük, és egy hozzáadó
  /// migráció nem találhat ki nekik egyet. AMI EBBŐL KÖVETKEZIK, ÉS AMIT AZ
  /// ŐRZŐNEK TARTANIA KELL: egy felhasználó nélküli token NEM eshet vissza
  /// semmilyen alapértelmezett fiókra, hanem el kell utasítani. Egy csendes
  /// visszaesés itt azt jelentené, hogy egy régi token hirtelen valaki
  /// nevében ír -- és a soron semmi nem mutatná, hogy nem ő volt.
  ///
  /// A `slug` NEM helyettesíti ezt: az a feladat-forrásokat névterezi, nem
  /// a szerzőséget, és nincs mögötte felhasználói jogosultság.
  userId     String?
  user       User?     @relation("ServiceTokenUser", fields: [userId], references: [id], onDelete: SetNull)
  /// Napi felvitel-plafon, elszabadult ügynök-ciklus ellen.
  dailyLimit Int       @default(200)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

/// A strukturalt termek-adatlap, TERMEK szinten.
///
/// Miert nem valtozat szinten: merve (nautilus, 2026-08-31) egy faj a boltban
/// tobb meretben is allhat, de EGY adatlapja van. Valtozat szinten ugyanaz a
/// szoveg tobbszor allna, es a peldanyok elcsuszhatnanak egymastol.
///
/// MINDEN MEZONEK HAROM ALLAPOTA VAN, NEM KETTO:
///   1. van ertek                 -> az oszlop NEM NULL
///   2. hatralek (meg nem nezte)  -> az oszlop NULL, es NINCS ProductDatasheetFieldRefusal sor
///   3. megtagadas (megneztuk, es felelosseggel nem irhato ra semmi)
///                                -> az oszlop NULL, es VAN sor, INDOKKAL
///
/// A 2. es a 3. eddig egyforman nezett ki, es pontosan ezt szunteti meg Balazs
/// dontese (2026-08-31 09:43). A megkulonboztetes NEM ezen a tablan all, hanem a
/// megtagadas-tablan: itt minden ertek-oszlop egyszeruen nullazhato.
/// A TERMEK SZALLITASI JELLEMZOI -- KEZZEL GONDOZOTT TORZSADAT, SAJAT TABLABAN.
///
/// === MIERT KULON TABLA, ES NEM MEZOK A `Product`-ON ===
///
/// A `Product` UZEMI rekord: a UNAS-szinkron irja, es a frissito ag mezonkent
/// donti el, mihez nyul hozza. Ha ezek a mezok is ott ulnenek, a vedelmuk egy
/// LISTA lenne -- a frissito ag felsorolasa arrol, mihez nem nyul. Az a fajta
/// vedelem NEMA: egy uj mezot barki felvehet ugy, hogy a listat elfelejti
/// boviteni, es semmi nem all meg, csak egy gondozott ertek eltunik egy futas
/// utan.
///
/// Kulon tablaban a tulajdonjog nem szabaly, hanem ALAK: a szinkronnak nincs
/// mit irnia rajta. (acrobot dontese, 2026-09-07.)
///
/// === MIERT NEM `ProductMaster` A NEVE ===
///
/// Mert az a nev a repoban MAR FOGLALT, es mast jelent: a
/// `Product.catalogAuthority` az "aktualis Product Master", vagyis hogy KI a
/// termek gazdaja. Aki a docs/PRODUCT-CATALOG.md-t olvasta, egy `ProductMaster`
/// tabla lattan nem nezne utana, hanem a gazda-fogalomra gondolna.
///
/// === MIERT NINCS DEFAULT ERTEK ===
///
/// Mind a negy jelzo EMBERI ITELET, es a hianyzo ertek nem "nem" -- hanem "meg
/// senki nem nezte meg". A megkulonboztetes a SOR letezese: nincs sor = nem
/// vizsgaltuk; van sor = valaki mind a negyrol dontott. Egy `@default(false)`
/// epp ezt tuntetne el, mert egy reszleges irasnal a ki nem toltott jelzok
/// csendben "nem"-re allnanak.
///
/// === AMI NINCS ITT, ES SZANDEKOSAN ===
///
/// SULY: a Commerce oldali modell kommentje kimondja, hogy az `is_heavy` kezzel
/// jelolt, SOSEM a sulybol szamolt -- es Balazs dontese szerint termek-tomeget
/// nem viszunk fel. Nincs mit duplikalni.
///
/// `is_livestock`: a Commerce oldalon NEM ennek a modellnek a mezoje, hanem a
/// `ProductType.id`-bol dol el, kornyezeti valtozobol. Vagyis nem adat, hanem
/// konfiguracio, es masik rendszerben el.
///
/// A SZALLITASI OSZTALY SZAMITASA: a Commerce-ben azert el kodban es nem
/// szabalyban, mert a Medusa szabaly-motorja a "barmelyik tetel" logikat nem
/// tudja kifejezni. Ez az indok NALUNK NEM ALL FENN, tehat a szamitas
/// atmasolasa nem automatikus -- ez a tabla az ADATOT hordozza, nem a dontest.
model ProductShippingProfile {
  id        String   @id @default(cuid())
  productId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Az egesz kosarat uzletben kell atvenni.
  pickupOnly       Boolean
  /// A Foxpost nem ajanlhato fel.
  foxpostForbidden Boolean
  /// Nehez aru -- KEZZEL jelolt, sosem a sulybol.
  isHeavy          Boolean
  /// Fagyasztott: nem szallithato, `pickupOnly`-kent viselkedik.
  isFrozen         Boolean

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductDatasheet {
  id        String   @id @default(cuid())
  productId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A 13 eredeti mezo. A SZOVEG MARAD, a facetta MELLE jon, nem helyette:
  /// egy kulcsszo-kereso a "NEM konnyu" alaku mondatbol "konnyu"-t hozna ki.
  magyarNev           String?
  angolNev            String?
  /// Ma SZOVEG, nem hivatkozas. A taxon-szotar nem letezik, es egy ures
  /// szotarra mutato idegen kulcs MINDEN beszurast elutasitana. Relaciora akkor
  /// valt, ha a taxon-szotar elkeszul es fel van toltve.
  csaladTaxon         String?
  elohelySzoveg       String?
  akvariumMeretSzoveg String?
  maxMeretSzoveg      String?
  kulleme             String?
  tartasa             String?
  viselkedese         String?
  ajanlottEleseg      String?
  erzekenyseg         String?
  tarsithatosag       String?
  erdekesseg          String?

  /// Az ajanlott akvarium merete KET kulonbozo dolgot hordozott egy cellaban:
  /// minimum terfogatot es nepsuruseget. A ketto NEM valthato at egymasba, amig
  /// nem tudjuk, hany peldanyrol van szo. Negybol legalabb egy MINDIG ures lesz,
  /// es az itt NEM hiany, hanem "erre a tetelre nem ez a fajta adat vonatkozik".
  minLiter       Decimal?        @db.Decimal(10, 2)
  literPerEgyed  Decimal?        @db.Decimal(10, 2)
  meretKategoria MeretKategoria?

  /// A maximalis meretnel a szam mellé kell, hogy MIT mertek: a 25 cm
  /// karfesztavolsag es a 25 cm testhossz ugyanaz a szam, de mas allat.
  meretMin      Decimal?       @db.Decimal(10, 2)
  meretMax      Decimal?       @db.Decimal(10, 2)
  meretDimenzio MeretDimenzio?

  /// Harom oszlop, mert negy alak nem egyszeru binomialis, es ket tetelnel a FAJ
  /// sincs meghatarozva. Egy stringben a "nem tudjuk a fajt" es a "tudjuk" eset
  /// egyforman nezne ki. A `species IS NULL` itt ONMAGABAN jelentes: genus-szintu
  /// azonositas.
  ///
  /// ES AMI EBBOL A KITOLTESRE KOVETKEZIK -- HAROM SZABALY, ES NEM STILUS:
  ///
  /// 1. A `genus` MINDIG legyen kitoltve. Ez az egyetlen mezo, ami ket adatlapot
  ///    ossze tud kotni; enelkul ket azonos faju termek gepileg nem talal
  ///    egymasra. A `String?` NEM azt jelenti, hogy elhagyhato -- azt jelenti,
  ///    hogy a sor letrejohet elotte.
  /// 2. A `species` CSAK akkor, ha a faj tenylegesen meghatarozott. Ahol nem,
  ///    ott maradjon NULL: az a fentebb kimondott JELENTES, nem hianyos kitoltes.
  /// 3. A `genus` irasmodja legyen egyseges (kis/nagybetu, szokoz). ERRE MA
  ///    SEMMI NEM UGYEL: nincs egyedisegi megkotes es nincs normalizalo a
  ///    kodban (merve 2026-08-31). Amig nincs, ez emberi fegyelmen mulik.
  ///
  /// MIERT ITT ALL, ES MIERT NEM CSAK EGY TERVEZESI LAPON: ha kesobb faj-szintu
  /// entitas (`Species`) kerul a termek foles, a meglevo adatlapokat CSOPORTOSITANI
  /// kell. Ahol a `genus` egyseges, az gepi (`GROUP BY genus, species`). Ahol
  /// hianyzik vagy elteroen irt, ott EMBER dont, adatlaponkent.
  ///
  /// ES EGY FIGYELMEZTETES ANNAK, AKI AZT A CSOPORTOSITAST MEGIRJA: ket
  /// `species IS NULL` sor NEM vonhato ossze -- sem egy konkret fajjal, sem
  /// egymassal. Ket "Acropora, faj ismeretlen" nem ugyanaz a faj; csak annyit
  /// tudunk, hogy mindketto Acropora.
  genus           String?
  species         String?
  kereskedelmiNev String?

  careDifficulty CareDifficulty?
  /// Acropora-altal kitoltott szakmai adat. Az UNAS-szinkron sem nem szamolja,
  /// sem nem irja felul; a null az advisor szamara hianyzo adat.
  fenyIgeny      ElhelyezesiIgeny?
  aramlasIgeny   ElhelyezesiIgeny?
  /// NEM logikai. Ot eset all az adatban (igen, nem, felteteles, allitas nelkuli,
  /// nem faj-szintu), es egy Boolean mind az otot kettore lapitana.
  reefSafe       ReefSafe?
  socialKeeping  SocialKeeping?
  /// A scope nelkul az origin akkor is hazudik, ha kitoltjuk, es akkor is, ha nem:
  /// harom cella jelolve van, megis tartalmaz regiot, csak genus-szinten.
  originScope    OriginScope?

  /// Tobberteku facettak. Az URES TOMB itt "nincs ertek", NEM "megneztuk es semmi":
  /// Postgres alatt a lista alapertelmezese ures tomb, tehat oszlop-szinten nem
  /// kulonboztetheto meg a "nincs allapot"-tol. A kulonbseget MINDENHOL a
  /// megtagadas-tabla adja, igy a szabaly mind a 22 kulcsra azonos.
  feedingType FeedingType[]
  /// A BEKES ONALLO ERTEK. Ha a mezo csak akkor kapna erteket, amikor az allat
  /// agressziv, a hianya ket dolgot jelentene: "bekes" es "nem tudjuk".
  aggression  Aggression[]
  /// SZOVEG, nem felsorolas, es ez DONTES, nem hianyzo meres. A cellak HAROM
  /// kulonbozo foldrajzi felbontason beszelnek, egy sik felsorolasban a
  /// Karib-tenger es az Indo-csendes-oceani egy szinten allna. A legfelso szintre
  /// normalizalva viszont egyetlen ertek fedne le a kinalat 59 szazalekat, tehat
  /// alig szurne. Hivatkozassa akkor valik, ha valaki felveszi a regio-fat.
  origin      String[]

  /// A tarsithatosag KET kulon kerdes, es harom tetel MINDKETTOROL mond valamit,
  /// tehat nem kizaro bontas. Ma szoveg: a relacio celja (a tarsithato fajok
  /// szotara) nem letezik. Relaciora akkor valt, ha a szotar elkeszul.
  amitOVeszelyeztet  String?
  amiOtVeszelyezteti String?

  product  Product                        @relation(fields: [productId], references: [id], onDelete: Cascade)
  refusals ProductDatasheetFieldRefusal[]
}

/// EGY MEGTAGADOTT MEZO, INDOKKAL. A sor LETEZESE a megtagadas-allapot.
///
/// Ez a tabla teszi az indokot SZERKEZETILEG kotelezove, nem konvenciova: a
/// megtagadas nem allithato be sor nelkul, a sorban pedig az `indok` nem
/// nullazhato ES nem lehet ures (adatbazis-szintu CHECK, mert a NOT NULL az ures
/// stringet atengedne).
///
/// Egy indok nelkuli "megtagadva" ugyanolyan hasznalhatatlan, mint az ures cella
/// volt -- csak magabiztosabban nez ki.
model ProductDatasheetFieldRefusal {
  id          String         @id @default(cuid())
  datasheetId String
  /// ENUM, NEM szoveg. Egy elgepelt mezonev olyan sort hozna letre, amit soha
  /// senki nem talal meg: a mezo "hatralek" maradna, mikozben a tabla azt
  /// allitana, hogy megneztuk.
  mezo        DatasheetField
  indok       String
  /// A megtagadasnak KET oka van, es MAS a feloldasuk: a forrashianyt kutatas
  /// oldja fel, a dontesre varot ember. Egy kozos allapotbol nem derul ki, kinek
  /// a dolga.
  oka         RefusalReason
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  datasheet ProductDatasheet @relation(fields: [datasheetId], references: [id], onDelete: Cascade)

  @@unique([datasheetId, mezo])
  @@index([oka])
}

enum MeretKategoria {
