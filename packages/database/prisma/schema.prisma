generator client {
  provider      = "prisma-client-js"
  // "native" keeps the locally-installed engine (darwin-arm64 in local dev,
  // whatever CI runs on) working as before; the musl target is required for
  // the node:22-alpine Docker runtime, which uses musl libc instead of glibc.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

