  channel          CatalogChannel
  externalStatus   String?
  isPublished      Boolean        @default(false)
  slug             String?
  productUrl       String?
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?
  seoRobots        String?
  /// A UNAS-pillanatkép azonos nevű mezőjéből írjuk, `?? false` alapértékkel.
  /// EZ AZ A HELY, AHOL EGY KÜLÖNBSÉG ELVÉSZ: a pillanatképben a NULL azt
  /// jelenti, hogy a forrás nem nyilatkozott, itt viszont abból `false` lesz,
  /// és onnantól megkülönböztethetetlen attól, hogy a bolt kifejezetten nemet
  /// mondott. A szűkebb irány, tehát védhető -- de aki erre a mezőre `if`-et
  /// ír, tudja meg, hogy a `false` két különböző dolgot takar.
  backorderAllowed Boolean        @default(false)
