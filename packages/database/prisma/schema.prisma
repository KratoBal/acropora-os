model IntegrationSyncState {
  id             String     @id @default(cuid())
  provider       String
  operation      String
  aggregateType  String
  aggregateId    String
  idempotencyKey String     @unique
  status         SyncStatus @default(PENDING)
  attempts       Int        @default(0)
