  TERULETVEDO
  RAGADOZO
  CSALANOZ
  FAJTARSSAL_AGRESSZIV
  FELTETELES
}

enum RefusalReason {
  NINCS_FORRAS
  DONTESRE_VAR
}

/// A megtagadhato mezok kulcsai: HUSZONKETTO.
///
/// A tizenharom eredeti mezo, a nyolc uj, ES a tarsithatosag KET fele -- mert az
/// KET KULONBOZO KERDES ("mit tesz o a tarsaival" es "mi fenyegeti ot"), es
/// harom tetel mindkettorol mond valamit.
///
/// A SZABALY, AMI ELDONTI, MI KAP SAJAT KULCSOT: a MINOSITO oszlop NEM kap.
/// A meretDimenzio a MAX_MERET resze, nem onallo mezo -- egy dimenzio onmagaban,
/// szam nelkul, nem allitas. Ugyanezert az originScope az ORIGIN resze: a scope
/// azt mondja meg, milyen szinten ervenyes a regio, tehat regio nelkul nincs
/// mit minositenie. Kulon kulcsot adni neki azt engedne meg, hogy valaki a
/// scope-ot megtagadja, mikozben a regio all -- ket allapot egy tenyre.
enum DatasheetField {
  MAGYAR_NEV
  ANGOL_NEV
  CSALAD_TAXON
  ELOHELY
  AKVARIUM_MERET
  MAX_MERET
  KULLEME
  TARTASA
  VISELKEDESE
  AJANLOTT_ELESEG
  ERZEKENYSEG
  TARSITHATOSAG
  ERDEKESSEG
  SCIENTIFIC_NAME
  CARE_DIFFICULTY
  REEF_SAFE
  FEEDING_TYPE
  ORIGIN
  AGGRESSION
  SOCIAL_KEEPING
  AMIT_O_VESZELYEZTET
  AMI_OT_VESZELYEZTETI
}

/// A tartalom útja, kilenc állapottal. A részletes indoklás és az átmenetek
/// zárt listája az `apps/api/src/content/content-state.ts` fájlban áll, ott
/// mérve is van; itt csak a nevek.
///
/// A "KÉPRE VÁR" SZÁNDÉKOSAN NINCS KÖZTÜK. A kép nem a szöveg útjának egy
/// szakasza, hanem tőle független feltétel: ma NÉGY kész szövegű poszt vár
/// kizárólag fotóra, és ha ez állapot lenne, azoknál elveszne, hogy a szövegük
/// már jóváhagyott. A képet a `imageRequired` és az `imageAttachedAt` mezők
/// írják le.
enum ContentState {
  IDEA
  DRAFTING
  AWAITING_REVIEW
  AWAITING_REVISION
  AWAITING_APPROVAL
  READY_TO_SEND
  SCHEDULED
  SENT
  DISCARDED
}

/// Hova készül a tartalom. A felület első köre CSAK azt kezeli, amit mi
/// gyártunk (Balázs döntése, 2026-09-01 14:35): a Drive és a Facebook marad,
/// ahol van, azokra hivatkozunk.
enum ContentChannel {
  FACEBOOK_POST
  FACEBOOK_AD
  ARTICLE
  OTHER
}

/// Egy tartalom-tétel: poszt, hirdetésszöveg vagy cikk, a keletkezésétől a
/// kiküldéséig.
///
/// MIÉRT KELL EGYÁLTALÁN: ma három hely tükrözi ugyanazt az állapotot (a
/// kanban, egy kézzel karbantartott lap, és a kiküldés utólagos lekérdezése),
/// és egyik sem frissül a másiktól. Ez a tábla nem NEGYEDIK hely: azzal a
/// feltétellel készül, hogy átveszi a másik hármat.
///
/// A KIKÜLDÉS TÉNYE KÍVÜLRŐL ÉRKEZIK, és ez a legdrágább mai hiány, mert
/// CSENDES: egy elavult lap pontosan úgy néz ki, mint egy friss. Az
/// `externalPostId` és a `sentAt` ezért nem kézzel töltött mezők -- a flotta
/// meglévő olvasó eszköze (`scripts/fb-insights.sh posts`) adja őket, ami
/// `id`, `created_time`, `message` és `permalink_url` mezőket ad vissza.
///
/// MÉRVE 2026-09-01-én (barracuda, `measurement/2026-09-01-fb-posts-kikuldes-tenye.md`):
/// a lekérdezés fut, és a KÉZZEL kiküldött posztok is megjelennek benne. A
/// `sentAt` és az `externalPostId` töltése tehát nem feltevés többé.
///
/// AMI FELTEVÉS MARADT, ÉS EZÉRT NEM ÉPÜL RÁ SEMMI: az EREDET, vagyis hogy egy
/// poszt tőlünk ment-e ki vagy kézzel. A huszonöt lekérdezett posztból kettő
/// visel `application` mezőt, a többi huszonháromnál a mező nem szerepel -- de
/// az a kettő egyben a két legfrissebb is, tehát nem zárható ki, hogy a Graph
/// API a régebbieknél egyszerűen nem adja vissza a mezőt, származástól
/// függetlenül. **Ez a modell semmilyen döntést nem alapoz az eredetre**, mert
/// az egy még el nem dőlt kérdés lenne.
///
/// A BEHÚZÁSNAK VÉGIG KELL JÁRNIA A LAPOZÓT, és ez néma hiba forrása: a
/// lekérdezés alapértelmezett limitje TÍZ. Aki „minden posztot" kér a kurzor
/// követése nélkül, csendben az utolsó tízet kapja -- a hívás nem hibázik, csak
/// keveset ad, és a hiányt semmi nem jelzi. Egy hiányzó `sentAt` pontosan úgy
/// néz ki, mint egy ki nem küldött poszt.
///
/// AMI EBBŐL NEM KÖVETKEZIK: hogy a rendszer KI IS KÜLD. A flottában egyetlen
/// ágensnek van Facebook publikálási joga (a `sec-fb` csoport egyetlen tagja),
/// de Balázs szabálya 2026-09-01 14:28-ról az, hogy egyelőre semmi nem mehet ki
/// nélküle vagy Luca nélkül. A jog megléte NEM engedély, és ezt a mező
/// nevéből is látni kell: ami visszaérkezik, az egy MEGTÖRTÉNT kiküldés
/// azonosítója, nem egy kiküldési parancs.
model ContentItem {
  id      String         @id @default(cuid())
  title   String
  body    String?
  channel ContentChannel
  state   ContentState   @default(IDEA)

  /// A KÉP MINT FELTÉTEL, NEM ÁLLAPOT. A kettő független: egy vázlatnak is
  /// lehet kész képe, és egy jóváhagyott szöveg is várhat fotóra.
  imageRequired   Boolean   @default(false)
  imageAttachedAt DateTime?

  authorId   String?
  reviewerId String?

  /// A tervezett kiküldés napja, a naptár nézethez. Ez a SZÁNDÉK, nem az
  /// ütemezés: az utóbbi a `scheduledFor`.
  plannedFor DateTime?

  /// AZ ÜTEMEZÉS HORGONYA: a létrehozás, VAGY az utolsó DÁTUM-mozdítás.
  /// Szövegmódosítás nem írja át, és ez nem részletkérdés: a "piszkozat
  /// gyújtózsinórral" szabály szerint a 25. napon figyelmeztetés megy, két
  /// órával később a poszt törlődik, és a dátum mozdítása az EGYETLEN, ami
  /// "foglalkozott vele"-nek számít. Ha a szerkesztés is átírná, egy
  /// vesszőhiba javítása újraindítaná a határidőt.
  scheduleAnchoredAt DateTime?
  /// Mikorra van ütemezve. A feltöltés napja + 29 nap: a Graph API a +30-at
  /// elutasítja, és a távoli vég szándékos -- a hallgatás így NEMET jelent.
  scheduledFor       DateTime?

  /// A MEGTÖRTÉNT kiküldés azonosítója a külső felületen, és a tény ideje.
  /// Lekérdezésből jön, nem kézzel írjuk be.
  externalPostId String?
  externalUrl    String?
  sentAt         DateTime?

  /// Az elvetés oka KÖTELEZŐ, ha a tétel elvetett. Ezt az alkalmazás őrzi:
  /// egy adatbázis-szintű megkötés itt az állapotgép egészét kívánná a
  /// táblába, és a két hely külön romlana el.
  discardReason String?

  comments  ContentComment[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([state, plannedFor])
  @@index([channel, state])
}

/// A beszélgetés a tételen belül, hogy a felvetésre ott lehessen válaszolni, ne
/// egy külön csatornán. Balázs kérése szó szerint: "Valaszolni lehet a
/// felvetesekre."
model ContentComment {
  id        String      @id @default(cuid())
  contentId String
  content   ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  authorId  String?
  body      String
  createdAt DateTime    @default(now())

  @@index([contentId, createdAt])
}

/// A KIMENŐ LEVELEK SZERKESZTHETŐ SABLONJA, ESEMÉNYENKÉNT EGY SOR.
///
/// Balázs kérése (2026-09-21 11:39:56 UTC, message_id 1551558600474886145):
/// a levél törzsébe beilleszthető változók kellenek, és a szöveget ő írja át.
///
/// MIÉRT TÁBLA, ÉS NEM FÁJL: a fájl a képbe sül, tehát az átírásához
/// újratelepítés kellene. A "bármikor átírom" ezt kizárja. A ház is így teszi
/// minden szerkeszthető beállítással (UnasConnectionSetting és társai).
///
/// AZ AZONOSÍTÓ AZ ESEMÉNY NEVE, nem egy generált kulcs: ugyanezen az úton megy
/// majd a lezárt jegy kiküldése és a munkalap eljuttatása is. Egy tábla, három
/// felhasználás, és a sor MEGTALÁLHATÓ anélkül, hogy bárhol azonosítót kellene
/// tárolni róla.
/// EGY KIMENŐ LEVÉL NYOMA -- CSAK BELSŐS, A PORTÁL SOHA NEM OLVASSA.
///
/// Ez az első út, ami a házon KÍVÜLRE küld dokumentumot, és egy kimenő küldés,
/// amiről nincs sorunk, utólag nem létezik. Mérve: a sémában a levelezéshez
/// CSAK a `TicketMailTemplate` tartozott, küldés-tábla nem volt, a `Logger`
/// sora pedig jegyenként nem kereshető.
///
/// === MIÉRT KÜLÖN TÁBLA, ÉS NEM AZ AuditLog EGY ÚJ AKCIÓJA ===
///
/// Az `AuditLog`-os alak működne, de FELTÉTELESEN: azon állna, hogy a jegy
/// részletlapja csak a törlés-akció sorait olvassa vissza. Vagyis a címeket egy
/// SZŰRŐ választaná el a portáltól, és egy szűrőt el lehet felejteni.
///
/// Külön táblánál nincs mit kiszűrni: a portál soha nem is olvassa. A védelem
/// SZERKEZETI, nem feltételes -- és ez a különbség áll a lapunkon mindenhol.
///
/// === ÉS A JEGY NAPLÓJA MÁST MOND, MINT EZ A TÁBLA ===
///
/// A napló-sor a TÉNYT és a DARABSZÁMOT mondja, címet nem. Ez a tábla azt,
/// hogy KINEK.
///
/// AZ INDOK NEM AZ, HOGY A PARTNER MA LÁTNÁ A NAPLÓ-SORT -- ma nem látja.
/// Mérve 2026-09-22, a fő ágon: a `detail` végpont partnernek a
/// `partnerServiceJobDetail` vetítését adja, ami a napló-bejegyzést ÖT
/// nevesített mezőből építi újra (id, isCreation, partnerStatusLabel,
/// actorName, createdAt), és a `note` nincs köztük. Balázs döntése ugyanerről:
/// "a megjegyzes nem kell a nev igen".
///
/// AZ INDOK EZ: ennek a mezőnek a LÁTHATÓSÁGA EGY NAP ALATT KÉTSZER változott
/// (2026-09-21 10:5x és 12:07). A láthatóság tehát nem tulajdonság, hanem
/// pillanat. Egy cím, ami egyszer bekerül egy napló SZÖVEGÉBE, onnantól minden
/// jövőbeli felülettel együtt utazik, és senki nem fogja megkérdezni, szabad-e
/// kiírni.
///
/// APPEND-ONLY: a sor nem módosul és nem törlődik. Egy kiküldött levelet nem
/// lehet meg nem történtté tenni, tehát a nyoma sem írható át.
model TicketMailDelivery {
  id String @id @default(cuid())

  /// MELYIK JEGYRŐL van szó. Idegenkulcs NINCS rajta, ugyanúgy, ahogy a
  /// `ServiceJob.openedById` mezőn sincs: egy kiküldött levél nyoma akkor is
  /// megmarad, ha a jegy sora eltűnik.
  serviceJobId String

  /// A jegy száma a küldés pillanatában. Azért ÍRJUK LE, és nem a jegyből
  /// olvassuk vissza: a levél EZT a számot vitte, és ha a jegy száma valaha
  /// változna, a nyom akkor is arról szólna, ami kiment.
  jobNumber String

  /// KI INDÍTOTTA. Idegenkulcs nélkül, ugyanaz a döntés, mint a jegynél: a
  /// tény túléli a fiókot.
  initiatedByUserId String?

  /// A levél tárgya, ahogy elment.
  subject String

  /// A CÍMZETTEK, névvel és címmel. EZ AZ, AMI A JEGY NAPLÓJÁBA NEM KERÜLHET.
  recipients Json

  /// A csomag mérete bájtban, a base64 UTÁN számolva -- ugyanaz a szám, amin a
  /// méret-kapu áll. Enélkül egy link-visszaesésnél nem lehetne megmondani,
  /// mennyivel lépte túl a határt.
  attachmentBytes Int

  /// `SENT`, `SENT_WITH_LINK` vagy `FAILED`. Szövegként, nem enumként: egy új
  /// kimenetel felvétele ne igényeljen migrációt egy append-only naplóban.
  outcome String

  /// A hiba szövege, ha volt. Titok NEM kerülhet bele: a küldő a tokent nem
  /// adja tovább a hibaüzenetben (mérve: `gmail-mail.sender.ts`).
  error String?

  createdAt DateTime @default(now())

  @@index([serviceJobId, createdAt])
}

model TicketMailTemplate {
  /// Az esemény neve, például `WORKSHEET_SIGNED`.
  id String @id

  /// A levél tárgya. A behelyettesítés UTÁN is fejléc marad, tehát a küldő
  /// oldalán sortörés-őrzőn megy át.
  subject String

  /// A levél törzse, `{{valtozo}}` alakú helyekkel.
  body String

  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  updatedBy User? @relation("TicketMailTemplateUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}
