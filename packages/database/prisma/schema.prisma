model Supplier {
  id                   String    @id @default(cuid())
  code                 String    @unique
  name                 String
  /// EU-s beszállítónál a közösségi adószám (pl. "DE123456789"), belföldinél a magyar adószám; opcionális.
  taxNumber            String?
  /// ISO 3166-1 alpha-2 országkód; a "HU"-tól eltérő érték jelöli az EU-n belüli beszerzést.
  country              String    @default("HU") @db.VarChar(2)
  email                String?
  phone                String?
  /// What kind of partner this is. The two are independent, because one
  /// company can be both: we order from it AND we do service work for it.
  ///
  /// `isSupplier` defaults to true so that every row recorded before this
  /// column existed keeps the meaning it was entered with -- the Partners menu
  /// held suppliers only until now -- and so that the purchase invoice screen,
  /// which creates a supplier without knowing about partner kinds, keeps
  /// working unchanged.
  isSupplier           Boolean   @default(true)
  /// A service partner is one we write worksheets and quotes for. Off by
  /// default: an existing row was never recorded as one, and guessing would
  /// put companies in front of the service staff that nobody put there.
  isService            Boolean   @default(false)
  /// The partner's abbreviation (`FANK`). It used to be the worksheet number's
  /// first segment; since 2026-08-27 the number does not carry it, and the
  /// sheet's title is what names the partner.
  ///
  /// It is still required before a sheet can be closed, because it is a
  /// uniqueness key across two tables and supplying it later is a one-off
  /// step: by then a worksheet may already point at the partner, and "which
  /// partner carries this abbreviation" turns ambiguous in retrospect.
  ///
  /// Four characters, so that the abbreviation reads the same everywhere it is
  /// shown -- a code of varying length makes two partners hard to compare in a
  /// list.
  ///
  /// Narrower than the customer side's `VarChar(8)` on purpose: that column
  /// already holds data and is not being narrowed, but a new column with room
  /// to spare would make "four characters" a habit rather than a rule, and the
  /// first five-character code would arrive without anyone deciding it.
  ///
  /// Null until someone fills it in. A partner can be marked as a service
  /// partner without one -- ticking a box should not turn into a decision at
  /// the wrong moment -- and the worksheet picker leaves those partners out
  /// instead, so nobody can start a sheet that cannot be closed.
  worksheetPartnerCode String?   @unique @db.VarChar(4)
  /// The customer row that carries this partner's worksheets.
  ///
  /// A worksheet hangs off a customer in three places -- the sheet, the unit
  /// (`WorksheetDepartment.customerId`) and the abbreviation the close path
  /// requires (`Customer.worksheetPartnerCode`) -- so letting a worksheet
  /// belong to a
  /// supplier directly would mean two polymorphic relations, two constraints
  /// Prisma cannot express, and a partner code that has to be unique ACROSS
  /// two tables. The mirror row keeps all of that untouched.
  ///
  /// It is a detail of the partner, not a buyer: the customer list leaves
  /// mirror rows out, and the partner screen is where the data is edited. It
  /// is created and kept in step by the system, so a partner is still
  /// recorded once, by hand, in one place.
  customerId           String?   @unique
  /// EU-s (nem "HU") beszállítónál a nemzetközi bankszámlaszám.
  iban                 String?
  /// EU-s (nem "HU") beszállítónál a bank SWIFT/BIC kódja.
  swiftCode            String?
  /// Belföldi ("HU") beszállítónál a hazai formátumú bankszámlaszám.
  bankAccountNumber    String?
  /// Kapcsolattartó neve, mindkét beszállítói körnél.
  contactPersonName    String?
  contactPersonPhone   String?
  contactPersonEmail   String?
  /// Cím adatok; a "country" mező (fent) az irányadó országkód, itt nincs külön tárolva.
  postalCode           String?
  city                 String?
  addressLine1         String?
  addressLine2         String?
  isActive             Boolean   @default(true)
  /// Amikor a partnert törölni akarták, de valami visszatartotta.
  ///
  /// NEM ugyanaz, mint az `isActive`. Egy inaktív partnert kivezettünk: nem
  /// dolgozunk vele, de a törzsadata a miénk. Egy törölt partnert törölni
  /// AKARTUNK, csak nem lehetett fizikailag, mert hivatkozik rá egy régi
  /// bejegyzés, és annak a nevét ott kell hagyni. A kettő egy mezőbe vonva a
  /// listákban nem lenne szétválasztható.
  ///
  /// A törölt partner eltűnik a választókból, de a régi számlán és
  /// munkalapon látszik a neve.
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  products              SupplierProduct[]
  purchaseOrders        PurchaseOrder[]
  purchaseInvoices      PurchaseInvoice[]
  preferredByExtensions ProductExtension[]
  invoices              Invoice[]
  assets                Asset[]
  /// `Restrict`, not `SetNull`: dropping the customer row would leave the
  /// partner's worksheets orphaned while the partner still looks intact.
  customer              Customer?          @relation("PartnerWorksheetMirror", fields: [customerId], references: [id], onDelete: Restrict)
  /// A fiokok, amik ENNEK a partnernek a neveben lepnek be. Nem a mi kollegaink.
  portalUsers           User[]             @relation("SupplierPortalUser")

  @@index([country, isActive])
}

