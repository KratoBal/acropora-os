/// NAV Online Számla kapcsolatbeállítás. A teljes technikai felhasználói és
/// szoftver-azonosító készlet egyetlen, verziózott AES-GCM borítékban él:
/// egyik mező sem olvasható vissza a böngészőbe vagy tárolódik plaintextként.
model NavConnectionSetting {
  id                        String                @id
  credentialMode            NavCredentialMode     @default(ENV_FALLBACK)
  encryptedCredentials      Bytes?
  encryptionIv              Bytes?
  authenticationTag         Bytes?
  keyVersion                String?
  credentialRevision        Int                   @default(0)
  credentialUpdatedAt       DateTime?
  credentialUpdatedByUserId String?
  verificationStatus        NavVerificationStatus @default(NEVER)
  lastVerifiedAt            DateTime?
  lastVerificationCode      String?
  credentialAttemptedAt     DateTime?
  testAttemptedAt           DateTime?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  credentialUpdatedBy User? @relation("NavCredentialUpdatedBy", fields: [credentialUpdatedByUserId], references: [id], onDelete: SetNull)

  @@index([credentialUpdatedByUserId])
}

/// Számlázz.hu kapcsolatbeállítás (M8.1, ADR-005) - az UnasConnectionSetting
/// mintáját követi, de két, egymástól független titkosított credentiallel:
/// az Agent kulcs (kimenő automatikus számlázáshoz, M8.2) és a pénzügyi
/// adatkapcsolati kulcs (bejövő/kimenő push fogadás hitelesítéséhez, M8.3)
/// külön kezelendő, mert eltérő Számlázz.hu-oldali jogosultsághoz
/// tartoznak, és külön is rotálhatók/tilthatók.
model SzamlazzConnectionSetting {
  id             String                 @id
  credentialMode SzamlazzCredentialMode @default(ENV_FALLBACK)

  encryptedAgentKey         Bytes?
  agentKeyEncryptionIv      Bytes?
  agentKeyAuthenticationTag Bytes?
  agentKeyVersion           String?

  encryptedFinancialApiKey         Bytes?
  financialApiKeyEncryptionIv      Bytes?
  financialApiKeyAuthenticationTag Bytes?
  financialApiKeyVersion           String?

  credentialRevision        Int                        @default(0)
  credentialUpdatedAt       DateTime?
  credentialUpdatedByUserId String?
  verificationStatus        SzamlazzVerificationStatus @default(NEVER)
  lastVerifiedAt            DateTime?
  lastVerificationCode      String?
  credentialAttemptedAt     DateTime?
  testAttemptedAt           DateTime?
  /// M8.5: a visszamenőleges backfill kezdődátuma, a kapcsolat
  /// aktiválásakor rögzítve - a bulk betöltés ehhez képest dolgozik.
  backfillStartDate         DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  credentialUpdatedBy User? @relation("SzamlazzCredentialUpdatedBy", fields: [credentialUpdatedByUserId], references: [id], onDelete: SetNull)

  @@index([credentialUpdatedByUserId])
}

enum MedusaCredentialMode {
  ENV_FALLBACK
  DATABASE
  DISABLED
}

enum MedusaVerificationStatus {
  NEVER
  SUCCESS
  FAILED
  INDETERMINATE
}

/// Medusa admin kapcsolatbeállítás. Ugyanaz a szerkezet, mint az UNAS és a NAV
/// kapcsolatánál: a titkos admin kulcs verziózott AES-GCM borítékban él, és nem
/// olvasható vissza sem a böngészőbe, sem naplóba.
///
/// Két dolgot érdemes tudni róla, és mind a kettő MÉRT tény a Medusa 2.19.0
/// oldalán, nem feltevés. Az egyik: a titkos kulcs ott TELJES JOGÚ, mert
/// jogkör-választás nincs, tehát ami itt áll, az a kereskedelmi rendszer teljes
/// admin felületét nyitja. A másik: lejárat mint mező nincs, csak késleltetett
/// visszavonás, tehát a kulcs magától soha nem évül el; a csere szándékos
/// művelet, és a `credentialRevision` az, ami a cseréket megkülönbözteti.
model MedusaConnectionSetting {
  id                        String                   @id
  credentialMode            MedusaCredentialMode     @default(ENV_FALLBACK)
  encryptedApiKey           Bytes?
  encryptionIv              Bytes?
  authenticationTag         Bytes?
  keyVersion                String?
  credentialRevision        Int                      @default(0)
  credentialUpdatedAt       DateTime?
  credentialUpdatedByUserId String?
  verificationStatus        MedusaVerificationStatus @default(NEVER)
  lastVerifiedAt            DateTime?
  lastVerificationCode      String?
  credentialAttemptedAt     DateTime?
  testAttemptedAt           DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  credentialUpdatedBy User? @relation("MedusaCredentialUpdatedBy", fields: [credentialUpdatedByUserId], references: [id], onDelete: SetNull)

  @@index([credentialUpdatedByUserId])
}

model UnasProductSyncRun {
  id                            String                   @id @default(cuid())
  activeKey                     String?                  @unique
  kind                          UnasProductSyncKind
  status                        UnasProductSyncRunStatus @default(PENDING)
  windowStart                   DateTime?
  windowEnd                     DateTime
  startedAt                     DateTime?
  completedAt                   DateTime?
  productsSeen                  Int                      @default(0)
  createdCount                  Int                      @default(0)
  updatedCount                  Int                      @default(0)
  unchangedCount                Int                      @default(0)
  conflictCount                 Int                      @default(0)
  missingCount                  Int                      @default(0)
  /// Ahány terméket a futás kihagyott, mert a törzsadatát nem a UNAS gondozza.
  /// A többi számláló mellett a helye: egy kihagyás, ami csak a válaszban
  /// látszik, holnap már nem visszakereshető.
  skippedCount                  Int                      @default(0)
  /// A kihagyottak közül ahánynál a FORRÁS IS VÁLTOZOTT ugyanabban a futásban.
  ///
  /// Ez a szám a jelzés, nem a `skippedCount`. A kihagyás maga ÁLLANDÓ: minden
  /// futás ugyanazokat a termékeket hagyja ki, tehát a számuk futásról futásra
  /// ugyanaz, és egy szám, ami sosem változik, nem jelzés, hanem alapzaj.
  ///
  /// EZ viszont esemény: azt mondja meg, hogy egy átvett termék szövege a
  /// boltban megváltozott, és mi nem vettük át. A legtöbb futáson nulla, és
  /// pontosan akkor nem az, amikor egy termék elkezd elavulni nálunk.
  skippedSourceChangedCount     Int                      @default(0)
  /// Ahány HASONLÓ kapcsolat-sort írt ez a futás, és ahány hivatkozás veszett
  /// el, mert a célpont nincs a katalógusunkban.
  ///
  /// MIÉRT A SORBAN, ÉS NEM CSAK A NAPLÓBAN: a napló a konténer indulásakor
  /// kezdődik (mérve 2026-09-15: mindhárom élő alkalmazás naplójának ELSŐ sora
  /// a saját bootja). Egy újratelepítés után tehát a tegnapi futás vesztesége
  /// már sehol nincs meg, és pont az a kérdés, ami másnap merül fel:
  /// "mennyi veszett el a héten?".
  ///
  /// MIÉRT NÉGY SZÁM, ÉS NEM NYOLC: a válaszban nyolc áll (típusonként négy),
  /// de az önhivatkozás és a duplikátum SZÁNDÉKOS kihagyás, nem veszteség --
  /// azok a naplóban maradnak. Itt az ADATVESZTÉS áll, és MELLÉ a nevező:
  /// egy "589 elveszett" szám önmagában nem mondja meg, sok-e.
  similarRelationsWritten       Int                      @default(0)
  similarReferencesUnresolved   Int                      @default(0)
  /// Ugyanez a kettő a KIEGÉSZÍTŐ kapcsolatokra. Külön, mert a két ág külön is
  /// tud elromlani: 2026-09-08-án a forrásban 13854 kiegészítő kapcsolat állt,
  /// az OS-ben nulla -- miközben a hasonló ágon hét termék átment.
  accessoryRelationsWritten     Int                      @default(0)
  accessoryReferencesUnresolved Int                      @default(0)
  errorCode                     String?
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([kind, completedAt])
}

/// Egy KAPCSOLAT-UJRAEPITES futasa: a tarolt UNAS-pillanatkepekbol ujraepitett
/// termek-kapcsolatok (hasonlo es kiegeszito).
///
/// === MIERT SAJAT TABLA, ES MIERT NEM EGY ESEMENY ===
///
/// Mert MA MAR MEGBUKTUNK EZEN A PONTOS KERDESEN, ugyanebben a temaban: a
/// #796-ig az elveszett kapcsolat-hivatkozasok szama CSAK a naploban allt, a
/// naplo pedig a kontener indulasakor kezdodik -- egy ujratelepites utan a
/// tegnapi veszteseg sehol nem volt meg. Egy JSON-torzsu esemeny nem naplosor,
/// de a DONTO tulajdonsagban ugyanott all: nem kerdezheto le ugy, hogy "mi
/// tortent a kapcsolatokkal az elmult ket hetben". Egy NAPI futasnal pont ez az
/// egyetlen kerdes, amit fel fognak tenni. (acrobot dontese, 2026-09-17.)
///
/// ES AMIERT NEM "BEFEKTETES A UNAS-UTBA": ez a tabla nem valtoztat semmilyen
/// viselkedest, csak FELJEGYZI, mi tortent. Amikor a gazda-atvetel megtortenik,
/// egy `DROP TABLE` a teljes ara.
model UnasRelationRebuildRun {
  id                              String    @id @default(cuid())
  startedAt                       DateTime  @default(now())
  completedAt                     DateTime?
  /// Irt-e a futas (`--apply`), vagy csak tervet keszitett.
  applied                         Boolean   @default(false)
  /// MEGALLT-E a nagy valtozas hatarán -- es a sor ILYENKOR IS letrejon.
  ///
  /// Ez a legerdekesebb futas, amit rogziteni lehet: ha epp az nem hagyna
  /// nyomot, a tabla pont azt nem tudna, amiert megepult. A megallas TENYE es a
  /// TERVEZETT szamok kerulnek bele. (acrobot kikotese.)
  ///
  /// ES AMIT EBBOL MEG KI KELL OLVASNI: a `stopped = true` egyben azt is
  /// jelenti, hogy a futas IRNI AKART. A hatar csak `--apply` mellett all fel,
  /// terv-modban a CLI sosem all meg rajta. Tehat egy megallt sor nem egy
  /// ovatos terv nyoma, hanem egy visszafogott IRAS-e. Enelkul a kovetkezo
  /// olvaso ezt a levezetest nem fogja megtenni, es az `applied = false`
  /// alapjan probalkozasnak nezi. (acrobot kikotese, 2026-09-17.)
  stopped                         Boolean   @default(false)
  /// Az osszes UNAS kapcsolat-sor a futas ELOTT, es amennyi a TERV szerint utana
  /// allna. A ketto kulonbsege az, amin a hatar all.
  rowsBefore                      Int       @default(0)
  rowsPlanned                     Int       @default(0)
  /// Hany termek visel hivatkozast, es mi tortent velük -- fajtankent.
  ///
  /// AZ ONHIVATKOZAS ES A DUPLIKATUM SZANDEKOSAN NINCS ITT: azok nem
  /// veszteseg, hanem szandekos kihagyas, es a szamuk futasrol futasra
  /// ugyanaz. Egy oszlop, ami sosem mozdul, nem jelzes, hanem alapzaj -- a
  /// kimeneten viszont ott allnak. (Ugyanaz a dontes, mint a
  /// `UnasProductSyncRun` kapcsolat-szamlaloinal.)
  similarProductsWithReferences   Int       @default(0)
  similarRelationsPlanned         Int       @default(0)
  similarRelationsWritten         Int       @default(0)
  similarRelationsRemoved         Int       @default(0)
  similarReferencesUnresolved     Int       @default(0)
  accessoryProductsWithReferences Int       @default(0)
  accessoryRelationsPlanned       Int       @default(0)
  accessoryRelationsWritten       Int       @default(0)
  accessoryRelationsRemoved       Int       @default(0)
  accessoryReferencesUnresolved   Int       @default(0)
  /// Amin NEM dolgoztunk, es az okuk kulon: a pillanatkep nem volt olvashato,
  /// illetve a termeknek nincs kulso azonositoja. Egy kozos szam a ket
  /// kulonbozo teendot mosna ossze.
  unreadableSnapshots             Int       @default(0)
  withoutExternalId               Int       @default(0)
  errorCode                       String?
  createdAt                       DateTime  @default(now())

  @@index([startedAt])
}

/// Egy webshop (UNAS) rendelés-szinkron futás: a getOrder TimeModStart
/// kurzor alapján lekért, új vagy módosult rendelések feldolgozása.
/// Nincs FULL/INCREMENTAL megkülönböztetés (a UnasProductSyncRun-nal
/// ellentétben) - alacsony rendelésszám mellett minden futás ugyanazt az
/// egy "ami a kurzor óta módosult" ablakot dolgozza fel.
model UnasOrderSyncRun {
  id                 String                 @id @default(cuid())
  activeKey          String?                @unique
  status             UnasOrderSyncRunStatus @default(PENDING)
  windowStart        DateTime?
  windowEnd          DateTime
  startedAt          DateTime?
  completedAt        DateTime?
  ordersSeen         Int                    @default(0)
  createdCount       Int                    @default(0)
  updatedCount       Int                    @default(0)
  reversedCount      Int                    @default(0)
  stockMismatchCount Int                    @default(0)
  errorCode          String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([status, createdAt])
}

/// Egy webshop (UNAS) vásárló-szinkron futás: a getCustomer ModTimeStart
/// kurzoron alapuló, új vagy módosult vásárlók feldolgozása. Az
/// UnasOrderSyncRun mintáját követi: nincs FULL/INCREMENTAL megkülönböztetés,
/// minden futás a kurzor óta módosult ablakot dolgozza fel. A UNAS oldali
/// azonosítót (Customer.Id) kizárólag ExternalReference tárolja, a Customer
/// modellen nincs UNAS-specifikus mező (ld. ADR-0009).
model UnasCustomerSyncRun {
  id             String                    @id @default(cuid())
  activeKey      String?                   @unique
  status         UnasCustomerSyncRunStatus @default(PENDING)
  windowStart    DateTime?
  windowEnd      DateTime
  startedAt      DateTime?
  completedAt    DateTime?
  customersSeen  Int                       @default(0)
  createdCount   Int                       @default(0)
  updatedCount   Int                       @default(0)
  unchangedCount Int                       @default(0)
  errorCode      String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([status, createdAt])
}

/// A Gmailből automatikusan beolvasott, egy levélben érkező Foxpost heti
/// elszámolási XLSX és számla-PDF tartós, idempotens feldolgozási rekordja.
/// A forrásfájlok adatbázisban maradnak, így hibajavítás után külső
/// rendszerhívás nélkül újrafeldolgozhatók és auditálhatók.
model FoxpostSettlement {
  id                 String                  @id @default(cuid())
  gmailMessageId     String                  @unique
  gmailThreadId      String?
  gmailInternalDate  DateTime?
  gmailSubject       String?
  gmailFrom          String?
  xlsxAttachmentId   String
  xlsxFileName       String
  xlsxContent        Bytes
  xlsxSha256         String                  @unique
  pdfAttachmentId    String
  pdfFileName        String
  pdfContent         Bytes
  pdfSha256          String                  @unique
  partnerCode        String?
  settlementCode     String?
  periodStart        DateTime?
  periodEnd          DateTime?
  invoiceNumber      String?                 @unique
  invoiceIssueDate   DateTime?
  currency           String                  @default("HUF") @db.VarChar(3)
  collectedAmount    Decimal?                @db.Decimal(19, 4)
  invoiceGrossAmount Decimal?                @db.Decimal(19, 4)
  transferredAmount  Decimal?                @db.Decimal(19, 4)
  status             FoxpostSettlementStatus @default(PROCESSING)
  errorCode          String?
  processedAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  lines FoxpostSettlementLine[]

  @@unique([partnerCode, settlementCode])
  @@index([status, createdAt])
  @@index([invoiceIssueDate])
}

model FoxpostSettlementLine {
  id                     String                      @id @default(cuid())
  settlementId           String
  sourceRowNumber        Int
  referenceCode          String
  transactionDate        DateTime
  recipientName          String?
  parcelBarcode          String?
  collectedAmount        Decimal                     @db.Decimal(19, 4)
  salesOrderId           String?
  invoiceId              String?
  invoiceNumber          String?
  resolutionSource       FoxpostResolutionSource?
  status                 FoxpostSettlementLineStatus
  errorCode              String?
  manualApprovedByUserId String?
  manualApprovedAt       DateTime?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  settlement       FoxpostSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  salesOrder       SalesOrder?       @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  invoice          Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  manualApprovedBy User?             @relation("FoxpostLineManualApprovedBy", fields: [manualApprovedByUserId], references: [id], onDelete: SetNull)

  @@unique([settlementId, sourceRowNumber])
  @@index([referenceCode])
  @@index([status])
  @@index([salesOrderId])
  @@index([invoiceId])
  @@index([manualApprovedByUserId, manualApprovedAt])
}

/// A könyvelésnek átadható havi Foxpost XLSX mindig újragenerálódik, amikor
/// egy heti elszámolás teljesen feloldhatóvá válik. A bájtok megőrzése
/// garantálja, hogy a letöltött fájl pontosan az automatikus futás eredménye.
model FoxpostMonthlyReport {
  id                 String   @id @default(cuid())
  year               Int
  month              Int
  filename           String
  content            Bytes
  settlementCount    Int
  invoiceCount       Int
  collectedAmount    Decimal  @db.Decimal(19, 4)
  invoiceGrossAmount Decimal  @db.Decimal(19, 4)
  transferredAmount  Decimal  @db.Decimal(19, 4)
  generatedAt        DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([year, month])
  @@index([year, month])
}

model FoxpostSyncRun {
  id               String               @id @default(cuid())
