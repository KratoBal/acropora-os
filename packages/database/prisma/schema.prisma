/// MIERT NEM MENT KI EGY TERMEK KEPE A BOLTBA.
///
/// ENUM ES NEM SZOVEG, mert az ot ok kozott MAS a teendo, es egy kozos
/// "blokkolva" jelzo epp ezt tuntetne el. A szoveges reszlet kulon oszlopban
/// all mellette (melyik kep, milyen hiba) -- az a diagnozis, ez a besorolas.
enum MedusaImageBlockReason {
  /// A forrasban NINCS kep-sor. Nem hiba: nincs mit kikuldeni.
  NO_IMAGE_ROW
  /// A kep meg nincs athozva a mesterbe (nincs tarolo-kulcs). A masolo dolga.
  MASTER_MISSING
  /// A tarolo-kulcs all a soron, de a fajl nincs meg: a mestert kell javitani.
  MASTER_CORRUPT
  /// A bajtok nem ismerhetok fel kepkent -- valoszinuleg nem is kep.
  NOT_AN_IMAGE
  /// A feltoltes elhasalt: a bolt vagy a halozat.
  UPLOAD_FAILED
}

