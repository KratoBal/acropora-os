  skippedCount     Int                  @default(0)
  needsReviewCount Int                  @default(0)
  failedCount      Int                  @default(0)
  errorCode        String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([status, createdAt])
}

model AuditLog {
