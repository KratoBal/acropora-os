model User {
  id                String         @id @default(cuid())
  /// A gépi tokenek, amik ennek a felhasználónak a nevében járnak el.
  serviceTokens     ServiceToken[] @relation("ServiceTokenUser")
  email             String         @unique
  /// A hivatalos, teljes név. Dokumentumon (munkalap, aláírás) ez szerepel,
  /// akkor is, ha a felületek a becenevet mutatják.
  displayName       String
  /// Ahogy a kollégát a csapatban szólítják. A felületek ezt írják ki a
  /// teljes név helyett, ha ki van töltve. Nem egyedi, és nem azonosító.
  nickname          String?
  firstName         String         @default("")
  lastName          String         @default("")
  passwordHash      String?
  passwordUpdatedAt DateTime?
  /// AZ ALAIROKOD HASHE -- amit az ugyfel embere ir be a munkalap alairasakor.
  ///
  /// Balazs kerese, 2026-09-04: a szerelo kivalasztja az alairot a listarol, es
  /// az ugyfel beirja a sajat negyjegyu kodjat.
  ///
  /// UGYANAZ A TAROLAS, MINT A JELSZONAL (`users/password.util.ts`, sozott
  /// scrypt), es nem uj konyvtarral: a kod ugyanaz a fajta titok, csak rovidebb.
  /// NYERSEN SEHOL nem all.
  ///
  /// `null`, ha a soron nincs kod. AZ ILYEN FIOK NEM TUD ALAIRNI -- a hianyzo
  /// kod SOHA nem ervenyes. Egy "nincs kod, tehat atengedjuk" ag pontosan azt a
  /// bizonyito erot venne el, amiert az egesz keszul.
  ///
  /// AMIT EZ MA NEM AD MEG, ES TUDOTT DONTES: nincs hol megvaltoztatni. Az
  /// alapertelmezett kod `0000`, es a valtoztatas a ticketing feluleté lesz,
  /// ami meg nem letezik. Balazs ezt szo szerint tudomasul vette -- az elso
  /// idoszakban az alairas ettol FORMALIS, es ez nem mulasztas.
  signatureCodeHash String?
  role              UserRole
  isActive          Boolean        @default(true)
  avatarUrl         String?
  /// MELYIK PARTNER NEVEBEN lep be ez a fiok. Sajat kollegan mindketto NULL.
  ///
  /// A ketto kozul LEGFELJEBB az egyik lehet kitoltve (adatbazis CHECK
  /// constraint: `User_at_most_one_partner_check`). Nem "pontosan egy", mint
  /// az `Asset` tulajdonosanal: ott minden eszkoznek van gazdaja, itt viszont
  /// a sajat kollegank egyikhez sem tartozik, es epp az a tobbseg.
  ///
  /// A ketto EGYUTT ertelmezhetetlen lenne: a szures ilyenkor nem tudna,
  /// melyik partner soraira szukitsen, es barmelyik valasztas idegen adatot
  /// engedne at. Ezert a tiltas adatbazis-szinten all, nem csak a kodban.
  customerId        String?
  supplierId        String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  sessions                   Session[]
  /// A LATHATOSAGI HOZZARENDELESEI: melyik alegysegeket latja (a reszfaval egyutt).
  unitAssignments            UserWorksheetDepartment[]
  notificationRoles          UserNotificationRole[]        @relation("UserNotificationRole")
  serviceCapabilities        UserServiceCapability[]       @relation("UserServiceCapability")
  auditLogs                  AuditLog[]
  domainEvents               DomainEvent[]
  stockMovements             StockMovement[]
  startedInventoryCounts     InventoryCount[]
  posSales                   SalesOrder[]
  createdPurchaseInvoices    PurchaseInvoice[]
  unasCredentialsUpdated     UnasConnectionSetting[]       @relation("UnasCredentialUpdatedBy")
  navCredentialsUpdated      NavConnectionSetting[]        @relation("NavCredentialUpdatedBy")
  szamlazzCredentialsUpdated SzamlazzConnectionSetting[]   @relation("SzamlazzCredentialUpdatedBy")
  medusaCredentialsUpdated   MedusaConnectionSetting[]     @relation("MedusaCredentialUpdatedBy")
  stockReconciliationRepairs StockReconciliationRepair[]
  createdProducts            Product[]                     @relation("ProductCreatedBy")
  createdProjects            Project[]                     @relation("ProjectCreatedBy")
  projectReservations        ProjectInventoryReservation[]
  approvedFoxpostLines       FoxpostSettlementLine[]       @relation("FoxpostLineManualApprovedBy")
  createdAssets              Asset[]                       @relation("AssetCreatedBy")
  updatedAssets              Asset[]                       @relation("AssetUpdatedBy")
  assetEvents                AssetEvent[]
  orderBusinessStatusEvents  OrderBusinessStatusEvent[]    @relation("OrderBusinessStatusEventActor")
  uploadedAssetDocuments     AssetDocument[]               @relation("AssetDocumentUploadedBy")
  uploadedWorksheetDocuments WorksheetDocument[]           @relation("WorksheetDocumentUploadedBy")
  /// A hibajegyekhez (ServiceJob) feltöltött csatolmányok.
  uploadedJobDocuments       ServiceJobDocument[]          @relation("ServiceJobDocumentUploadedBy")
  assignedTasks              Task[]                        @relation("TaskAssignee")
  createdTasks               Task[]                        @relation("TaskCreatedBy")
  closedTasks                Task[]                        @relation("TaskClosedBy")
  createdWorksheets          Worksheet[]                   @relation("WorksheetCreatedBy")
  /// Amiket ez a felhasználó adott át a szolgáltatónak, a helyszíni munka
  /// befejeztével.
  handedOverWorksheets       Worksheet[]                   @relation("WorksheetHandedOverBy")
  /// A LAPOK, AMIKET EZ A KOLLEGA REJTETT EL. A rejtes visszavonhato, tehat
  /// ez a lista fogyhat is.
  hiddenWorksheets           Worksheet[]                   @relation("WorksheetHiddenBy")
  /// Amit ez a felhasználó léptetett egy hibajegyen.
  serviceJobEvents           ServiceJobEvent[]             @relation("ServiceJobEventActor")
  assignedWorksheets         WorksheetAssignee[]           @relation("WorksheetAssignee")
  worksheetAssignmentsMade   WorksheetAssignee[]           @relation("WorksheetAssignedBy")
  /// A hibajegyek, amikre ezt a kollegat delegaltak.
  assignedServiceJobs        ServiceJobAssignee[]          @relation("ServiceJobAssignee")
  serviceJobAssignmentsMade  ServiceJobAssignee[]          @relation("ServiceJobAssignedBy")
  createdWorksheetVersions   WorksheetVersion[]            @relation("WorksheetVersionCreatedBy")
  closedWorksheetVersions    WorksheetVersion[]            @relation("WorksheetVersionClosedBy")
  sentWorksheetVersions      WorksheetVersion[]            @relation("WorksheetVersionSentTo")
  worksheetSignatures        WorksheetVersionSignature[]   @relation("WorksheetSignedBy")
  /// Amiket EZ a szemely irt ala (a lap partnerenek munkatarsakent).
  signedWorksheets           WorksheetVersionSignature[]   @relation("WorksheetSigner")
  /// A munkanaplo-bejegyzesei. `SetNull` a torleskor: a bejegyzes marad, a
  /// szerzo neve nelkul.
  worksheetEntries           WorksheetEntry[]              @relation("WorksheetEntryAuthor")
  /// Anyagigenyek, amiket ez a kollega adott fel a munkalaprol.
  requestedMaterialRequests  MaterialRequest[]             @relation("MaterialRequestRequestedBy")
  /// Anyagigenyek, amiket ez a kollega jelolt "beerkezett"-nek.
  receivedMaterialRequests   MaterialRequest[]             @relation("MaterialRequestReceivedBy")
  deviceTokens               DeviceToken[]
  /// A torles SZANDEKOSAN Restrict, nem SetNull. SetNull mellett egy partner
  /// torlese a fiokot csendben "sajat kollegava" tenne (mindket mezo NULL),
  /// vagyis egy takaritasi muvelet TAGITANA a hozzaferest. Restrict mellett a
  /// torles hangosan elakad, es ember dont a fiok sorsarol.
  customer                   Customer?                     @relation("CustomerPortalUser", fields: [customerId], references: [id], onDelete: Restrict)
  supplier                   Supplier?                     @relation("SupplierPortalUser", fields: [supplierId], references: [id], onDelete: Restrict)
  ticketMailTemplates        TicketMailTemplate[]          @relation("TicketMailTemplateUpdatedBy")

  @@index([role, isActive])
  /// A Restrict ellenorzese MINDEN partner-torlesnel lefut, es index nelkul
  /// vegigolvasna a User tablat.
  @@index([customerId])
  @@index([supplierId])
}

/// Egy telefon, ami push értesítést tud fogadni, és a kolléga, akié.
///
/// A `token` a NYERS APNs eszköz-token, nem Expo-token: közvetlenül az Apple
/// szolgáltatásához küldünk, és egy Expo-token oda soha nem érne célba. A hiba
/// csak élesben látszana, ezért a mező neve is kimondja, mit vár.
///
/// A `bundleId` azért kötelező, mert HÁROM alkalmazás-változat létezik
/// (hu.acropora.os, .dev, .preview), és a küldés fejlécében pontosan azt kell
/// megnevezni, amelyikhez a token tartozik. Egy token a másik változathoz
/// küldve `TopicDisallowed` vagy `BadDeviceToken` hibát ad.
///
/// Egy token EGY eszközt azonosít, és egy eszközön egyszerre egy kolléga van
/// bejelentkezve: ezért a token önmagában egyedi. Ha ugyanazt a telefont másik
/// kolléga veszi használatba, a sor a másik felhasználóhoz kerül át, nem
/// keletkezik belőle második sor.
model DeviceToken {
  id         String         @id @default(cuid())
  userId     String
  token      String         @unique
  bundleId   String
  platform   DevicePlatform @default(IOS)
  /// Az utolsó alkalom, amikor az alkalmazás jelentkezett ezzel a tokennel.
  /// Az Apple által visszautasított tokent töröljük, ez a mező a csendben
  /// elhagyott telefonokról szól.
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum DevicePlatform {
  IOS
  ANDROID
}

/// A session token maga sosem kerül adatbázisba - kizárólag a SHA-256
/// lenyomata (tokenHash). Ez a Bearer/cookie token szerver oldali
/// perzisztens párja: AuthService ezen keresztül oldja fel a tokent
/// felhasználóra, API-újraindítás vagy több API-példány esetén is
/// (korábban memóriabeli Map volt, ami ezt nem tudta).
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Product {
  id               String                   @id @default(cuid())
  name             String
  /// A ROVID leiras (a UNAS `Description.Short` mezoje).
  ///
  /// A NEVE MARAD `description`, mert minden mai hivo ezt olvassa, es egy
  /// atnevezes ugyanazt a munkat jelentene, csak kockazattal.
  description      String?
  /// A HOSSZU leiras (a UNAS `Description.Long` mezoje).
  ///
  /// KULON MEZO, MERT A BOLT IS KET HELYEN MUTATJA OKET: a mai lapon a rovid a
  /// `page_artdet_rovleir`, a hosszu a `tab_description_content` blokkban all,
  /// es ahol mind a ketto letezik, a ROVID all elobb. A ketto tehat nem
  /// valtozata egymasnak, hanem ket kulon tartalom.
  ///
  /// MIERT NEM ELEG AZ EGYIK: merve a publikalt termekeken, 972-nek CSAK rovid
  /// leirasa van es 105-nek CSAK hosszu. Barmelyiket valasztanank egyedul, a
  /// masik halmaz lapjai uresen erkeznenek a boltba.
  descriptionLong  String?
  type             ProductType              @default(PHYSICAL)
  brandId          String?
  /// @deprecated Compatibility pointer. ProductCategory is the category source of truth.
  categoryId       String?
  isActive         Boolean                  @default(true)
  /// Acropora-tulajdonu UZLETI dontes: a termek a SAJAT webshopunkban
  /// ertekesitheto-e. NEM a UNAS publikacios allapotanak tukre - azt a
  /// ChannelListing.isPublished hordozza, es azt a szinkron irja.
  /// Alapertelmezese HAMIS: egy termek soha ne valjon ertekesithetove
  /// azzal, hogy letrejott.
  webshopSellable  Boolean                  @default(false)
  /// Acropora-owned manual decision. UNAS does not calculate or overwrite it.
  advisorKind      ProductAdvisorKind?
  archivedAt       DateTime?
  origin           ProductOrigin?
  catalogAuthority ProductCatalogAuthority?
  createdById      String?
  mirrorSource     ExternalSystem?
  mirrorState      ProductMirrorState?
  sourceCreatedAt  DateTime?
  sourceUpdatedAt  DateTime?
  lastSyncedAt     DateTime?
  missingSince     DateTime?
  rawSourceHash    String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  brand                   Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  legacyCategory          Category?               @relation("LegacyProductCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy               User?                   @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  categories              ProductCategory[]
  variants                ProductVariant[]
  channelListings         ChannelListing[]
  /// MIERT NEM MENT KI A KEP A LEGUTOBBI VETITESKOR. `null`, ha kiment.
  ///
  /// === MIERT A TERMEKEN ALL, ES NEM A KEP SORAN ===
  ///
  /// Merve 2026-09-04: a `ProductImage` sorokat KET UNAS-iro is `deleteMany` +
  /// `createMany` parossal irja ujra, tehat egy ott tarolt ok minden import
  /// utan CSENDBEN eltunne. A termek sorat ezzel szemben csak mezo-szintu
  /// `updateMany` irja.
  ///
  /// A granularitas is ezt kivanja: a kiado az ELSO bukott kepnel megall, es a
  /// termek EGESZ kep-listajat visszatartja (egy felig feltoltott lista a cel
  /// oldalon torolne a tobbi kepet). Egy termek tehat egy okkal all.
  medusaImageBlockReason  MedusaImageBlockReason?
  /// A reszletezo mondat: melyik kep, es mi tortent. A besorolas az enum.
  medusaImageBlockDetails String?
  /// MIKOR ALLAPITOTTUK MEG. Egy elavult ok rosszabb, mint a semmi: e nelkul
  /// nem lehet megmondani, a mai futasbol valo-e a verdikt.
  medusaImageBlockedAt    DateTime?

  images                     ProductImage[]
  descriptionImageReferences ProductDescriptionImageReference[]
  sourceRelations            ProductRelation[]                  @relation("ProductRelationSource")
  targetRelations            ProductRelation[]                  @relation("ProductRelationTarget")
  unasSnapshot               UnasProductSnapshot?
  priceHistory               ProductPriceHistory[]
  aiSearchDocument           AiProductSearchDocument?
  datasheet                  ProductDatasheet?
  shippingProfile            ProductShippingProfile?

  @@index([brandId])
  @@index([categoryId])
  @@index([createdById])
  @@index([type, isActive])
  @@index([origin, catalogAuthority])
  @@index([catalogAuthority, isActive, webshopSellable])
  @@index([mirrorSource, mirrorState])
  @@index([missingSince])
}

model ProductDescriptionImageReference {
  id              String   @id @default(cuid())
  productId       String
  descriptionPart String
  url             String
  host            String?
  isOwn           Boolean
  createdAt       DateTime @default(now())
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, descriptionPart, url])
  @@index([isOwn])
  @@index([host])
}

model ProductVariant {
  id                         String    @id @default(cuid())
  productId                  String
  sku                        String    @unique
  name                       String?
  unit                       String    @default("db")
  vatRate                    Decimal?  @db.Decimal(5, 2)
  /// Az ACROPORA-tulajdonu termek sajat, BRUTTO eladasi ara. Balazs dontese,
  /// 2026-08-29 19:31, Discord, szo szerint: "Vegyuk fel a brutto arat."
  ///
  /// HAROM HASONLO NEVU MEZO VAN A SEMABAN, ES MIND MAST JELENT:
  /// - ez a mezo: a MI arunk, brutto, eladasi;
  /// - `UnasProductSnapshot.grossPrice` es `.saleGrossPrice`: a UNAS TUKRE,
  ///   vagyis amit a webshop allit magarol; a `sale` elotag ott AKCIOS arat
  ///   jelent, nem eladasit;
  /// - `ProductExtension.lastPurchaseNetPrice`: BESZERZESI ar, netto.
  ///
  /// A `sellingPriceCurrency` mezovel EGYUTT ervenyes: vagy mindketto ures,
  /// vagy egyik sem. Ezt adatbazis-szintu CHECK feltetel tartja, mert a
  /// felallapot (osszeg penznem nelkul) nema hiba lenne: a szam onmagaban
  /// helyesnek latszik.
  sellingGrossPrice          Decimal?  @db.Decimal(19, 4)
  /// Az eladasi ar penzneme, ISO 4217 harombetus kod. Ebben a korben KIZAROLAG
  /// `HUF` megengedett, es a vetites minden mast elutasit.
  ///
  /// AZERT VAN KULON OSZLOP, ES NEM A MEZONEVBE SUTVE: enelkul a tarolt szam
  /// nem mondja meg magarol, mi o, es a "rossz penznem" eset nem is lenne
  /// merheto. A brief 12. pontja epp ezt keri falszifikaciokent, es egy olyan
  /// teszt, ami nem tud elbukni, nem kapu.
  sellingPriceCurrency       String?   @db.VarChar(3)
  manufacturerPartNumber     String?
  secondaryUnit              String?
  secondaryUnitFactor        Decimal?  @db.Decimal(19, 6)
  isActive                   Boolean   @default(true)
  /// Original product-level SKU used by UNAS getStock/setStock. Equal to
  /// sku for ordinary products; shared by the locally separated variants
  /// of an UNAS variant-stock product.
  unasBaseSku                String?
  /// Deterministic, ordered value-only key for one UNAS combination.
  /// NULL for ordinary product-level stock.
  unasVariantKey             String?
  /// Ordered [{ name, value }] values mirrored from UNAS. The order is
  /// significant because setStock identifies a combination positionally.
  unasVariantValues          Json?
  /// A kombinacio brutto FELARA a UNAS oldalarol, vagy NULL, ha a forras nem
  /// rendelt hozza felarat.
  ///
  /// A UNAS a felarat nem a keszlet-soron kuldi, hanem a tengely
  /// definiciojaban (`Variants.Variant.Values.Value.ExtraPrice`), ertekenkent.
  /// Ez az oszlop az EBBEN a kombinacioban osszeado ertek.
  ///
  /// AZERT KULON OSZLOP, ES NEM A `unasVariantValues` JSON-jaban: az arat a
  /// vetites olvassa, valtozatonkent, es egy JSON-bol kibanyaszott szam nem
  /// mondja meg magarol, hogy penz -- se tipusa, se pontossaga nem lenne. Ez
  /// ugyanaz az indok, amiert a `sellingPriceCurrency` is sajat oszlop.
  ///
  /// A NULL NEM NULLA: azt jelenti, hogy a forras nem rendelt felarat ehhez a
  /// kombinaciohoz. Egy tarolt nulla mert erteknek latszana.
  unasVariantExtraGrossPrice Decimal?  @db.Decimal(19, 4)
  /// UNAS comparison snapshot for this exact local variant. Ordinary
  /// products retain the product-level snapshot as a compatibility fallback.
  unasReportedStock          Decimal?  @db.Decimal(19, 6)
  unasReportedStockSyncedAt  DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  product                    Product                       @relation(fields: [productId], references: [id], onDelete: Cascade)
  barcodes                   ProductBarcode[]
  supplierProducts           SupplierProduct[]
  stockItems                 StockItem[]
  movementLines              StockMovementLine[]
  salesOrderLines            SalesOrderLine[]
  purchaseLines              PurchaseOrderLine[]
  receiptLines               GoodsReceiptLine[]
  purchaseInvoiceLines       PurchaseInvoiceLine[]
  extension                  ProductExtension?
  inventoryCountLines        InventoryCountLine[]
  unasStockSyncOutboxEntries UnasStockSyncOutbox[]
  stockReconciliationRepairs StockReconciliationRepair[]
  projectReservations        ProjectInventoryReservation[]
  assets                     Asset[]

  @@unique([productId, unasVariantKey])
  @@index([productId, isActive])
  @@index([unasBaseSku])
}

model Brand {
  id             String       @id @default(cuid())
  name           String
  normalizedName String       @unique
  slug           String       @unique
  description    String?
  websiteUrl     String?
  logoUrl        String?
  isActive       Boolean      @default(true)
  archivedAt     DateTime?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  products       Product[]
  aliases        BrandAlias[]

  @@index([isActive, name])
}

model BrandAlias {
  id               String   @id @default(cuid())
  brandId          String
  alias            String
  normalizedAlias  String   @unique
  source           String   @default("MANUAL")
  sourceExternalId String?
  isPreferred      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  brand            Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, source])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent            Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children          Category[]        @relation("CategoryTree")
  legacyProducts    Product[]         @relation("LegacyProductCategory")
  productCategories ProductCategory[]

  @@index([parentId])
}

model ProductCategory {
  id         String   @id @default(cuid())
  productId  String
  categoryId String
  isPrimary  Boolean  @default(false)
  sortOrder  Int?
  source     String?
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([categoryId, productId])
  @@index([productId, isPrimary])
}

model ChannelListing {
  id               String         @id @default(cuid())
  productId        String
  channel          CatalogChannel
  externalStatus   String?
  isPublished      Boolean        @default(false)
  slug             String?
  productUrl       String?
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?
  seoRobots        String?
  /// A UNAS-pillanatkép azonos nevű mezőjéből írjuk, `?? false` alapértékkel.
  /// EZ AZ A HELY, AHOL EGY KÜLÖNBSÉG ELVÉSZ: a pillanatképben a NULL azt
  /// jelenti, hogy a forrás nem nyilatkozott, itt viszont abból `false` lesz,
  /// és onnantól megkülönböztethetetlen attól, hogy a bolt kifejezetten nemet
  /// mondott. A szűkebb irány, tehát védhető -- de aki erre a mezőre `if`-et
  /// ír, tudja meg, hogy a `false` két különböző dolgot takar.
  backorderAllowed Boolean        @default(false)
  sourceCreatedAt  DateTime?
  sourceUpdatedAt  DateTime?
  metadata         Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, channel])
  @@index([channel, isPublished])
}

/// A termek kepe. Az `url` a FORRAS cime (ma a UNAS taroloja), a `storageKey`
/// pedig azt mondja meg, hogy a kep BAJTJAI a mi tarolonkban is ott allnak-e.
///
/// A KETTO NEM KIZARO, ES EZ KULONBSEG A DOKUMENTUMOKHOZ KEPEST. Az
/// `AssetDocument` es a `WorksheetDocument` eseteben a tartalom PONTOSAN az
/// egyik helyen all (`content` XOR `storageKey`), mert ott a bajtok a mieink.
/// Itt az `url` az AZONOSSAG resze (a `[productId, url]` egyedi kulcs erre
/// epul), es akkor is megmarad, amikor a masolat mar nalunk van -- kulonben
/// nem tudnank megmondani, MELYIK forras-kepet hoztuk at.
///
/// A `storageKey` NULL tehat nem hibat jelent, hanem azt, hogy ez a kep meg
/// nincs athozva. A masolo pontosan ezekre fut.
model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  url        String
  storageKey String?
  sortOrder  Int      @default(0)
  altText    String?
  title      String?
  fileName   String?
  source     String
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, url])
  @@index([productId, sortOrder])
  /// A masolo ezen a mezon szur (`storageKey: null`), es 3426 sorbol valogat.
  @@index([storageKey])
}

model ProductRelation {
  id              String              @id @default(cuid())
  sourceProductId String
  targetProductId String
  relationType    ProductRelationType
  sortOrder       Int?
  source          String?

  /// MIERT VAN IDOBELYEG EZEN A TABLAN (nautilus, 2026-09-08).
  ///
  /// A Medusa-vetites esedekessege NEGY forras-idobelyeg legkesobbijebol dol el
  /// (Product, ProductVariant, UnasProductSnapshot, ChannelListing). Amig ezen a
  /// tablan nem volt idobelyeg, egy kapcsolat-valtozas SOHA nem tette esedekesse
  /// a termeket: a kapcsolatok kimentek az adatbazisba, es a boltba nem jutottak
  /// el -- nem hiba miatt, hanem mert nem volt MIN eszrevenni.
  ///
  /// A migracio a MEGLEVO sorokat 1970-01-01-re allitja, NEM `now()`-ra. A `now()`
  /// azt ALLITANA, hogy minden meglevo kapcsolat a migracio pillanataban
  /// valtozott -- ez hamis, es minden kapcsolattal rendelkezo terméket egyszerre
  /// tenne esedekesse. Egy soha nem vetitett termek amugy is esedekes
  /// (NEVER_PROJECTED), tehat a konzervativ ertekkel semmi nem vesz el.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceProduct Product @relation("ProductRelationSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  targetProduct Product @relation("ProductRelationTarget", fields: [targetProductId], references: [id], onDelete: Cascade)

  @@unique([sourceProductId, targetProductId, relationType])
  @@index([targetProductId, relationType])
  @@index([sourceProductId, source])
}

model ProductBarcode {
  id        String         @id @default(cuid())
  variantId String
  code      String         @unique
  isPrimary Boolean        @default(false)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
}

model CatalogImportBatch {
  id                     String                  @id @default(cuid())
  provider               CatalogImportProvider
  sourceFileName         String
  fileSha256             String
  analysisVersion        String                  @default("legacy")
  status                 CatalogImportStatus     @default(STAGED)
  report                 Json?
  applyReport            Json?
  approvedBy             String?
  approvedAt             DateTime?
  appliedBy              String?
  appliedAt              DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  rows                   CatalogImportRow[]
  brandResolutionReviews BrandResolutionReview[]

  @@unique([provider, fileSha256, analysisVersion])
  @@index([provider, createdAt])
  @@index([fileSha256])
}

model CatalogImportRow {
  id                    String                  @id @default(cuid())
  batchId               String
  entityType            CatalogImportEntityType
  sourceRowNumber       Int
  externalId            String?
  sku                   String?
  rawPayload            Json
  parsedPayload         Json
  issues                Json
  status                CatalogImportRowStatus
  createdAt             DateTime                @default(now())
  batch                 CatalogImportBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  brandResolutionReview BrandResolutionReview?

  @@unique([batchId, entityType, sourceRowNumber])
  @@index([batchId, status])
  @@index([entityType, externalId])
  @@index([entityType, sku])
}

model BrandResolutionReview {
  id               String                      @id @default(cuid())
  batchId          String
  importRowId      String                      @unique
  sourceRowNumber  Int
  sku              String
  productName      String
  status           BrandResolutionReviewStatus @default(PENDING)
  proposedBrandKey String?
  resolvedBrandKey String?
  reviewedBy       String?
  reviewedAt       DateTime?
  confidence       Int
  reviewReasons    Json
  resolution       Json
  resolverVersion  String
  configVersion    String
  schemaVersion    String
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  batch            CatalogImportBatch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  importRow        CatalogImportRow            @relation(fields: [importRowId], references: [id], onDelete: Cascade)

  @@unique([batchId, sourceRowNumber])
  @@index([batchId, status])
  @@index([proposedBrandKey, status])
}

model Supplier {
  id                   String    @id @default(cuid())
  code                 String    @unique
  name                 String
  /// EU-s beszállítónál a közösségi adószám (pl. "DE123456789"), belföldinél a magyar adószám; opcionális.
  taxNumber            String?
  /// ISO 3166-1 alpha-2 országkód; a "HU"-tól eltérő érték jelöli az EU-n belüli beszerzést.
  country              String    @default("HU") @db.VarChar(2)
  email                String?
  phone                String?
  /// What kind of partner this is. The two are independent, because one
  /// company can be both: we order from it AND we do service work for it.
  ///
  /// `isSupplier` defaults to true so that every row recorded before this
  /// column existed keeps the meaning it was entered with -- the Partners menu
  /// held suppliers only until now -- and so that the purchase invoice screen,
  /// which creates a supplier without knowing about partner kinds, keeps
  /// working unchanged.
  isSupplier           Boolean   @default(true)
  /// A service partner is one we write worksheets and quotes for. Off by
  /// default: an existing row was never recorded as one, and guessing would
  /// put companies in front of the service staff that nobody put there.
  isService            Boolean   @default(false)
  /// The partner's abbreviation (`FANK`). It used to be the worksheet number's
  /// first segment; since 2026-08-27 the number does not carry it, and the
  /// sheet's title is what names the partner.
  ///
  /// It is still required before a sheet can be closed, because it is a
  /// uniqueness key across two tables and supplying it later is a one-off
  /// step: by then a worksheet may already point at the partner, and "which
  /// partner carries this abbreviation" turns ambiguous in retrospect.
  ///
  /// Four characters, so that the abbreviation reads the same everywhere it is
  /// shown -- a code of varying length makes two partners hard to compare in a
  /// list.
  ///
  /// Narrower than the customer side's `VarChar(8)` on purpose: that column
  /// already holds data and is not being narrowed, but a new column with room
  /// to spare would make "four characters" a habit rather than a rule, and the
  /// first five-character code would arrive without anyone deciding it.
  ///
  /// Null until someone fills it in. A partner can be marked as a service
  /// partner without one -- ticking a box should not turn into a decision at
  /// the wrong moment -- and the worksheet picker leaves those partners out
  /// instead, so nobody can start a sheet that cannot be closed.
  worksheetPartnerCode String?   @unique @db.VarChar(4)
  /// The customer row that carries this partner's worksheets.
  ///
  /// A worksheet hangs off a customer in three places -- the sheet, the unit
  /// (`WorksheetDepartment.customerId`) and the abbreviation the close path
  /// requires (`Customer.worksheetPartnerCode`) -- so letting a worksheet
  /// belong to a
  /// supplier directly would mean two polymorphic relations, two constraints
  /// Prisma cannot express, and a partner code that has to be unique ACROSS
  /// two tables. The mirror row keeps all of that untouched.
  ///
  /// It is a detail of the partner, not a buyer: the customer list leaves
  /// mirror rows out, and the partner screen is where the data is edited. It
  /// is created and kept in step by the system, so a partner is still
  /// recorded once, by hand, in one place.
  customerId           String?   @unique
  /// EU-s (nem "HU") beszállítónál a nemzetközi bankszámlaszám.
  iban                 String?
  /// EU-s (nem "HU") beszállítónál a bank SWIFT/BIC kódja.
  swiftCode            String?
  /// Belföldi ("HU") beszállítónál a hazai formátumú bankszámlaszám.
  bankAccountNumber    String?
  /// Kapcsolattartó neve, mindkét beszállítói körnél.
  contactPersonName    String?
  contactPersonPhone   String?
  contactPersonEmail   String?
  /// Cím adatok; a "country" mező (fent) az irányadó országkód, itt nincs külön tárolva.
  postalCode           String?
  city                 String?
  addressLine1         String?
  addressLine2         String?
  isActive             Boolean   @default(true)
  /// Amikor a partnert törölni akarták, de valami visszatartotta.
  ///
  /// NEM ugyanaz, mint az `isActive`. Egy inaktív partnert kivezettünk: nem
  /// dolgozunk vele, de a törzsadata a miénk. Egy törölt partnert törölni
  /// AKARTUNK, csak nem lehetett fizikailag, mert hivatkozik rá egy régi
  /// bejegyzés, és annak a nevét ott kell hagyni. A kettő egy mezőbe vonva a
  /// listákban nem lenne szétválasztható.
  ///
  /// A törölt partner eltűnik a választókból, de a régi számlán és
  /// munkalapon látszik a neve.
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  products              SupplierProduct[]
  purchaseOrders        PurchaseOrder[]
  purchaseInvoices      PurchaseInvoice[]
  preferredByExtensions ProductExtension[]
  invoices              Invoice[]
  assets                Asset[]
  /// `Restrict`, not `SetNull`: dropping the customer row would leave the
  /// partner's worksheets orphaned while the partner still looks intact.
  customer              Customer?          @relation("PartnerWorksheetMirror", fields: [customerId], references: [id], onDelete: Restrict)
  /// A fiokok, amik ENNEK a partnernek a neveben lepnek be. Nem a mi kollegaink.
  portalUsers           User[]             @relation("SupplierPortalUser")

  @@index([country, isActive])
}

model SupplierProduct {
  id                   String         @id @default(cuid())
  supplierId           String
  variantId            String
  supplierSku          String
  supplierName         String?
  lastPurchaseNet      Decimal?       @db.Decimal(19, 4)
  currency             String         @default("HUF") @db.VarChar(3)
  minimumOrderQuantity Decimal?       @db.Decimal(19, 6)
  packageSize          Decimal?       @db.Decimal(19, 6)
  leadTimeDays         Int?
  supplier             Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  variant              ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([supplierId, supplierSku])
  @@unique([supplierId, variantId])
}

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations                  WarehouseLocation[]
  stockItems                 StockItem[]
  sourceMovements            StockMovement[]               @relation("MovementSourceWarehouse")
  targetMovements            StockMovement[]               @relation("MovementTargetWarehouse")
  purchaseOrders             PurchaseOrder[]
  goodsReceipts              GoodsReceipt[]
  purchaseInvoices           PurchaseInvoice[]
  defaultForExtensions       ProductExtension[]
  inventoryCounts            InventoryCount[]
  salesOrders                SalesOrder[]
  unasStockSyncOutboxEntries UnasStockSyncOutbox[]
  stockReconciliationRepairs StockReconciliationRepair[]
  projectReservations        ProjectInventoryReservation[]
