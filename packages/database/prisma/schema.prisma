  system       ExternalSystem
  entityType   String
  entityId     String
  externalId   String
  externalKey  String?
  metadata     Json?
  lastSyncedAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([system, entityType, externalId])
  @@unique([system, entityType, entityId])
  @@index([entityType, entityId])
