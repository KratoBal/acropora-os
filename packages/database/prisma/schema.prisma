model WarehouseLocation {
  id          String   @id @default(cuid())
  warehouseId String
  code        String
  name        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse            Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockItems           StockItem[]
  sourceMovementLines  StockMovementLine[] @relation("MovementSourceLocation")
  targetMovementLines  StockMovementLine[] @relation("MovementTargetLocation")
  defaultForExtensions ProductExtension[]

  @@unique([warehouseId, code])
}

/// The AI product search INDEX - not a copy of the answer.
///
/// The description the model reads is built on the LIVE path when the answer is
/// assembled; this table exists only so a product can be FOUND. A stale row
/// therefore delays discovery, it never produces a wrong fact.
///
/// `searchVector` is a GENERATED ALWAYS column over the four weight bands and
/// is declared Unsupported here on purpose: Prisma has no generated-column
/// type, and the field must never be writable from the client.
model AiProductSearchDocument {
  id               String   @id @default(cuid())
  productId        String   @unique
  /// A weight: the product name.
  title            String   @default("")
  /// A weight: every article number a person might type, in one band - our own
  /// SKU, the maker's part number, the barcode on the box, and what each
  /// supplier calls the same thing. They answer the same question ("which
  /// product is this?"), so ranking one holder of that fact above another
  /// would need a reason nobody can state. Deduplicated: the same string
  /// legitimately appears twice, and a repeat would raise the rank without
  /// adding information.
  skus             String   @default("")
  /// B weight: brand and category names.
  facets           String   @default("")
  /// B weight - and the reason is not its length: for 1178 products the short
  /// description is the ONLY text that exists.
  descriptionShort String   @default("")
  /// C weight.
  descriptionLong  String   @default("")
  /// D weight.
  parameters       String   @default("")
  /// A deleted product keeps its row and loses this flag. "We used to sell
  /// this, and have not since X" is knowledge worth keeping.
  isSearchable     Boolean  @default(true)
  /// Which recipe built it. A full rebuild leaves a mixed-version table behind
  /// while it runs, and the answer says so out loud.
  documentVersion  Int      @default(1)
  updatedAt        DateTime @updatedAt

  searchVector Unsupported("tsvector")? @default(dbgenerated())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([documentVersion])
  /// Trigram index for typo tolerance, on the NAME only. Declared here so a
  /// later `migrate dev` does not read it as drift and propose dropping it.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// UNAS-owned product fields mirrored for read-only operational use.
/// Reported stock is a comparison snapshot and never the local stock ledger.
/// A NAPI AR NYOMA -- APPEND-ONLY, MERT VISSZAMENOLEG NEM POTOLHATO.
///
/// === MIERT LETEZIK ===
///
/// A sema 96 modelljebol 14 hordoz ar-mezot, es NULLA volt tortenet-alaku
/// (nautilus merese, 2026-09-10). A `UnasProductSnapshot.productId` UNIQUE,
/// tehat termekenkent EGY sor all, es minden szinkron LECSERELI. A napi ar
/// atmegy a rendszeren, es minden nap felulirjuk.
///
/// Az Omnibus harminc napos ablaka ("a legalacsonyabb ar az elmult 30 napban")
/// az elso akcio pillanataban all be -- akkor viszont mar nem tudunk
/// visszanezni. Ma elkezdeni egy lepes; visszamenoleg LEHETETLEN.
///
/// === MIERT SOR, ES NEM MEZO ===
///
/// Egy tabla, ami TUDNA tortenetet tarolni, de a kod felulirja, ugyanaz a
/// csapda, mint a Medusa `deleted_at` oszlopa: letezik a hely, es megsem
/// keletkezik tortenet. Ezert nincs `@unique` a `productId`-n, es nincs
/// frissito ut: a sor beirodik, es utana nem valtozik.
///
/// === KET IDOPONT, ES A KETTO NEM UGYANAZ ===
///
/// `observedAt`  MIKOR VOLT IGAZ az ar (a szinkron ablakanak vege)
/// `createdAt`   MIKOR IRTUK LE
///
/// Egy jogi kovetelmenynel a ketto szetvalasztasa nem finomkodas: ha a
/// szinkron kesobb fut le, a ket ertek elter, es a hatarido az ELSOhoz
/// igazodik. Egy kozos mezo csendben a masodikat allitana.
///
/// === MI KERUL BELE ===
///
/// Mind a negy ar-mezo es a penznem, mert a vevo altal fizetheto ar az akcios
/// ar is lehet -- az Omnibus epp arrol szol. Egy sor MINDIG a teljes
/// ar-kepet rogziti, nem csak azt, ami valtozott: egy resz-sor kesobb nem
/// olvashato vissza ar-kent.
///
/// === EGY NYITOTT KERDES, AMIT NEM EN DONTOK EL ===
///
/// A `Cascade` azt jelenti, hogy a termek torlese a tortenetet is elviszi. Ez
/// a sema tobbi esemeny-tablajanak a mintaja. Ha a jogi megorzesnek TULELNIE
/// kell a termek torleset, ez `Restrict`-re valtozik -- de az mar arrol szol,
/// hogy egy termek nem torolheto, amig ara volt, es az nem fejlesztoi dontes.
model ProductPriceHistory {
  id             String             @id @default(cuid())
  productId      String
  /// ISO 4217 harombetus kod. Azert all itt, mert a szam onmagaban nem mondja
  /// meg magarol, mi o -- ugyanaz az indok, mint a `sellingPriceCurrency`-nel.
  currency       String?            @db.VarChar(3)
  netPrice       Decimal?           @db.Decimal(19, 4)
  grossPrice     Decimal?           @db.Decimal(19, 4)
  saleNetPrice   Decimal?           @db.Decimal(19, 4)
  saleGrossPrice Decimal?           @db.Decimal(19, 4)
  /// HONNAN JON A SOR. Kimondott mezo, nem kovetkeztetes: a kezdo sor es egy
  /// szinkronbol szuletett sor kulonbozo allitas, es a kulonbseget kesobb NEM
  /// lehetne visszafejteni az idobelyegbol.
  source         PriceHistorySource
  /// MIKOR VOLT IGAZ ez az ar. Lasd a modell fejlecet.
  observedAt     DateTime
  createdAt      DateTime           @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// A tortenet mindig EGY termekre, idorendben. Az Omnibus-kerdes ("mi volt a
  /// legalacsonyabb az elmult 30 napban") pontosan ezen az indexen fut.
  ///
  /// KEZDO SORBOL TERMEKENKENT EGY LEHET, es ezt egy RESZLEGES egyedi index
  /// tartja (`ProductPriceHistory_product_initial_key`, `WHERE "source" =
  /// 'INITIAL'`), amit a Prisma sema nem tud kifejezni, ezert a migracioban
  /// all nyers SQL-kent. A teljes `([productId, source])` par rossz lenne: a
  /// `UNAS_SYNC` sorok termekenkent SOKSZOR ismetlodnek, eppen az a lenyegük.
  @@index([productId, observedAt])
}

/// A tortenet-sor szarmazasa.
enum PriceHistorySource {
  /// Az induláskor felvett KEZDO sor, a `UnasProductSnapshot` akkori
  /// allapotabol. Minden termekre keletkezik, meg akkor is, ha az ar azota sem
  /// mozdult -- kulonben egy harminc napig valtozatlan arnal nincs mihez merni,
  /// es epp az a leggyakoribb eset.
  INITIAL
  /// A UNAS-szinkron kozben rogzitett valtozas.
  UNAS_SYNC
}

model UnasProductSnapshot {
  id                             String    @id @default(cuid())
  productId                      String    @unique
  currency                       String?   @db.VarChar(3)
  netPrice                       Decimal?  @db.Decimal(19, 4)
  grossPrice                     Decimal?  @db.Decimal(19, 4)
  saleNetPrice                   Decimal?  @db.Decimal(19, 4)
  saleGrossPrice                 Decimal?  @db.Decimal(19, 4)
  saleStartsAt                   DateTime?
  saleEndsAt                     DateTime?
  priceDisplay                   String?
  descriptionShort               String?
  descriptionLong                String?
  /// The claim UNAS makes about its own content, NOT our measurement of it.
  /// Do not branch on it: measured 2026-08-28 over 1893 products, the TRUE
  /// value is reliable (zero false positives), but of the 884 short
  /// descriptions it calls plain text, 774 do hold tags. NULL means the
  /// response carried no description block. Read the text instead:
  /// `plainText` in ai-product-search.text.ts.
  descriptionShortIsHtml         Boolean?
  /// Same claim, same caveat, milder numbers: 47 of the 106 long descriptions
  /// it calls plain text do hold tags. The TRUE value is reliable here too.
  descriptionLongIsHtml          Boolean?
  productUrl                     String?
  sefUrl                         String?
  manufacturerUrl                String?
  vatRate                        Decimal?  @db.Decimal(5, 2)
  minimumOrderQuantity           Decimal?  @db.Decimal(19, 6)
  maximumOrderQuantity           Decimal?  @db.Decimal(19, 6)
  orderQuantityStep              Decimal?  @db.Decimal(19, 6)
  /// A FORRÁS ÁLLÍTÁSA, ÉS RÁADÁSUL ÁTNEVEZVE. A UNAS `StockStatus.Empty`
  /// mezőjéből jön, tehát ott ÁLLAPOT ("üres"), itt SZABÁLY ("hátralékos
  /// rendelés engedélyezett"). A fordítás sehol nincs leírva, és ez a komment
  /// az egyetlen hely, ahol a kettő találkozik.
  ///
  /// Nem mérés: nem azt mondja meg, mi történik egy nulla készletű rendelésnél,
  /// hanem azt, amit a bolt magáról állít. Mérve 2026-08-28: a mezőt a
  /// `ChannelListing.backorderAllowed` oszlopba írjuk tovább `?? false`
  /// alapértékkel, tehát ott a "nem nyilatkozott" és a "nem" megkülönböztet-
  /// hetetlenné válik. Itt még nem: a NULL azt jelenti, hogy a forrás hallgatott.
  backorderAllowed               Boolean?
  /// Szintén a forrás állítása, a `StockStatus.Variant` mezőből. A neve
  /// beállítást sugall ("enabled"), a forrásé állapotot -- és senki nem olvassa
  /// ma: tárolt állítás, amire még nem épül döntés. Ha valaha épülni fog, előbb
  /// mérni kell, mint a HTML-jelzőknél.
  variantStockEnabled            Boolean?
  lowStockThreshold              Decimal?  @db.Decimal(19, 6)
  reportedStock                  Decimal?  @db.Decimal(19, 6)
  reportedStockSyncedAt          DateTime?
  /// UNAS computed bundle/package product. It has no independently managed
  /// physical stock in Acropora OS; its sellable quantity is derived from
  /// packageComponents.
  isPackageProduct               Boolean   @default(false)
  /// Normalized [{ sku, qty }] rows from UNAS PackageComponents.Component.
  packageComponents              Json      @default("[]")
  primaryCategoryExternalId      String?
  alternativeCategoryExternalIds Json?
  images                         Json?
  parameters                     Json?
  seo                            Json?
  rawPayload                     Json
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([isPackageProduct])
}

/// Acropora-owned static operational settings for a sellable/stockable variant.
/// Purchase cost history belongs to GoodsReceiptLine, not this model.
model ProductExtension {
  id                      String   @id @default(cuid())
  variantId               String   @unique
  preferredSupplierId     String?
  defaultPurchaseCurrency String?  @db.VarChar(3)
  defaultWarehouseId      String?
  defaultLocationId       String?
  minimumStock            Decimal? @db.Decimal(19, 6)
  optimalStock            Decimal? @db.Decimal(19, 6)
  reorderPoint            Decimal? @db.Decimal(19, 6)
  safetyStock             Decimal? @db.Decimal(19, 6)
  lastPurchaseNetPrice    Decimal? @db.Decimal(19, 6)
  lastPurchaseVatRate     Decimal? @db.Decimal(5, 2)
  stockTrackingEnabled    Boolean  @default(true)
  purchasingDisabled      Boolean  @default(false)
  phaseOut                Boolean  @default(false)
  autoReorderEnabled      Boolean  @default(false)
  internalNote            String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  variant           ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  preferredSupplier Supplier?          @relation(fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  defaultWarehouse  Warehouse?         @relation(fields: [defaultWarehouseId], references: [id], onDelete: SetNull)
  defaultLocation   WarehouseLocation? @relation(fields: [defaultLocationId], references: [id], onDelete: SetNull)

  @@index([preferredSupplierId])
  @@index([defaultWarehouseId])
  @@index([defaultLocationId])
}

/// Read-optimized projection rebuilt from posted stock movement lines; never the stock source of truth.
model StockItem {
  id          String   @id @default(cuid())
  variantId   String
  warehouseId String
  locationId  String?
  lotId       String?
  onHand      Decimal  @default(0) @db.Decimal(19, 6)
  reserved    Decimal  @default(0) @db.Decimal(19, 6)
  updatedAt   DateTime @updatedAt

  variant               ProductVariant                @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse             Warehouse                     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  location              WarehouseLocation?            @relation(fields: [locationId], references: [id], onDelete: SetNull)
  reconciliationRepairs StockReconciliationRepair[]
  projectReservations   ProjectInventoryReservation[]

  @@unique([variantId, warehouseId, locationId, lotId])
  @@index([warehouseId, variantId])
}

/// Milyen fajta helyreállítást hajtott végre egy
/// StockReconciliationRepair sor - lásd
/// apps/api/src/inventory/stock-reconciliation-repair.service.ts.
/// Szándékosan csak két érték: a checkpoint 6 "C" típusa (ESTABLISH_
/// CONTROLLED_BASELINE, kontrollált fizikai baseline létrehozása) NEM
/// implementálódott ebben a checkpointban - lásd
/// docs/INVENTORY-CONSISTENCY.md "Biztonságos javítási terv" - mert
/// ehhez a StockMovementType enum bővítése (két új, egyértelmű előjelű
/// típus, BASELINE_INCREASE/BASELINE_DECREASE) ÉS a reconciliation
/// ledger-provability ablak (a legutóbbi baseline mozgástól számítva)
/// átalakítása szükséges - ezt a checkpoint kifejezetten csak akkor kéri
/// megépíteni, ha egyértelműen és biztonságosan reprezentálható, egyébként
/// dokumentált tervként kell hagyni. Emiatt ez az enum sem sorolja fel
/// most - egy jövőbeli, additív migráció bővítheti majd.
enum StockReconciliationRepairType {
  LOCAL_FROM_PROVEN_LEDGER
  REPUBLISH_LOCAL_TO_UNAS
}

/// APPLIED: a StockItem/outbox ténylegesen módosult. NOOP: a művelet
/// lefutott, de nem volt mit módosítani (pl. a ledger már egyezett az
/// onHand-del) - ez is auditálandó eset, nem csak a tényleges változás.
/// REJECTED: egy üzleti szabály (bizonyítatlan baseline, elavult
/// expectedCurrentOnHand, hiányzó UNAS-link, már versengő publikálás stb.)
/// miatt a művelet el sem indult - a StockItem/outbox nem változott.
/// Szándékosan NINCS külön FAILED érték: egy valódi, váratlan
/// tranzakció-hiba esetén a teljes tranzakció (beleértve MAGÁT ez audit
/// sor létrehozását is) visszagördül, tehát ilyenkor EGYÁLTALÁN nem
/// keletkezik sor - soha nem fordulhat elő "SUCCESS audit részleges
/// módosítással" állapot, mert nincs olyan út, amin egy sikertelen
/// tranzakció mellett bármi (akár csak az audit sor) megmaradna. Ugyanezt
/// a mintát követi inventory-count.repository.ts applyCorrection-je is
/// (failedCount doc-comment: "a jelenlegi tranzakciós modell mellett
/// gyakorlatilag mindig 0").
enum StockReconciliationRepairStatus {
  APPLIED
  NOOP
  REJECTED
}

/// Auditálható, egyedi rekordokra korlátozott admin-repair a
/// checkpoint 5 read-only reconciliation-jének eredményére építve - lásd
/// docs/INVENTORY-CONSISTENCY.md "Biztonságos javítási terv". Minden
/// mutáló repair-kísérlet (dry-run KIVÉTELÉVEL - az explicit nem ír
/// semmit, se StockItem-et, se ide) pontosan egy sort ír ide, ugyanabban
/// a tranzakcióban, amiben a StockItem/outbox is módosul (ha módosul).
/// dryRun NINCS mezőként - a dry-run futás definíció szerint sosem jut el
/// idáig (lásd a service doc-commentjét).
model StockReconciliationRepair {
  id                    String                          @id @default(cuid())
  repairType            StockReconciliationRepairType
  status                StockReconciliationRepairStatus
  /// Nullable: egy jövőbeli baseline-típus (l. StockReconciliationRepairType
  /// doc-comment) olyan variánst is érinthetne, aminek MÉG nincs StockItem
  /// sora - a jelenlegi két típus (A, B) mindig egy már létező StockItem-re
  /// vonatkozik, tehát ezeknél gyakorlatilag mindig kitöltött.
  stockItemId           String?
  variantId             String
  warehouseId           String
  /// Szerveroldalon, a munkamenetből feloldott, sosem a kliens által
  /// küldött mezőből - lásd stock-reconciliation-repair.controller.ts.
  actorUserId           String
  reason                String
  /// `RECONCILIATION_REPAIR:<repairType>:<stockItemId>:<expectedCurrentOnHand>`
  /// - lásd a service doc-commentjét a pontos indoklásért.
  idempotencyKey        String                          @unique
  expectedCurrentOnHand Decimal                         @db.Decimal(19, 6)
  /// Null egy REJECTED sornál (sosem olvasta újra zárolás alatt, mert a
  /// zárolás előtti ellenőrzés már elutasította).
  beforeOnHand          Decimal?                        @db.Decimal(19, 6)
  /// Null egy REJECTED sornál (nem történt módosítás). Egy NOOP sornál
  /// SZÁNDÉKOSAN NEM null, hanem ugyanaz az érték, mint beforeOnHand - a
  /// "semmi nem változott, mert a ledger már egyezett" tény önmagában is
  /// auditálandó adat, nem csak "nincs adat".
  afterOnHand           Decimal?                        @db.Decimal(19, 6)
  /// A reconciliation által számított, bizonyított ledger-elméleti érték a
  /// döntés pillanatában - null, ha nem volt bizonyítható (ez maga a
  /// leggyakoribb REJECTED-ok).
  ledgerExpectedOnHand  Decimal?                        @db.Decimal(19, 6)
  /// Ehhez a két repair-típushoz sosem jön létre StockMovement (lásd a
  /// repairType doc-commentjét: "ne hozzon létre normál üzleti
  /// StockMovementet") - a mező egy jövőbeli baseline-típushoz van
  /// fenntartva.
  movementId            String?
  /// A REPUBLISH_LOCAL_TO_UNAS által létrehozott (vagy a
  /// LOCAL_FROM_PROVEN_LEDGER által, ha a helyi érték változott,
  /// szintúgy létrehozott) UnasStockSyncOutbox sor azonosítója.
  outboxId              String?
  /// Csak technikai, nem-érzékeny mezők (pl. a reconciliation adott
  /// pillanatban számított teljes állapota) - sosem rendelési/vevői adat.
  requestDetail         Json?
  resultDetail          Json?
  createdAt             DateTime                        @default(now())
  completedAt           DateTime?

  actor     User           @relation(fields: [actorUserId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  stockItem StockItem?     @relation(fields: [stockItemId], references: [id], onDelete: SetNull)

  @@index([variantId, warehouseId])
  @@index([status, createdAt])
  @@index([actorUserId, createdAt])
}

/// Ma az egyetlen érték: a checkpoint 4/5-ös
/// unas-order-sync.repository.integration.spec.ts (76d8c80) valódi
/// PostgreSQL advisory-lock konkurenciatesztjének release-bizonyítéka.
/// Új típus hozzáadása additív migráció.
enum ReleaseEvidenceType {
  INVENTORY_POSTGRES_CONCURRENCY_TEST
}

enum ReleaseEvidenceStatus {
  SUCCESS
  FAILURE
}

/// Gépileg olvasható, hiteles bizonyíték arra, hogy egy adott commit-ra
/// egy adott teszt-suite ténylegesen lefutott egy valódi PostgreSQL
/// ellen, és milyen eredménnyel - lásd
/// apps/api/src/health/stock-diagnostics.service.ts::activationReadiness()
/// és docs/INVENTORY-CONSISTENCY.md "Release evidence" szakaszát.
///
/// KRITIKUS: ezt a táblát KIZÁRÓLAG egy hiteles CI/release-folyamat írhatja
/// - lásd packages/database/scripts/record-release-evidence.ts, ami egy
/// önálló, a NestJS HTTP API-tól teljesen független szkript (nincs
/// controller/route, ami elérné). Nincs és nem is lesz általános admin
/// endpoint, amivel valaki kézzel SUCCESS-re állíthatna egy sort - ez a
/// checkpoint 7 saját, kifejezett "legfontosabb szabálya".
///
/// Nincs egyedi kényszer (unique) az (evidenceType, commitSha) párra -
/// egy commit többször is tesztelhető (pl. újrafuttatott CI job), minden
/// kísérlet saját sort kap; az activation-readiness mindig a
/// LEGÚJABB, státusz szerint SUCCESS sort keresi a vizsgált commitra.
model ReleaseEvidence {
  id                    String                @id @default(cuid())
  evidenceType          ReleaseEvidenceType
  status                ReleaseEvidenceStatus
  /// A tesztelt release pontos commit SHA-ja - lásd
  /// apps/api/src/common/release-info.util.ts: a futó appnak ISMERNIE
  /// kell a saját commitját (RELEASE_COMMIT_SHA env), különben nem tudja
  /// összevetni ezt a mezőt önmagával, és az activation-readiness
  /// NOT_DEMONSTRATED marad.
  commitSha             String
  /// Stabil CI-azonosító (pl. GitHub Actions run id). Checkpoint 8 óta az
  /// activation-readiness logikája IS megköveteli (nem lehet üres), mert
  /// enélkül egy sor nem lenne visszavezethető egy konkrét, ellenőrizhető
  /// CI-futásra.
  workflowRunId         String
  /// --- Checkpoint 8: GitHub Actions saját, a job kódja által NEM
  /// felülírható kontextusváltozóiból (github.repository / github.workflow /
  /// github.job / github.event_name) származó provenance-mezők - lásd
  /// .github/workflows/ci.yml "Record release evidence" lépését és
  /// docs/INVENTORY-CONSISTENCY.md "Checkpoint 8" szakaszát. Ezek NEM
  /// helyettesítik a commitSha-alapú egyezést, hanem kiegészítik: egy
  /// idegen repóból, más workflow/job névvel, vagy nem megbízható
  /// eseményből (pl. fork pull_request) érkező sor gyanúsnak minősül, még
  /// ha a commitSha véletlenül egyezne is.
  repository            String
  workflowName          String
  jobName               String
  /// GitHub Actions esemény neve (pl. "push", "pull_request",
  /// "workflow_dispatch"). Az activation-readiness ezt is megvizsgálja:
  /// egy fork-eredetű pull_request-tesztfutás sosem tekinthető a
  /// production release hiteles bizonyítékának.
  triggerEvent          String
  environment           String
  databaseEngine        String
  /// A tesztelt PostgreSQL tényleges főverziója (pl. "16"). Checkpoint 8:
  /// az activation-readiness KIZÁRÓLAG "16" főverziójú bizonyítékot fogad
  /// el production release-hez, mert a production postgres:16-alpine-ot
  /// futtat - egy PostgreSQL 18.4-en lefutott teszt (lásd checkpoint 7)
  /// értékes kiegészítő kompatibilitási bizonyíték marad, de önmagában
  /// nem elég a gate feloldásához.
  databaseEngineVersion String
  testSuite             String
  startedAt             DateTime
  completedAt           DateTime
  /// Szabad-formátumú, nem-érzékeny technikai részlet (pl. hány
  /// forgatókönyv futott le/ment át) - sosem rendelési/vevői adat.
  resultDetail          Json?
  createdAt             DateTime              @default(now())

  @@index([evidenceType, commitSha, status])
  @@index([evidenceType, createdAt])
}

/// idempotencyKey: a központi InventoryMovementWriter (lásd
/// apps/api/src/common/inventory-movement-writer.ts) által kötelezően
/// megadott, forrásfolyamatonként egyedi kulcs (pl. "POS_SALE:<orderNumber>",
/// "UNAS_ORDER_IMPORT:<unasOrderKey>"), ami megakadályozza, hogy ugyanaz az
/// üzleti esemény (pl. egy duplán újraküldött POS-kérés vagy egy ismételten
/// lefutó UNAS-rendeléslezáró poll) kétszer könyvelje le ugyanazt a
/// készletmozgást. Nullable marad a korábbi, e mechanizmus előtti sorok miatt.
model StockMovement {
  id                String              @id @default(cuid())
  movementNumber    String              @unique
  type              StockMovementType
  status            StockMovementStatus @default(DRAFT)
  sourceWarehouseId String?
  targetWarehouseId String?
  referenceType     String?
  referenceId       String?
  idempotencyKey    String?             @unique
  note              String?
  occurredAt        DateTime
  postedAt          DateTime?
  performedById     String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  sourceWarehouse Warehouse?          @relation("MovementSourceWarehouse", fields: [sourceWarehouseId], references: [id])
  targetWarehouse Warehouse?          @relation("MovementTargetWarehouse", fields: [targetWarehouseId], references: [id])
  performedBy     User?               @relation(fields: [performedById], references: [id], onDelete: SetNull)
  lines           StockMovementLine[]

  @@index([status, occurredAt])
  @@index([referenceType, referenceId])
}

model StockMovementLine {
  id               String  @id @default(cuid())
  movementId       String
  variantId        String
  sourceLocationId String?
  targetLocationId String?
  quantity         Decimal @db.Decimal(19, 6)
  unit             String
  lotId            String?
  serialNumberId   String?

  movement       StockMovement      @relation(fields: [movementId], references: [id], onDelete: Cascade)
  variant        ProductVariant     @relation(fields: [variantId], references: [id])
  sourceLocation WarehouseLocation? @relation("MovementSourceLocation", fields: [sourceLocationId], references: [id])
  targetLocation WarehouseLocation? @relation("MovementTargetLocation", fields: [targetLocationId], references: [id])

  @@index([variantId])
  @@index([movementId])
}

enum UnasStockSyncOutboxStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

/// A forrásfolyamat, ami a kimenő UNAS készletpublikálást kiváltotta -
/// diagnosztikához és admin szűréshez, illetve ahhoz, hogy egy adott
/// forrásrekordhoz (pl. egy adott POS-eladáshoz) tartozó publikálás(ok)
/// visszakereshetők legyenek.
enum UnasStockSyncSourceProcess {
  INVENTORY_COUNT
  PURCHASE_INVOICE
  POS_SALE
  UNAS_ORDER_IMPORT
  UNAS_ORDER_UPDATE
  UNAS_ORDER_CANCEL
  /// Nettó készlet-visszaforgatás egy UNAS-ból fizikailag törölt (nem
  /// sztornózott!) rendelésnél - lásd SalesOrder.unasDeletedAt doc-comment
  /// és docs/INVENTORY-CONSISTENCY.md "UNAS-ból fizikailag törölt
  /// rendelések". Külön érték a UNAS_ORDER_CANCEL-től, hogy a diagnosztika/
  /// admin szűrés egyértelműen megkülönböztesse a két, azonos mechanizmust
  /// (targetOut=0) használó, de üzletileg más eseményt.
  UNAS_ORDER_DELETED
  RECONCILIATION
}

/// Tartós, tranzakciós outbox a UNAS-készletpublikáláshoz.
///
/// Minden sikeres helyi készletmódosítás (lásd
/// apps/api/src/common/inventory-movement-writer.ts) UGYANABBAN a DB
/// tranzakcióban ír ide egy sort, mint amiben a StockItem/StockMovement
/// módosul - a UNAS HTTP hívás soha nem történik ebben a tranzakcióban,
/// azt egy külön háttér-worker végzi (lásd
/// apps/api/src/inventory/unas-stock-sync-outbox.worker.ts és
/// docs/INVENTORY-CONSISTENCY.md).
///
/// targetOnHand mindig egy ABSZOLÚT készletértéket hordoz (nem delta-t):
/// amikor egy variánshoz gyors egymásutánban több készletváltozás is
/// történik, minden változás új sort kap ide (idempotenciakulccsal,
/// forrásrekordonként), de mivel mindegyik a saját tranzakciójában frissen
/// kiolvasott, aktuális StockItem.onHand értéket hordozza, a worker a
/// legfrissebb (legnagyobb `sequence`) PENDING sort dolgozza fel elsőként
/// egy adott (variantId, warehouseId) kulcsra, a nála régebbi, még
/// feldolgozatlan sorokat pedig ténylegesen UNAS-hívás NÉLKÜL, azonnal
/// SUCCEEDED-re zárja (lásd resolutionNote) - így egy régebbi esemény soha
/// nem írhatja felül egy újabb esemény frissebb UNAS-publikált készletét.
model UnasStockSyncOutbox {
  id             String                     @id @default(cuid())
  variantId      String
  warehouseId    String
  sku            String
  targetOnHand   Decimal                    @db.Decimal(19, 6)
  idempotencyKey String                     @unique
  sourceProcess  UnasStockSyncSourceProcess
  sourceRecordId String
  status         UnasStockSyncOutboxStatus  @default(PENDING)
  attempts       Int                        @default(0)
  nextAttemptAt  DateTime                   @default(now())
  lastError      String?
  /// Amikor egy sort ténylegesen UNAS-hívás nélkül zárunk le (mert egy
  /// nála frissebb sor már publikálta/publikálni fogja az aktuális
  /// készletet), ide kerül pl. "superseded_by:<id>" - megkülönbözteti egy
  /// valódi sikeres UNAS-publikálástól, miközben a status mező az 5
  /// előírt érték egyikén marad.
  resolutionNote String?
  /// PROCESSING lease lejárati ideje - lásd unas-stock-sync-outbox.worker
  /// dokumentációját. Egy worker-crash után egy másik (vagy egy később
  /// induló) worker-példány ez alapján ismeri fel és veszi vissza az
  /// elárvult sort, NULL amíg a sor sosem volt PROCESSING állapotban.
  leaseExpiresAt DateTime?
  /// Diagnosztikai célú, nem funkcionális: melyik worker-példány (process)
  /// foglalta le utoljára - segít éles incidens esetén beazonosítani, hogy
  /// melyik instance akadt el.
  claimedBy      String?
  sequence       BigInt                     @default(autoincrement())
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  processedAt    DateTime?

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([variantId, warehouseId, status])
  @@index([sourceProcess, sourceRecordId])
}

/// Egy leltározási folyamat: Excel-exporttal induló, felhasználó által
/// kitöltött, majd visszatöltött darabszám-számlálás, amiből egy StockMovement
/// (ADJUSTMENT) korrekció és UNAS setStock push készül.
model InventoryCount {
  id          String               @id @default(cuid())
  countNumber String               @unique
  warehouseId String
  status      InventoryCountStatus @default(DRAFT)
  startedById String?
  uploadedAt  DateTime?
  correctedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  warehouse Warehouse            @relation(fields: [warehouseId], references: [id])
  startedBy User?                @relation(fields: [startedById], references: [id], onDelete: SetNull)
  lines     InventoryCountLine[]

  @@index([status, createdAt])
}

model InventoryCountLine {
  id               String                       @id @default(cuid())
  inventoryCountId String
  variantId        String
  expectedQty      Decimal                      @db.Decimal(19, 6)
  countedQty       Decimal?                     @db.Decimal(19, 6)
  syncStatus       InventoryCountLineSyncStatus @default(PENDING)
  syncError        String?

  inventoryCount InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([inventoryCountId, variantId])
  @@index([inventoryCountId])
}

model Customer {
  id                    String       @id @default(cuid())
  customerNumber        String       @unique
  type                  CustomerType
  displayName           String
  companyName           String?
  /// A partner rövidítése (pl. `FANK`), a szerviz partner tükör-során. A
  /// munkalap-szám 2026-08-27 óta NEM hordozza, a lezárás viszont továbbra is
  /// megköveteli: a rövidítés egyediségi kulcs két táblán (itt és a
  /// `Supplier` során), és a pótlása egyszeri lépés. Ha a pótlás pillanatában
  /// már létezik a partnerre hivatkozó lap, a "melyik partner viselte ezt a
  /// rövidítést" kérdés visszamenőleg válik kétértelművé. Amíg nincs
  /// kitöltve, ehhez a vevőhöz munkalap nem zárható le.
  worksheetPartnerCode  String?      @unique @db.VarChar(8)
  taxNumber             String?
  email                 String?
  phone                 String?
  marketingEmailConsent Boolean      @default(false)
  marketingSmsConsent   Boolean      @default(false)
  isActive              Boolean      @default(true)
  archivedAt            DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  addresses            CustomerAddress[]
  salesOrders          SalesOrder[]
  aquariums            Aquarium[]
  serviceJobs          ServiceJob[]
  invoices             Invoice[]
  projects             Project[]
  assets               Asset[]
  worksheetDepartments WorksheetDepartment[]
  worksheets           Worksheet[]
  /// Set when this row is a service partner's mirror rather than a buyer.
  /// The customer list uses its absence to tell the two apart.
  partner              Supplier?             @relation("PartnerWorksheetMirror")
  /// A fiokok, amik ENNEK a vevonek a neveben lepnek be. Nem a mi kollegaink.
  portalUsers          User[]                @relation("CustomerPortalUser")

  @@index([displayName])
  @@index([email])
}

model CustomerAddress {
  id         String      @id @default(cuid())
  customerId String
  type       AddressType
  name       String?
  country    String      @default("HU") @db.VarChar(2)
  postalCode String
  city       String
  line1      String
  line2      String?
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assets     Asset[]

  @@index([customerId, type])
}

model SalesOrder {
  id                               String              @id @default(cuid())
  orderNumber                      String              @unique
  customerId                       String?
  channel                          SalesChannel
  status                           SalesOrderStatus    @default(DRAFT)
  /// A bolt üzleti folyamatállapota. Kizárólag OrderBusinessStatusService
  /// módosíthatja, amely ugyanabban a tranzakcióban az eseménynaplót is írja.
  businessStatus                   OrderBusinessStatus @default(PENDING_FULFILLMENT)
  currency                         String              @default("HUF") @db.VarChar(3)
  totalNet                         Decimal             @default(0) @db.Decimal(19, 4)
  totalTax                         Decimal             @default(0) @db.Decimal(19, 4)
  totalGross                       Decimal             @default(0) @db.Decimal(19, 4)
  /// POS eladásnál a tételkedvezmények után, a teljes fizetendőre adott kedvezmény.
  discountPercent                  Decimal?            @db.Decimal(5, 2)
  /// Melyik raktárból ment/megy ki az áru (POS és UNAS webshop rendeléseknél is kitöltött).
  warehouseId                      String?
  /// A pénztárt kezelő felhasználó (POS eladásoknál).
  soldById                         String?
  /// A kiegyenlítés módja (jelenleg csak POS eladásoknál kötelező).
  paymentMethod                    PosPaymentMethod?
  /// A UNAS-oldali Invoice.Status (getOrder API) legutóbb szinkronizált,
  /// read-only tükrözése - lásd UnasInvoiceStatus doc-comment. Null = nem
  /// UNAS-eredetű rendelés, vagy még nem érkezett hozzá UNAS-szinkron. Az
  /// Acropora OS ezt sosem írja vissza a UNAS-ba, és nem is kezdeményez
  /// belőle számlázást - lásd docs/ACROPORA-OS-MASTER-MILESTONE-PLAN.md
  /// "Kimenő számlázás architektúrája".
  unasInvoiceStatus                UnasInvoiceStatus?
  /// Nem NULL, ha ezt a rendelést a UNAS-ban FIZIKAILAG törölték (nem
  /// sztornózták!) - lásd docs/INVENTORY-CONSISTENCY.md "UNAS-ból
  /// fizikailag törölt rendelések". Kizárólag egy konkrét, rendelés-
  /// azonosítóval végzett UNAS-lekérdezés igazolt NOT_FOUND eredménye
  /// állíthatja be (soha nem az inkrementális lista/időablak válaszából
  /// való puszta hiány - lásd unas-order-deletion.util.ts). Amikor ez
  /// kitöltött, a `status` mező is CANCELLED-re áll (ugyanaz a lezárt/
  /// inaktív jelleg, mint egy szabályos UNAS-sztornónál), DE ez a mező
  /// egyértelműen megkülönbözteti a kettőt: egy szabályos, UNAS-oldali
  /// sztornónál (status=CANCELLED, close_fault) ez a mező NULL marad. A
  /// rendelést magát SOHA nem töröljük fizikailag - lásd az auditnyom-
  /// megőrzés követelményét.
  unasDeletedAt                    DateTime?
  /// Mikor esedékes legközelebb egy UNAS létezés-ellenőrzés erre a
  /// rendelésre (a korlátozott, kötegelt automatikus reconciliation
  /// workerhez - lásd unas-order-deletion-reconciliation.service.ts). NULL
  /// = még sosem volt ütemezve (azonnal jogosult, amint a worker
  /// bekapcsolásra kerül); csak channel=UNAS és unasDeletedAt IS NULL és
  /// nem-terminális `status` esetén releváns.
  unasExistenceCheckDueAt          DateTime?
  /// PROCESSING-jellegű lease lejárati ideje egy claim-elt existence-check
  /// próbálkozáshoz - ugyanaz a minta, mint UnasStockSyncOutbox.leaseExpiresAt,
  /// hogy két párhuzamos worker sose dolgozza fel ugyanazt a rendelést.
  unasExistenceCheckLeaseExpiresAt DateTime?
  /// Diagnosztikai célú, nem funkcionális: melyik worker-példány foglalta le
  /// utoljára - lásd UnasStockSyncOutbox.claimedBy doc-comment.
  unasExistenceCheckClaimedBy      String?
  /// Az existence-check próbálkozások száma - a backoff kiszámításához
  /// (lásd computeNextAttemptDelayMs mintáját unas-stock-sync-outbox.service.ts-ben).
  unasExistenceCheckAttempts       Int                 @default(0)
  /// Webshop (UNAS) rendeléseknél a vásárló neve; nincs még Customer modul,
  /// ezért csak megjelenítésre tárolt sima szöveg, nem kapcsolt entitás.
  buyerName                        String?
  buyerEmail                       String?
  /// A UNAS Customer.Addresses.Invoice (számlázási cím) read-only
  /// tükrözése - ugyanaz a "nincs még Customer modul" indok, mint
  /// buyerName/buyerEmail esetén. Kizárólag megjelenítésre/riportálásra
  /// és a UNAS-eredetű Invoice-tükör (lásd Invoice.source=UNAS)
  /// partnerNévhez/adószámhoz szolgál - az Acropora OS ezekből nem épít
  /// számlakérést. adószám nélküli (magánszemély) vevőnél buyerTaxNumber
  /// null.
  buyerTaxNumber                   String?
  /// UNAS Customer.Addresses.Invoice.EUTaxNumber - közösségi adószám,
  /// megjelenítésre/riportálásra tükrözve.
  buyerEuTaxNumber                 String?
  /// UNAS Customer.Addresses.Invoice.CustomerType (private/company/
  /// other_customer_without_tax_number) tükrözése - megjelenítésre és a
  /// magánszemély/cég megkülönböztetésre.
  buyerCustomerType                String?
  buyerCountryCode                 String?
  buyerZip                         String?
  buyerCity                        String?
  buyerAddress                     String?
  orderedAt                        DateTime?
  confirmedAt                      DateTime?
  completedAt                      DateTime?
  createdAt                        DateTime            @default(now())
  updatedAt                        DateTime            @updatedAt

  customer               Customer?                  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  warehouse              Warehouse?                 @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  soldBy                 User?                      @relation(fields: [soldById], references: [id], onDelete: SetNull)
  lines                  SalesOrderLine[]
  invoices               Invoice[]
  foxpostSettlementLines FoxpostSettlementLine[]
  businessStatusEvents   OrderBusinessStatusEvent[]
  carrierShipments       CarrierShipment[]

  @@index([status, createdAt])
  @@index([businessStatus, createdAt])
  @@index([customerId, createdAt])
  @@index([channel, createdAt])
  @@index([unasInvoiceStatus])
  @@index([channel, unasDeletedAt, unasExistenceCheckDueAt])
}

/// A futártól kapott állapot szándékosan szabad szöveg: amíg nincs konkrét
/// fuvarozói szerződés/API, nem találunk ki szolgáltatófüggő enumot.
model CarrierShipment {
  id              String    @id @default(cuid())
  salesOrderId    String
  carrier         String
  /// A rendelés külső kulcsa (pl. UNAS Key), nem számlaszám. A Foxpost
  /// elszámolás is ezt használja a rendelés feloldására.
  orderReference  String
  parcelNumber    String?
  status          String
  statusChangedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId, createdAt])
  @@index([carrier, parcelNumber])
  @@index([orderReference])
}

/// Append-only nyom az üzleti rendelésállapot változásairól. A kezdeti,
/// migráció által létrehozott állapot is esemény, ezért ott fromStatus NULL.
model OrderBusinessStatusEvent {
  id          String                         @id @default(cuid())
  orderId     String
  fromStatus  OrderBusinessStatus?
  toStatus    OrderBusinessStatus
  source      OrderBusinessStatusEventSource
  actorUserId String?
  note        String?
  createdAt   DateTime                       @default(now())

  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User?      @relation("OrderBusinessStatusEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([actorUserId, createdAt])
}

model SalesOrderLine {
  id              String                   @id @default(cuid())
  orderId         String
  variantId       String?
  sku             String
  description     String
  quantity        Decimal                  @db.Decimal(19, 6)
  unit            String
  unitNet         Decimal                  @db.Decimal(19, 4)
  taxRate         Decimal                  @db.Decimal(5, 2)
  lineGross       Decimal                  @db.Decimal(19, 4)
  /// POS eladásnál a tétel eredeti bruttó egységárára adott kedvezmény.
  discountPercent Decimal?                 @db.Decimal(5, 2)
  /// UNAS setStock push kimenetele erre a tételre (POS eladásoknál).
  syncStatus      SalesOrderLineSyncStatus @default(PENDING)
  syncError       String?
  /// Nem NULL, ha ez a korábban tükrözött rendeléstétel egy későbbi UNAS
  /// rendeléslekérésből eltűnt. A sort auditnyomként megtartjuk, de többé
  /// nem tekintjük az aktuális rendelés aktív részének, és nem számít bele
  /// az aktív tételszámba. Egy újra megjelenő azonos SKU új aktív sort kap,
  /// így a korábbi eltávolítás története nem íródik felül.
  unasRemovedAt   DateTime?

  order   SalesOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([orderId, unasRemovedAt])
  @@index([variantId])
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  orderNumber String              @unique
  supplierId  String
  warehouseId String
  status      PurchaseOrderStatus @default(DRAFT)
  currency    String              @default("HUF") @db.VarChar(3)
  expectedAt  DateTime?
  approvedAt  DateTime?
  sentAt      DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  lines     PurchaseOrderLine[]
  receipts  GoodsReceipt[]

  @@index([supplierId, status])
  @@index([warehouseId, expectedAt])
}

model PurchaseOrderLine {
  id               String    @id @default(cuid())
  purchaseOrderId  String
  variantId        String
  supplierSku      String?
  description      String
  orderedQuantity  Decimal   @db.Decimal(19, 6)
  receivedQuantity Decimal   @default(0) @db.Decimal(19, 6)
  unit             String
  unitNet          Decimal   @db.Decimal(19, 4)
  taxRate          Decimal?  @db.Decimal(5, 2)
  expectedAt       DateTime?

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant     @relation(fields: [variantId], references: [id])
  receiptLines  GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@index([variantId])
}

model GoodsReceipt {
  id              String             @id @default(cuid())
  receiptNumber   String             @unique
  purchaseOrderId String
  warehouseId     String
  status          GoodsReceiptStatus @default(DRAFT)
  receivedAt      DateTime
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id])
  lines         GoodsReceiptLine[]

  @@index([purchaseOrderId, receivedAt])
}

model GoodsReceiptLine {
  id                  String   @id @default(cuid())
  goodsReceiptId      String
  purchaseOrderLineId String
  variantId           String
  receivedQuantity    Decimal  @db.Decimal(19, 6)
  acceptedQuantity    Decimal  @db.Decimal(19, 6)
  rejectedQuantity    Decimal  @default(0) @db.Decimal(19, 6)
  unitNet             Decimal? @db.Decimal(19, 4)

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  variant           ProductVariant    @relation(fields: [variantId], references: [id])

  @@unique([goodsReceiptId, purchaseOrderLineId])
}

/// Beérkezett beszállítói számla rögzítése: nálunk ez maga a beszerzés
/// bevételezési eseménye, nincs külön előzetes rendelés-jóváhagyási lépés
/// (lásd docs/DOMAIN-MODEL.md-től eltérő, tényleges üzleti folyamat). A
/// PurchaseOrder/GoodsReceipt pár változatlanul megmarad, de ez a modell nem
/// épül rájuk.
model PurchaseInvoice {
  id                    String                @id @default(cuid())
  /// Belső, generált bizonylatszám (pl. "BESZ-...").
  documentNumber        String                @unique
  /// A beszállítói számlán szereplő tényleges számlaszám.
  supplierInvoiceNumber String
  source                PurchaseInvoiceSource
  status                PurchaseInvoiceStatus @default(POSTED)
  supplierId            String
  warehouseId           String
  /// ISO 4217 pénznemkód; belföldi/HUF esetén nincs átváltás.
  currency              String                @default("HUF") @db.VarChar(3)
  /// MNB hivatalos árfolyam a számla keltének napján, HUF/deviza egységre; HUF számlánál null.
  exchangeRate          Decimal?              @db.Decimal(19, 6)
  invoiceDate           DateTime
  dueDate               DateTime?
  isPaid                Boolean               @default(false)
  paidAt                DateTime?
  /// Belföldi kézi rögzítésnél használt ÁFA-kulcs (alapértelmezetten 27); EU-s számlánál jellemzően null.
  vatRate               Decimal?              @db.Decimal(5, 2)
  note                  String?
  createdById           String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  supplier           Supplier              @relation(fields: [supplierId], references: [id])
  warehouse          Warehouse             @relation(fields: [warehouseId], references: [id])
  createdBy          User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines              PurchaseInvoiceLine[]
  /// Ha a számla egy NAV-ból lekérdezett belföldi bejövő számla
  /// bevételezéseként jött létre - a fordított irányú, opcionális kapcsolat
  /// a NavIncomingInvoice oldalán él (purchaseInvoiceId).
  navIncomingInvoice NavIncomingInvoice?

  @@unique([supplierId, supplierInvoiceNumber])
  @@index([status, invoiceDate])
  @@index([warehouseId])
}

model PurchaseInvoiceLine {
  id                String   @id @default(cuid())
  purchaseInvoiceId String
  /// Opcionális: ha a számla tétele nincs a terméktörzsben (pl. egyszeri
  /// tétel, vagy a termék felvétele még nem történt meg), a sor variant
  /// nélkül is rögzíthető - ilyenkor nincs helyi készlethatás és UNAS
  /// szinkron sem (lásd syncStatus "NOT_LINKED").
  variantId         String?
  /// A számlán szereplő eredeti (nem a saját) megnevezés; variant nélküli
  /// sornál ez az egyetlen megnevezés, ezért ilyenkor kötelező.
  sourceDescription String?
  orderedQuantity   Decimal  @db.Decimal(19, 6)
  actualQuantity    Decimal  @db.Decimal(19, 6)
  unit              String
  /// Egységár a számla pénznemében, kedvezmény levonása előtt.
  unitNet           Decimal  @db.Decimal(19, 4)
  discountPercent   Decimal? @db.Decimal(5, 2)
  /// A tétel UNAS készlet-push eredménye (OK / FAILED / PENDING / NOT_LINKED
  /// - utóbbi: nincs terméktörzsbeli variant, nincs mit szinkronizálni).
  syncStatus        String   @default("PENDING")
  syncError         String?

  purchaseInvoice     PurchaseInvoice               @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  variant             ProductVariant?               @relation(fields: [variantId], references: [id])
  projectReservations ProjectInventoryReservation[]

  @@index([purchaseInvoiceId])
  @@index([variantId])
}

/// Egyedi kivitelezési, dekorációs vagy intézményi projekt minimális
/// törzsadata. A részletes M15 projektworkflow később bővíti ezt a modellt;
/// a beszerzési projektkészlethez már most stabil belső hivatkozás kell.
model Project {
  id            String        @id @default(cuid())
  projectNumber String        @unique
  name          String
  status        ProjectStatus @default(ACTIVE)
  customerId    String?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer     Customer?                     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy    User?                         @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reservations ProjectInventoryReservation[]

  @@index([status, name])
  @@index([customerId])
  @@index([createdById])
}

/// Egy bevételezett számlasor projektnek félretett mennyisége. A rekord az
/// üzleti tény; StockItem.reserved ennek gyors, tranzakcióban karbantartott
/// projectionje. ACTIVE állapotban a mennyiség fizikailag on hand, de nem
/// eladható és az UNAS felé sem szabad készlet.
model ProjectInventoryReservation {
  id                    String                            @id @default(cuid())
  projectId             String
  purchaseInvoiceLineId String
  stockItemId           String
  variantId             String
  warehouseId           String
  quantity              Decimal                           @db.Decimal(19, 6)
  status                ProjectInventoryReservationStatus @default(ACTIVE)
  createdById           String?
  releasedAt            DateTime?
  consumedAt            DateTime?
  createdAt             DateTime                          @default(now())
  updatedAt             DateTime                          @updatedAt

  project             Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  purchaseInvoiceLine PurchaseInvoiceLine @relation(fields: [purchaseInvoiceLineId], references: [id], onDelete: Restrict)
  stockItem           StockItem           @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  variant             ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse           Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy           User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([purchaseInvoiceLineId, projectId])
  @@index([projectId, status])
  @@index([stockItemId, status])
  @@index([variantId, warehouseId, status])
}

/// A NAV Online Számla queryInvoiceDigest szinkronból lekerülő belföldi
/// bejövő (INBOUND irányú) számla lokális tükre. A digest-lekérdezés csak
/// egy kivonatot ad (lásd NEW állapot); a teljes tétellista csak a
/// queryInvoiceData lusta (részletnézetkori) hívásakor kerül le és
/// parszolódik a parsedData mezőbe (lásd nav-invoice-data.parser.ts) -
/// nincs értelme minden digest-sorhoz azonnal lekérni a teljes adatot,
/// hiszen a legtöbb sosem kerül ténylegesen bevételezésre.
model NavIncomingInvoice {
  id                  String                   @id @default(cuid())
  navInvoiceNumber    String
  supplierTaxNumber   String
  supplierName        String
  invoiceIssueDate    DateTime
  invoiceDeliveryDate DateTime?
  paymentDate         DateTime?
  currency            String                   @default("HUF") @db.VarChar(3)
  invoiceNetAmount    Decimal?                 @db.Decimal(19, 2)
  invoiceVatAmount    Decimal?                 @db.Decimal(19, 2)
  /// A NAV-oldali regisztrálás időpontja - ez a szinkron kurzor alapja
  /// (lásd IntegrationCursor provider="NAV" stream="INBOUND_INVOICES"),
  /// nem az invoiceIssueDate (ami a kiállító által megadott, nem a NAV
  /// szerver órája szerinti időpont).
  insDate             DateTime
  status              NavIncomingInvoiceStatus @default(NEW)
  /// A queryInvoiceData válaszból felparszolt, bevételezéshez szükséges
  /// pillanatkép (beszállító adatok, cím, tételek) - lásd
  /// ParsedNavInvoiceData (nav-invoice-data.parser.ts). Csak DATA_FETCHED
  /// vagy RECEIVED állapotban nem null.
  parsedData          Json?
  errorCode           String?
  purchaseInvoiceId   String?                  @unique
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)

  @@unique([navInvoiceNumber, supplierTaxNumber])
  @@index([status, insDate])
}

/// Egy NAV bejövő-számla digest-szinkron futás: az insDate kurzoron alapuló,
/// a UnasCustomerSyncRun mintáját követő ablakos lekérdezés (nincs
/// FULL/INCREMENTAL megkülönböztetés, minden futás a kurzor óta regisztrált
/// ablakot dolgozza fel).
model NavInvoiceSyncRun {
  id           String                  @id @default(cuid())
  activeKey    String?                 @unique
  status       NavInvoiceSyncRunStatus @default(PENDING)
  windowStart  DateTime?
  windowEnd    DateTime
  startedAt    DateTime?
  completedAt  DateTime?
  invoicesSeen Int                     @default(0)
  createdCount Int                     @default(0)
  /// A digest-ben szereplő, de v1-ben szándékosan figyelmen kívül hagyott
  /// MODIFY/STORNO műveletű tételek száma (lásd docs/CURRENT_STATUS.md).
  skippedCount Int                     @default(0)
  errorCode    String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([status, createdAt])
}

/// A teljes bejövő+kimenő számlanyilvántartás (M8.4, ADR-005) - forrástól
/// független modell, hogy a jövőben ide kerülhessen: a Számlázz.hu
/// Online Pénzügyi Adatkapcsolatból érkező bejövő bizonylat (elsődleges
/// forrás, még nem implementálva), a NAV napi egyeztetés (másodlagos,
/// ellenőrző forrás, még nem implementálva), a webshop (UNAS) rendelésekhez
/// tartozó, UNAS getOrder API-ból read-only tükrözött kimenő számla
/// (source=UNAS - lásd Invoice.source doc-comment; ezt a UNAS beépített
/// Számlázz.hu modulja állítja ki, NEM az Acropora OS), és később az
/// Acropora OS saját kezdeményezésű, nem webshopos számlázása (pl.
/// munkalap/POS/kézi számla, még nem implementálva). NEM azonos a
/// PurchaseInvoice-zal, ami a fizikai bevételezési/készlet-workflow
/// bizonylata. Egy adott üzleti eseménynek (pl. egy beszállítói számla
/// beérkezése) elvben mindkét oldalon lehet nyoma: a PurchaseInvoice a
/// raktári bevételezést, az Invoice a pénzügyi nyilvántartást rögzíti. Az
/// összekapcsolásuk (pl. közös supplierInvoiceNumber alapján) még nem
/// implementált - lásd a docs/DECISIONS.md ADR-005 nyitott kérdését erről.
model Invoice {
  id                   String              @id @default(cuid())
  direction            InvoiceDirection
  documentType         InvoiceDocumentType @default(INVOICE)
  source               InvoiceSource
  /// A Számlázz.hu belső <alap><id> azonosítója - ez az idempotens upsert
  /// kulcsa a bejövő/kimenő push fogadásakor (M8.3). NAV/MANUAL/IMPORT
  /// forrásnál jellemzően null.
  szamlazzInvoiceId    String?
  /// A ténylegesen kiállított/kapott számla saját, emberi olvasható száma.
  invoiceNumber        String
  partnerName          String
  partnerTaxNumber     String?
  customerId           String?
  supplierId           String?
  /// A kapcsolódó webshop (UNAS) rendelés, ha van - elsősorban a
  /// source=UNAS read-only számlatükörnél töltött (lásd Invoice.source
  /// doc-comment). Szándékosan nem unique - egy rendeléshez később
  /// jóváíró/sztornó számla is tartozhat; a duplikálás elleni védelem a
  /// @@unique([source, invoiceNumber]) megkötés, nem ez a mező.
  salesOrderId         String?
  /// A UNAS getOrder API nem ad számla-kiállítási dátumot (az Invoice
  /// alobjektum csak Status/StatusText/Number/Url mezőt dokumentál - lásd
  /// unas.hu/tudastar/api/megrendelesek-adatszerkezet), ezért source=UNAS
  /// soroknál ez null: nem találgatjuk a szinkron időpontjából.
  issueDate            DateTime?
  fulfillmentDate      DateTime?
  dueDate              DateTime?
  /// ISO 4217 pénznemkód.
  currency             String              @default("HUF") @db.VarChar(3)
  exchangeRate         Decimal?            @db.Decimal(19, 6)
  /// A UNAS getOrder API nem ad összeget a rendelés Invoice alobjektumában
  /// (csak Status/Number/Url) - source=UNAS soroknál ez a három összeg-mező
  /// null, NEM 0, amíg egy valódi számlaösszeg-forrás (pl. Számlázz.hu
  /// Online Pénzügyi Adatkapcsolat) nincs bekötve.
  netAmount            Decimal?            @db.Decimal(19, 4)
  vatAmount            Decimal?            @db.Decimal(19, 4)
  grossAmount          Decimal?            @db.Decimal(19, 4)
  isPaid               Boolean             @default(false)
  paidAt               DateTime?
  /// Sztornó/helyesbítő bizonylatnál az eredeti számlára mutat.
  referencedInvoiceId  String?
  syncStatus           InvoiceSyncStatus   @default(PENDING)
  syncError            String?
  /// Nyers XML megőrzése objektumtár-kulcsként, nem DB-blobként (7.5).
  rawPayloadStorageKey String?
  pdfStorageKey        String?
  /// Egy külső rendszer (pl. UNAS Invoice.Url, ami valójában a Számlázz.hu
  /// által hosztolt PDF linkje) által adott, közvetlenül elérhető
  /// számla-URL - NEM object-storage kulcs (lásd pdfStorageKey fent), csak
  /// akkor töltött, ha a forrás API ténylegesen adott ilyet; üres/hiányzó
  /// válasz esetén marad null, sosem generált/kitalált érték.
  externalUrl          String?
  bookkeepingStatus    String?
  tags                 String[]
  note                 String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  customer               Customer?               @relation(fields: [customerId], references: [id])
  supplier               Supplier?               @relation(fields: [supplierId], references: [id])
  salesOrder             SalesOrder?             @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  referencedInvoice      Invoice?                @relation("InvoiceCorrectionChain", fields: [referencedInvoiceId], references: [id])
  correctionInvoices     Invoice[]               @relation("InvoiceCorrectionChain")
  lines                  InvoiceLine[]
  foxpostSettlementLines FoxpostSettlementLine[]

  @@unique([source, szamlazzInvoiceId])
  /// Idempotencia-kulcs a UNAS read-only számlatükör upsertjéhez (és
  /// általában: egy adott forrás sosem adhatja ki kétszer ugyanazt a
  /// számlaszámot) - lásd unas-order-sync.repository.ts syncInvoiceMirror.
  @@unique([source, invoiceNumber])
  @@index([direction, issueDate])
  @@index([partnerTaxNumber])
  @@index([syncStatus])
  @@index([salesOrderId])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  description    String
  quantity       Decimal @db.Decimal(19, 6)
  unit           String?
  unitNet        Decimal @db.Decimal(19, 4)
  vatRatePercent Decimal @db.Decimal(5, 2)
  netAmount      Decimal @db.Decimal(19, 4)
  vatAmount      Decimal @db.Decimal(19, 4)
  grossAmount    Decimal @db.Decimal(19, 4)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model ServiceJob {
  id                String           @id @default(cuid())
  jobNumber         String           @unique
  /// A HELYSZÍNI BEJELENTÉS IDEMPOTENCIA-KULCSA -- UGYANAZ A MINTA, MINT AZ
  /// `Asset.clientOperationId` ÉS A `Worksheet.clientOperationId` MEZŐNÉL.
  ///
  /// A telefon térerő nélkül sorba teszi a jegyet, és a sor a hálózati hibát
  /// SZÁNDÉKOSAN újrapróbálja -- offline az a normális állapot. Épp ott lehet
  /// viszont, hogy a létrehozás MÁR lefutott, és csak a válasz veszett el.
  /// Kulcs nélkül az újraküldés MÁSODIK jegyet nyitna ugyanarról a hibáról, és
  /// a szerelő a listán kétszer látná ugyanazt.
  ///
  /// EGYEDI: ez maga a védelem. A létrehozás előtt a kulcsra keresünk, és
  /// találat esetén a MEGLÉVŐ jegyet adjuk vissza; az egyediség pedig azt is
  /// elvágja, amit két párhuzamos kérés csúsztatna át a keresés és a beszúrás
  /// között.
  ///
  /// A NULL nem egyenlő önmagával, tehát a kulcs nélküli sorok (minden mai sor
  /// és minden webes felvitel) korlátlanul állhatnak egymás mellett.
  clientOperationId String?          @unique
  customerId        String?
  /// HOL VAN A BAJ: a partner helyszine, ugyanabbol a fabol, amit a munkalap es
  /// az eszkoz hasznal (`WorksheetDepartment`).
  ///
  /// Balazs kerese, 2026-09-14: a hibajegy felvitelen a partner utan rogton a
  /// helyszin jojjon. Eddig a jegy CSAK a partnert tudta, a helyszin pedig
  /// eloszor a munkalapon jelent meg -- vagyis a lancban a legelso lepes volt a
  /// legkevesbe pontos, es a bejelentes utan mar senki nem tudta megmondani,
  /// melyik egysegrol szolt.
  ///
  /// `String?` ES NEM KOTELEZO, ket okbol. Az egyik a meglevo sorok: a
  /// migracio pillanataban egyetlen jegynek sincs helyszine, es egy kotelezo
  /// mezo vagy hazudna, vagy elbukna. A masik a mai viselkedes: partner NELKUL
  /// is lehet jegyet nyitni, es helyszine csak partnernek van.
  ///
  /// A KAPCSOLAT `Restrict`, nem `SetNull`: egy helyszin, amire nyitott jegy
  /// mutat, nem torolheto ki alola. A fa amugy is archivalassal vezet ki
  /// (`isActive`), nem torlessel -- a `Restrict` ezt teszi kimondotta.
  departmentId      String?
  aquariumId        String?
  status            ServiceJobStatus @default(NEW)
  title             String
  description       String?
  assignedUserId    String?
  /// KI NYITOTTA A JEGYET. Állítás a jegyen, nem következtetés a naplóból.
  ///
  /// A napló első sorából (`toStatus: NEW`) ez eddig is kiolvasható volt, és a
  /// láthatóság egy ideig onnan is dolgozott. HÁROM DOLOG MIATT KAPOTT SAJÁT
  /// MEZŐT, és mind a három NÉMÁN rontott volna:
  ///
  /// 1. A napló aktora `SetNull` a felhasználó törlésekor -- helyesen, mert a
  ///    napló nem hazudhat arról, ki lépett. De a láthatóság nem napló-kérdés:
  ///    egy törölt kolléga vevő NÉLKÜLI jegye így SENKINEK nem látszott volna,
  ///    hibaüzenet nélkül.
  /// 2. A `ServiceJobEvent` egyetlen indexe `[serviceJobId, createdAt]`, tehát a
  ///    szűrés indexeletlen oszlopra ment volna. (Három rokon tábla --
  ///    `AuditLog` a `userId`-n, `AssetEvent` és `StockReconciliationRepair` az
  ///    `actorUserId`-n -- már ma indexeli ezt az oszlopot; a `DomainEvent`
  ///    szándékosan nem.)
  /// 3. A napló aktora azt mondja meg, KI ÍRTA BE az első sort, nem azt, KIÉ a
  ///    jegy. Ma a kettő egybeesik, mert egyetlen úton keletkezik jegy. Egy
  ///    második út (import, portál, ágens) esetén szétválnának, és a láthatóság
  ///    CSENDBEN mozdulna el.
  ///
  /// `String?` ÉS NEM KÖTELEZŐ, szándékosan: a meglévő sorokat a migráció a
  /// keletkezés eseményéből tölti, és ott az aktor MÁR lehet `null` (egy azóta
  /// törölt kolléga). Egy kötelező mező itt vagy hazudna, vagy elbukna a
  /// migráción.
  ///
  /// AMIT NEM OLD MEG: a már törölt felhasználók jegyeit nem hozza vissza. Az
  /// egyszeri, megnevezhető veszteség; ez a mező a JÖVŐBELI törlésektől véd.
  ///
  /// ÉS NINCS RAJTA IDEGENKULCS, ugyanúgy, ahogy az `assignedUserId`-n sincs.
  /// Itt ez nem másolás, hanem a mező LÉTEZÉSÉNEK oka: egy `SetNull` idegenkulcs
  /// pontosan azt a veszteséget hozná vissza, ami elől a mező kitér -- a törölt
  /// kolléga jegye újra elveszítené a nyitóját. Az azonosító így megmarad akkor
  /// is, ha a felhasználó sora eltűnik.
  openedById        String?
  /// TERV, NEM ESEMÉNY: valaki BEÁLLÍTJA, jövőbeli időpontra. A naplóból soha
  /// nem vezethető le, mert nem történt meg semmi. MA MÉG SENKI NEM ÍRJA:
  /// ütemezési felület nincs, tehát minden jegyen `null`.
  scheduledAt       DateTime?
  /// MA EGYIKET SEM ÍRJA SENKI, ÉS EZ SZÁNDÉKOS - a jegy időpontjainak
  /// FORRÁSA a `ServiceJobEvent` napló: abból derül ki, mikor lépett a jegy
  /// `IN_PROGRESS`-be és mikor `COMPLETED`-be. Ez a két mező ma minden jegyen
  /// `null`, és egy létező, de mindig üres mező pontosan úgy néz ki, mint egy
  /// adat, amit még nem töltöttek ki - ezért áll itt ez a megjegyzés.
  ///
  /// MI HOZNÁ VISSZA A MEZŐS IRÁNYT: egy INDEXELT lekérdezés (például „mely
  /// jegyek fejeződtek be ebben a hónapban", a számlázáshoz), amit naplóból
  /// visszafejteni minden lekérdezésnél túl drága. Ma erre nincs mérésünk, és
  /// egy feltevésért nem érdemes második írót csinálni egy tényre.
  ///
  /// HA MÉGIS: a lépés írja őket, a naplósorral EGY tranzakcióban és ugyanabból
  /// az időbélyegből, és a napló marad az igazság - eltérés esetén a napló nyer,
  /// az eltérés pedig HIBA, nem két egyenrangú igazság.
  startedAt         DateTime?
  completedAt       DateTime?
  /**
   * A REJTES: A JEGY KIKERUL A LISTAKBOL, DE MEGMARAD.
   * Ugyanaz a fogalom es ugyanaz a par, mint a `Worksheet.hiddenAt` mezonel --
   * a magyarazat ott all teljes egeszeben. Ket dolog viszont ITT dol el, es
   * ezert all itt is szoveg:
   * 1. A JEGY REJTESE NEM VISZI MAGAVAL A LAPJAIT. Egy jegy alatt allhat VALODI
   * munkalap, es a lanc (jegy -> lap -> teljesitesi igazolas -> szamla) ep
   * marad. A rejtes PER SOR megy, mind a ket modellen kulon.
   * 2. NINCS RAJTA IDEGENKULCS, ugyanugy, ahogy az `openedById` es az
   * `assignedUserId` mezon sincs. Ez NEM masolas: ezen a modellen EGYETLEN
   * `User` kapcsolat sincs, es az `openedById` fejlece kimondja, miert. Az
   * azonosito igy akkor is megmarad, ha a felhasznalo sora eltunik.
   * A MASIK MODELLEN VISZONT VAN KAPCSOLAT, es az elteres szandekos: ott a
   * kozvetlen szomszed (`handedOverById`) is kapcsolattal all, tehat mind a
   * ket modellen a SAJAT kornyezetet kovettem. Egy egyseges alak az egyik
   * helyen idegen test lett volna.
   */
  hiddenAt          DateTime?
  hiddenById        String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  customer   Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  department WorksheetDepartment? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  aquarium   Aquarium?            @relation(fields: [aquariumId], references: [id], onDelete: SetNull)
  assets     ServiceJobAsset[]
  /// Ami a jeggyel történt, időrendben. A részletlap ebből építi a naplót.
  events     ServiceJobEvent[]
  /// A hibajegy mögött álló munkalapok. Több is lehet, és van, amelyik
  /// hamarabb keletkezett, mint maga a hibajegy.
  worksheets Worksheet[]
  /// A jegyre delegált szervizes kollégák.
  assignees  ServiceJobAssignee[]
  /// A jegyhez csatolt fénykép és egyéb fájl.
  documents  ServiceJobDocument[]

  /// A NYITO SZERINTI SZURES INDEXELT. A lathatosag minden partner-oldali
  /// lekerdezesnel ezen az oszlopon szur, tehat ez nem "hatha" index.
  @@index([openedById])
  @@index([status, scheduledAt])
  @@index([customerId])
  /// A HELYSZIN SZERINTI SZURES INDEXELT. Ugyanaz az ok, mint a `customerId`
  /// eseteben: a partner-oldali lista a sajat egysegeire szur, es a `Restrict`
  /// torles-ellenorzes is ezt az oszlopot olvassa.
  @@index([departmentId])
  /// MINDEN LISTA EZEN SZUR, ALAPBOL -- ugyanaz az ok, mint a munkalapnal.
  @@index([hiddenAt])
}

/// KI DOLGOZIK A HIBAJEGYEN. Kapcsolótábla, nem oszlop a jegyen.
///
/// Balázs kérése (2026-09-14 18:10, Discord, Szerviz ticketing szál, szó
/// szerint): „Majd ez alatt a szervizes kollegakat lehessen delegalni akik
/// errol ertesitest kapnak es meg tudjak nyitni a munkalapot." Több kolléga,
/// tehát a páros a tábla, nem egy azonosító a jegyen.
///
/// A `WorksheetAssignee` MINTÁJÁRA, mezőre és kulcsra egyezően, és ez nem
/// másolás kényelemből: a hibajegy és a munkalap ugyanannak a munkának a két
/// oldala, és aki az egyik láncot ismeri, a másikat is olvasni fogja. Egy
/// harmadik alak ugyanarra a fogalomra pontosan azt a zavart szülné, amit a
/// séma máshol (`departmentId`) már egyszer megnevezett.
///
/// === A JEGYEN ÁLLÓ `assignedUserId` VÁLTOZATLAN MARAD, ÉS EZ MÉRÉS ===
///
/// A mező 2026-09-14-én a teljes TypeScript fában NULLA helyen szerepel: se
/// író, se olvasó (`grep` az `apps` és `packages` fákon, `dist` és `.d.ts`
/// nélkül; pozitív kontroll ugyanazzal a kereséssel: `openedById` 15 találat).
/// Vagyis nem két írót kapunk egy tényre -- a régi oszlop ma nem ír semmit.
///
/// Azért MARAD, mert az eldobása külön döntés és külön migráció: adatot venne
/// el visszafordíthatatlanul, és a mérésem a KÓDRÓL szól, nem az adatbázis
/// tartalmáról. Amíg ez a megjegyzés itt áll, a következő olvasó nem hiszi
/// azt, hogy a két hely két egyenrangú igazság.
model ServiceJobAssignee {
  serviceJobId String
  userId       String
  assignedAt   DateTime @default(now())
  assignedById String?

  serviceJob ServiceJob @relation(fields: [serviceJobId], references: [id], onDelete: Cascade)
  user       User       @relation("ServiceJobAssignee", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?      @relation("ServiceJobAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  /// A páros maga az azonosság, ezért nincs külön `id`: egy pótkulcs mellett
  /// ugyanaz az ember kétszer is felkerülhetne ugyanarra a jegyre.
  @@id([serviceJobId, userId])
  /// A szervizes saját jegyeinek listája ezen az indexen fut.
  @@index([userId, assignedAt])
}

/// Akvárium VAGY tó -- Balázs kérése (2026-09-24), hogy a tó ne külön tábla
/// legyen, csak egy megkülönböztető mező: a két dolog ugyanazokat az
/// adatokat hordozza (méret, eszközök), és egy közös lista/kereső mindkettőt
/// ugyanúgy kell hogy kezelje.
enum WaterBodyType {
  AKVARIUM
  TO
}

/// Opcionális, Balázs kifejezett engedélyével bővítve (2026-09-24): a
/// felület "tengeri"/"édesvízi" választót ad, de a mező kitöltése nem
/// kötelező -- a régi (ma élesben 0 soros) rekordoknak sincs erről adata.
enum WaterType {
  EDESVIZI
  TENGERI
}

/// Az akváriumon lévő berendezés FAJTÁJA. Balázs listája (2026-09-24):
/// világítás, áramoltatás, lehabzó, felnyomó, biológiai szűrés,
/// médiareaktor, nyomelem-adagoló, fűtés, hűtés -- plusz egy `EGYEB` kapu,
/// mert egy zárt lista előbb-utóbb kihagy valamit.
enum AquariumEquipmentKind {
  VILAGITAS
  ARAMOLTATAS
  LEHABZO
  FELNYOMO
  BIO_SZURES
  MEDIA_REAKTOR
  NYOMELEM_ADAGOLO
  FUTES
  HUTES
  EGYEB
}

model Aquarium {
  id                   String                @id @default(cuid())
  aquariumNumber       String                @unique
  /// A HELYSZÍNI FELVITEL IDEMPOTENCIA-KULCSA -- UGYANAZ A MINTA, MINT AZ
  /// `Asset.clientOperationId`, A `Worksheet.clientOperationId` ÉS A
  /// `ServiceJob.clientOperationId` MEZŐNÉL.
  ///
  /// A telefon térerő nélkül sorba teszi az akváriumot, és a sor a hálózati
  /// hibát SZÁNDÉKOSAN újrapróbálja -- offline az a normális állapot. Épp ott
  /// lehet viszont, hogy a létrehozás MÁR lefutott, és csak a válasz veszett
  /// el. Kulcs nélkül az újraküldés MÁSODIK akváriumot hozna létre, és -- mert
  /// a `newCustomer` is ugyanebben a hívásban megy -- egy MÁSODIK ügyfelet is.
  ///
  /// EGYEDI: ez maga a védelem. A létrehozás előtt a kulcsra keresünk, és
  /// találat esetén a MEGLÉVŐ akváriumot adjuk vissza; az egyediség pedig azt
  /// is elvágja, amit két párhuzamos kérés csúsztatna át a keresés és a
  /// beszúrás között.
  ///
  /// A NULL nem egyenlő önmagával, tehát a kulcs nélküli sorok (minden mai
  /// sor és minden webes felvitel) korlátlanul állhatnak egymás mellett.
  clientOperationId    String?               @unique
  customerId           String?
  name                 String
  ownershipType        AquariumOwnershipType
  /// Akvárium vagy tó -- lásd a `WaterBodyType` fejlécét. Alapértelmezés
  /// `AKVARIUM`, mert a mai (kizárólag akvárium-) sorok ide tartoznak.
  waterBodyType        WaterBodyType         @default(AKVARIUM)
  lengthCm             Decimal?              @db.Decimal(10, 2)
  widthCm              Decimal?              @db.Decimal(10, 2)
  heightCm             Decimal?              @db.Decimal(10, 2)
  systemVolumeLiters   Decimal?              @db.Decimal(12, 3)
  /// `true`, HA A FELHASZNÁLÓ ÍRTA ÁT A SZÁMOLT LITERT.
  ///
  /// Balázs kérése (2026-09-24): a liter a három méretből SZÁMOLÓDIK, de
  /// kézzel is beírható. A jelző nélkül egy KÉSŐBBI méretmódosítás csendben
  /// felülírná a kézzel beírt, valós (pl. belső falvastagság miatt kisebb)
  /// literértéket -- ez a mező dönti el, hogy a `systemVolumeLiters`
  /// ÚJRASZÁMOLHATÓ-e a méretekből, vagy a felhasználó szava a végső.
  systemVolumeIsManual Boolean               @default(false)
  /// Opcionális, Balázs kifejezett engedélyével (2026-09-24). Lásd a
  /// `WaterType` fejlécét.
  waterType            WaterType?
  /// Az akvárium/tó indításának dátuma. Opcionális, Balázs kifejezett
  /// engedélyével (2026-09-24).
  startedAt            DateTime?
  /// Szabad szöveges megjegyzés. Opcionális, Balázs kifejezett engedélyével
  /// (2026-09-24).
  notes                String?
  maintainedByUs       Boolean               @default(false)
  responsibleUserId    String?
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  customer     Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  measurements AquariumMeasurement[]
  serviceJobs  ServiceJob[]
  assets       Asset[]
  /// A FELSZERELT BERENDEZÉSEK, SAJÁT TÁBLÁBAN -- NEM az `Asset` (eszköz-
  /// nyilvántartás). Lásd az `AquariumEquipment` fejlécét, miért két
  /// különböző fogalom.
  equipment    AquariumEquipment[]

  @@index([customerId, isActive])
}

/// AZ AKVÁRIUMON LÉVŐ BERENDEZÉS -- ÉS SZÁNDÉKOSAN NEM AZ `Asset` TÁBLA.
///
/// Balázs kérése (2026-09-24): "Eszközök rész: világítás, áramoltatás,
/// lehabzó, felnyomó, biológiai szűrés, média reaktor, nyomelem adagoló
/// típusa csatorna száma, fűtés, hűtés." Ez egy MÁSIK fogalom, mint az
/// `Asset`: az `Asset` a szervizelt berendezések nyilvántartása (partner
/// belső kódja, QR-matrica, kötelező helyszín) -- egy ügyfél otthoni
/// akváriumának lámpája nem az, amíg szervizbe nem kerül. Ha egyszer
/// szervizbe kerül, az `Asset.aquariumId` már ma is köti a kettőt.
model AquariumEquipment {
  id           String                @id @default(cuid())
  aquariumId   String
  kind         AquariumEquipmentKind
  manufacturer String?
  /// A "típus", Balázs szavával -- pl. a nyomelem-adagoló gyártói modellje.
  model        String?
  /// Egy akváriumhoz fajtánként több sor is felvehető (pl. két áramoltató),
  /// ezért ez darabszám, nem jelző. Alapértelmezés 1.
  quantity     Int                   @default(1)
  /// CSAK a nyomelem-adagolónál kötelező (Balázs kérése), minden más
  /// fajtánál értelmetlen -- az API-rétegben ellenőrzött, nem itt: egy
  /// feltételes CHECK ugyanezt a `kind`-ág szerinti szabályt duplikálná.
  channelCount Int?
  notes        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  aquarium Aquarium @relation(fields: [aquariumId], references: [id], onDelete: Cascade)

  @@index([aquariumId])
}

/// A partnernél üzemelő, fizikailag azonosítható rendszer, berendezés vagy
/// alkatrész. A `parentAssetId` önhivatkozó fa teszi lehetővé az összetett
/// rendszereket (pl. szűrőrendszer -> felnyomó szivattyú). A
/// customerId/supplierId közül pontosan az egyik van kitöltve (adatbázis
/// CHECK constraint): az eszköz tulajdonosa lehet vevő vagy a Partnerek
/// törzsében nyilvántartott beszállító. A cím és az akvárium csak vevőnél
/// használható, finomabb elhelyezésként.
model Asset {
  id                  String           @id @default(cuid())
  assetNumber         String           @unique
  /// A KLIENS ÁLTAL ADOTT MŰVELET-AZONOSÍTÓ, A HELYSZÍNI RÖGZÍTÉS
  /// IDEMPOTENCIA-KULCSA.
  ///
  /// A telefon térerő nélkül SORBA teszi a felvitelt, és a sor a hálózati hibát
  /// SZÁNDÉKOSAN újrapróbálhatónak veszi -- offline épp az a normális állapot.
  /// Csakhogy pontosan ott lehet, hogy a szerver MÁR létrehozta a rekordot, és
  /// csak a válasz veszett el: kulcs nélkül az újraküldés MÁSODIK rekordot
  /// hozna létre, a szerelő pedig azt látná, hogy mindent kétszer rögzített.
  /// Nem hibaüzenet, hanem két sor, amiről valakinek el kell döntenie, melyik
  /// az igazi.
  ///
  /// ELHAGYHATÓ, ÉS EZ NEM LAZASÁG: a webes felvitel nem küld kulcsot, és MA
  /// MŰKÖDIK. Kötelezővé téve az űrlapot is át kellene írni, tehát a mező
  /// bevezetése törné azt, ami áll. Aki egyszer „tisztaságból" kötelezővé
  /// tenné, a webes felvitelt állítaná le.
  ///
  /// EGYEDI: ez maga a védelem. A létrehozás előtt a kulcsra keresünk, és
  /// találat esetén a MEGLÉVŐ rekordot adjuk vissza; az egyediség pedig azt is
  /// elvágja, amit két párhuzamos kérés csúsztatna át a keresés és a beszúrás
  /// között.
  ///
  /// A NULL nem egyenlő önmagával, tehát a kulcs nélküli sorok (minden mai sor
  /// és minden webes felvitel) korlátlanul állhatnak egymás mellett.
  clientOperationId   String?          @unique
  qrToken             String           @unique @default(uuid()) @db.Uuid
  customerId          String?
  supplierId          String?
  customerAddressId   String?
  /// A PARTNER ALEGYSÉGE, ahol az eszköz ténylegesen áll (a Fánk „Biodóm"
  /// egysége). Csak szerviz partner tulajdonosnál értelmes: a vevő-oldali
  /// finomítás a `customerAddressId`, és a kettő nem ugyanaz a fogalom.
  ///
  /// UGYANAZ A SOR, AMI A MUNKALAPSZÁM ELSŐ TAGJÁT ADJA. A partner képernyőn
  /// „Alegységek" néven áll, a munkalap ugyanerre a táblára hivatkozik
  /// `departmentId` néven, és a szám első tagja ennek a sornak a kódja. Ezért
  /// a mező neve is ez: egy harmadik szó ugyanarra a dologra pontosan azt a
  /// zavart szülné, ami miatt ez a mező készül (2026-08-27: az eszköz-felvitel
  /// helyszín-mezője üresen állt, mert két fogalmat hívtunk egy néven).
  ///
  /// BÁRMELYIK CSOMÓPONTHOZ köthető, nem csak levélhez -- ugyanaz a szabály,
  /// mint a munkalapnál. Így egy új alcsomópont felvétele nem árvítja el az
  /// ott lógó eszközöket: nem mozdul semmi.
  ///
  /// `Restrict`, nem `SetNull`: egy alegység törlése nem veheti el csendben
  /// egy eszköz helyét. A szomszédos `customerAddressId` azért `SetNull`, mert
  /// a cím a vevő adatlapjáról bármikor eltűnhet; alegység törlésére ma nincs
  /// is út, és ha lesz, előbb a rajta lógó eszközöket kell elmozdítani.
  departmentId        String?
  aquariumId          String?
  parentAssetId       String?
  productVariantId    String?
  kind                AssetKind        @default(EQUIPMENT)
  status              AssetStatus      @default(ACTIVE)
  criticality         AssetCriticality @default(NORMAL)
  name                String
  /// A KATEGORIA SZOVEGES ALAKJA -- KIVEZETES ALATT.
  ///
  /// 2026-09-22-ig EZ volt a kategoria, szabad szovegkent, es negy elgepelt
  /// erteket szult. Az uj ut a `categoryId`; ez a mezo a meglevo sorokon
  /// MEGMARAD, de UJ ertek NEM kerul bele es SENKI nem olvassa.
  ///
  /// AZ ELDOBASA KULON LEPES, es szandekosan nem ebben a korben: egy oszlop
  /// torlese visszafordithatatlan, es amig itt all, a migracio eredmenye
  /// ELLENORIZHETO marad (a szoveg es a hivatkozott nev osszevetheto).
  category            String?
  categoryId          String?
  /// A FUNKCIO -- KULON MEZO, KULON TABLA, lasd az `AssetFunction` fejlecet.
  /// NEM a kategoria bovitese: a ketto egymastol fuggetlenul allithato.
  functionId          String?
  manufacturer        String?
  model               String?
  serialNumber        String?
  /// A PARTNER SAJÁT KÓDJA, MEGŐRZÖTT NÉVVEL 2026-09-23-IG.
  ///
  /// Ez a mező mindig ezt jelentette (lásd a régi `FIELD_LABELS` bejegyzést,
  /// "partner azonosítója", és a munkalap-sor `inventoryNumber` jegyzetét,
  /// "AZ ÜGYFÉL SAJÁT ESZKÖZKÓDJA") -- a felirat viszont "Leltári szám" volt,
  /// és Balázs kérése (2026-09-23 11:55) szerint ez félrevezető. Az oszlop
  /// átnevezve, az ADAT VÁLTOZATLAN (egy sorban állt: RIV_PUM).
  partnerInternalCode String?
  /// AZ IGAZI LELTÁRI SZÁM, ÚJ MEZŐKÉNT (Balázs kérése, 2026-09-23 11:55).
  ///
  /// ÜRESEN INDUL: ezt a partner tölti ki majd, egy KÉSŐBB épülő felületen.
  /// Amíg az a felület nincs kész, ez a mező MA SENKI ÁLTAL nem írható a
  /// gyakorlatban, csak a séma és az API kész rá.
  inventoryNumber     String?
  /// A BERENDEZES TELJESITMENYE, a `performanceUnit` mertekegysegeben.
  ///
  /// A KET MEZO EGYUTT MOZOG, es ezt CHECK is orzi a tablan: egy "500" onmagaban
  /// nem informacio, hanem talalgatasra hivas (watt? liter per ora?). Ugyanaz az
  /// alak, mint a matrica `assignment_pairing_check`-je.
  performance         Decimal?         @db.Decimal(19, 6)
  /// A mezo neve NEM `unitId`: az MAR FOGLALT ezen a modellen, es a HELYSZINT
  /// jelenti (`Asset.unitId` -> `PartnerUnit`). Lasd a `UnitOfMeasure` fejlecet.
  performanceUnitId   String?
  /// `Restrict`, nem `SetNull`: ha egy mertekegyseget valaki torolni akar,
  /// amire eszkozok hivatkoznak, az NEM csendben uritse ki a mezoket -- a
  /// kivezetes utja az `isActive = false`, ami a valasztobol veszi ki.
  performanceUnit     UnitOfMeasure?   @relation("AssetPerformanceUnit", fields: [performanceUnitId], references: [id], onDelete: Restrict)
  /// A BERENDEZES TERFOGATA, MINDIG m3-BEN.
  ///
  /// Balazs kerese, 2026-09-23 (kanban 8c77cf3e), a FANK Excel-tablazat
  /// alapjan (`Terfogat (m3)` oszlop, 59 kitoltott soron). NINCS kulon
  /// mertekegyseg-mezo, mert a FANK-ban ez az oszlop MINDIG m3 -- ellentetben
  /// a `performance`-szel, ahol a szerelo tobb egyseg kozul valaszt.
  volume              Decimal?         @db.Decimal(19, 6)
  /// A BERENDEZES FOGYASZTASA, MINDIG kW-BAN -- AZ OSSZEADHATO SZAM.
  ///
  /// Balazs kerese, 2026-09-23 (kanban 8c77cf3e), a FANK Excel `Fogyasztas
  /// (ossz. kW vagy P1/P2)` oszlopa alapjan.
  ///
  /// NEM UGYANAZ, MINT A `performance`: 136 soron EGYSZERRE van kitoltve a
  /// Teljesitmeny (m3/h, a `performance` mezot tolti) ES a Fogyasztas (kW) --
  /// tehat a ket ertek FUGGETLEN, egy eszkoznek EGYSZERRE lehet mindket
  /// adata, es a `performance` egy-ertek-egy-mertekegyseg parja nem tudna
  /// mindkettot tartani.
  ///
  /// MIERT DECIMAL, NEM SZOVEG -- ES EZ VALTOZAS A KORABBI DONTESHEZ KEPEST.
  /// Elsore szoveg volt (lasd `powerConsumptionRaw` lejjebb, miert): a FANK
  /// 276 kitoltott soraiabol 142 (51%) "P1/P2" alaku, ket motor-teljesitmeny
  /// egy cellaban (pl. "6,15/5,5"). Balazs viszont kimondta (2026-09-23,
  /// acrobot kerdesere): OSSZE AKARJA ADNI a fogyasztast egy rendszerre --
  /// ez csak szamon mukodik. A P1/P2 sorokon MELYIK szam kerul ide, azt az
  /// IMPORT dolgozza fel (ma meg nem letezik); ez a mezo maga barmelyiket
  /// befogadja, amit a bevitel ad.
  powerConsumption    Decimal?         @db.Decimal(19, 6)
  /// A FOGYASZTAS EREDETI, VALTOZATLAN SZOVEGE -- A TABLA CELLAJA, BETURE.
  ///
  /// Ketto mezo egy adat helyett, es ez szandekos (acrobot dontese,
  /// 2026-09-23): ha csak a `powerConsumption` szamot tartanank meg, a
  /// "6,15/5,5" alak MASODIK erteke eltunne, es soha tobbe nem tudnank meg,
  /// mi allt ott -- a valasztott szam felteves, nem meres. Ez a mezo azert
  /// van, hogy a felteves barmikor visszaellenorizheto es visszafejtheto
  /// legyen. A tarolasi ara nulla: opcionalis, es a legtobb esetben (ahol a
  /// FANK-ban egyetlen szam allt) ugyanazt az erteket hordozza, mint a
  /// `powerConsumption`, csak szovegkent.
  powerConsumptionRaw String?
  /// A TABLAZAT ELSO OSZLOPA ("MAT kod / Elektromos"), SAJAT MEZOKENT.
  ///
  /// Balazs kerese, 2026-09-23 (kanban 8c77cf3e), szo szerint: "kapjon sajat
  /// mezot". A felteteles: a keresonek meg kell talalnia az eszkozt a
  /// nyomtatott kod alapjan (`service-assets.repository.ts` search aga) --
  /// egy `notes`-ba irt ertek ezt nem tudna, csendben veszne el, mint ami be
  /// sem kerult.
  ///
  /// SZOVEG, NEM SZAM: acrobot merese, 679 sorbol 351-nek van erteke, 282
  /// kulonbozo, az alakja vegyes ("10M", "30M/1-5", "13M") -- sem tiszta
  /// szam, sem egyseges hosszusagu. A NYERS erteket tarolja, valtoztatas
  /// nelkul; a "30M/1-5" alak jelentese (talan homokszuro-kod plusz
  /// szelep-tartomany) FELTEVES, NEM MERT -- ha a mezo a nyers erteket orzi,
  /// ez a kerdes kesobb is eldontheto.
  electricalCode      String?
  /// `Restrict`, ugyanugy, mint a mertekegysegnel: egy kategoria, amire eszkoz
  /// mutat, nem torolheto ki alola. A kivezetes `isActive`-kal megy.
  categoryRef         AssetCategory?   @relation("AssetCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  /// `Restrict`, ugyanugy, mint a kategorianal: egy funkcio, amire eszkoz
  /// mutat, nem torolheto ki alola. A kivezetes `isActive`-kal megy.
  functionRef         AssetFunction?   @relation("AssetFunction", fields: [functionId], references: [id], onDelete: Restrict)
  description         String?
  installedAt         DateTime?
  purchasedAt         DateTime?
  warrantyExpiresAt   DateTime?
  serviceIntervalDays Int?
  lastServicedAt      DateTime?
  nextServiceAt       DateTime?
  notes               String?
  archivedAt          DateTime?
  createdById         String?
  updatedById         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  customer        Customer?            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier        Supplier?            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  customerAddress CustomerAddress?     @relation(fields: [customerAddressId], references: [id], onDelete: SetNull)
  department      WorksheetDepartment? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  aquarium        Aquarium?            @relation(fields: [aquariumId], references: [id], onDelete: SetNull)
  parentAsset     Asset?               @relation("AssetHierarchy", fields: [parentAssetId], references: [id], onDelete: SetNull)
  childAssets     Asset[]              @relation("AssetHierarchy")
  productVariant  ProductVariant?      @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  createdBy       User?                @relation("AssetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?                @relation("AssetUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  events          AssetEvent[]
  serviceJobs     ServiceJobAsset[]
  worksheets      WorksheetAsset[]
  documents       AssetDocument[]
  worksheetLines  WorksheetLine[]
  label           AssetLabel?

  @@index([customerId, status])
  @@index([supplierId, status])
  @@index([customerAddressId])
  @@index([departmentId])
  @@index([aquariumId])
  @@index([parentAssetId])
  @@index([productVariantId])
  @@index([nextServiceAt, status])
  @@index([serialNumber])
  @@index([partnerInternalCode])
  @@index([inventoryNumber])
  @@index([electricalCode])
  @@index([functionId])
}

/// ELŐRE NYOMTATOTT MATRICA KÓDJA. A matrica ELŐBB létezik, mint az eszköz.
///
/// MIÉRT KÜLÖN TÁBLA, ÉS NEM MEZŐ AZ ESZKÖZÖN: a kód a nyomtatáskor keletkezik,
/// az eszköz viszont csak akkor, amikor a szerelő a helyszínen felveszi. Egy
/// oszlop az `Asset` táblán nem tud tárolni egy kiadott, de még senkihez nem
/// tartozó kódot -- és épp ez a nyilvántartás a feladata.
///
/// MIÉRT NEM A MEGLÉVŐ `Asset.qrToken`, ÉS EZ A LÉNYEG. A `qrToken` 128 bites
/// véletlen uuid, és a `detailByQrToken` szándékosan NEM ellenőriz tulajdont:
/// ott a token birtoklása maga a felhatalmazás. Ez a kivétel a MEZŐ HELYÉHEZ
/// tapad, nem a mező erősségéhez. Balázs kódalakja egy betű és négy szám, ami
/// 260 ezer lehetőség: egy hitelesített SERVICE_VIEW jogú partner-felhasználó
/// végig tudná próbálni, és sorra kapná más partnerek eszközeit. Ezért a
/// matricakód KÜLÖN fogalom, külön táblán, és a rajta való lekérdezés
/// TULAJDONT ELLENŐRIZ. Nem szigorúságból: ezen az úton nincs más védelem.
///
/// A HÁROM VÉDELEM, AMI EBBŐL A SZERKEZETBŐL KÖVETKEZIK, NEM KÓDBÓL:
///   1. a kiadott, de használatlan kódok = azok a sorok, ahol `assetId` NULL;
///   2. egy kód nem kerülhet két eszközre: a sor MAGA a kód, egy `assetId`-vel;
///   3. egy eszközre nem kerülhet két kód: `assetId` egyedi.
///
/// A HARMADIK EGY DÖNTÉS, NEM KÉNYSZER. Ma egy eszközön egy látható matrica
/// van. Ha egyszer cserélni kell (leázott, letépték), az NEM ennek a
/// megkötésnek a lazítása lesz, hanem egy leválasztás-esemény: a régi sor
/// `assetId` mezője üresre áll, és a napló őrzi, mi történt. Enélkül a csere
/// csendben két érvényes matricát hagyna ugyanazon az eszközön.
///
/// KÉT MEGKÖTÉS A TÁBLÁN ÁLL, ÉS A PRISMA SÉMA NEM TUDJA KIFEJEZNI ŐKET --
/// nyers SQL-ben a `20260902160000_asset_label_pool` migrációban:
///   `AssetLabel_code_shape_check`          a kód alakja (`^[A-Z][0-9]{4}$`)
///   `AssetLabel_assignment_pairing_check`  az `assetId` és az `assignedAt`
///                                          együtt áll vagy együtt hiányzik
/// Azért adatbázis-szinten, mert egy migráció, egy háttérmunka vagy egy későbbi
/// végpont nem örökli az alkalmazás ellenőrzéseit, a tábla megkötését viszont
/// igen. Ha ezek változnak, EZ a komment is változik, ugyanabban a körben.
///
/// AZ AKTORT NEM ITT TÁROLJUK: a hozzárendelés `AssetEvent` sort ír
/// (`LABEL_ASSIGNED`), ahol az `actorUserId` amúgy is áll. Egy külön mező itt
/// ugyanazt mondaná el másodszor, és a kettő elcsúszhatna egymástól.
/// EGY GENERALASI TETEL: amit egy gombnyomas eloallitott.
///
/// MIERT KELL SAJAT TABLA, ES NEM ELEG AZ `issuedAt` A MATRICAN. Balazs a
/// KORABBI GENERALASOKAT akarja latni (mikor, hany kod, hany szabad meg) --
/// ehhez a tetelnek ONALLO azonossaga kell. Ket, egy percen belul inditott
/// generalas az `issuedAt` alapjan osszemosodna, es epp az a ket sor az, amibol
/// egy veletlen dupla kattintas latszik.
///
/// A SZABAD DARABSZAM NINCS ITT TAROLVA, es ez dontes: azt a matricak
/// allapotabol SZAMOLJUK (`assetId IS NULL`). Egy tarolt szamlalo minden
/// eszkoz-felvitelnel karbantartast igenyelne, es a ket ertek elcsuszasa
/// CSENDES lenne -- a lista tovabbra is szamot mutatna, csak rosszat.
///
/// AMIT EZ A TABLA NEM TUD, ES AMIT EGYSZER KERDEZNI FOGNAK: hogy egy tetelt
/// KINYOMTATTAK-E. A nyomtatas tenyet ma sehol nem rogzitjuk -- se itt, se
/// masutt. Ha egyszer az a kerdes johet, hogy "hany matrica van kinyomtatva es
/// meg felhasznalatlan", arra ma NINCS forras, es ez nem szamitasi kerdes,
/// hanem hianyzo adat.
model AssetLabelBatch {
  id             String       @id @default(cuid())
  /// A generalas idopontja. A listan PERCRE pontosan latszik: enelkul egy
  /// veletlen dupla generalas ugyanazon a napon ket egyforma sornak latszana.
  createdAt      DateTime     @default(now())
  /// Hany kodot KERTEK. A tenylegesen letrejottek szama a kapcsolt sorokbol
  /// johet -- a ketto csak akkor terne el, ha a generalas felig futott volna le,
  /// es azt a tranzakcio kizarja.
  requestedCount Int
  /// AZ AKTORT NEM TAROLJUK. Balazs harom dolgot kert a listara: mikor, hany
  /// kod, hany szabad. A "ki generalta" nem szerepel kozottuk, es egy User
  /// kapcsolat itt olyan mezot vinne be, amit senki nem kerdez -- viszont
  /// karban KELLENE tartani (torolt felhasznalo, jogosultsag). Ha egyszer
  /// kerdes lesz, akkor kerul be, indoklassal.
  labels         AssetLabel[]

  @@index([createdAt])
}

/// A MERTEKEGYSEG FAJTAJA: AZT MONDJA MEG, MIT MER AZ EGYSEG -- NEM AZT, HOL
/// VALASZTHATO.
///
/// EZ A MONDAT A LEGFONTOSABB EZEN A MEZON, es acrobot kerte ide (2026-09-16),
/// mert ez a fajta oszlop ket szerepet szokott osszecsusztatni:
///
///     amit JELENT                 az ertek FAJTAJA (mennyiseg / meres / teljesitmeny)
///     amit FELVENNE eszrevetlenul hogy MELYIK KEPERNYON valaszthato
///
/// A ketto MA egybeesik, es epp ezert nem latszik. Elvalik abban a percben,
/// amikor egy egyseg KET helyen is ertelmes lesz -- a `l/h` peldaul
/// teljesitmeny IS, es egy tetelsoron mennyiseg IS lehet.
///
/// AKKOR NEM EZT A MEZOT KELL TAGITANI, es nem a szuroket "javitani": akkor a
/// HASZNALATI HELY kulon fogalom (egy kapcsolotabla vagy egy lista a soron), es
/// ez a mezo marad az, ami: a mert mennyiseg fajtaja. Aki a szuroket igazitja,
/// a modellt hagyja rosszul.
///
/// === MIERT LETEZIK EGYALTALAN ===
///
/// A rendszerben ma TIZ szabad szoveges mertekegyseg-mezo all, es azok LEGALABB
/// ket, egymassal nem keverheto vilagbol valok: a MENNYISEGEK (db, ora, ml --
/// termek, rendeles, szamla, munkalap) es a MERESEK (mg/l, °C, µg/l -- akvarium,
/// ICP). Az eszkoz TELJESITMENYE egy harmadik.
///
/// Egy lapos, fajta nelkuli lista MUKODNE, es pont hasznalat kozben lenne rossz:
/// egy munkalap-tetelsor felkinalna a µg/l-t. A fajta ezert a TABLAN all: a
/// valasztokban minden uj felulet ujra eldontene, mit mutat, es a tizedik
/// valaszto mar biztosan maskepp dontene.
enum UnitOfMeasureKind {
  /// Amiben MENNYISEGET merunk: db, ora, kg, l.
  QUANTITY
  /// Amiben MERESI EREDMENYT adunk meg: mg/l, °C, µg/l, dKH.
  MEASUREMENT
  /// Amiben egy BERENDEZES kepesseget merjuk: W, l/h, m3/h.
  PERFORMANCE
}

/// KARBANTARTOTT MERTEKEGYSEG-LISTA (Balazs kerese, 2026-09-16).
///
/// A NEVE SZANDEKOSAN `UnitOfMeasure` ES NEM `Unit`. A semaban a "unit" szo MA
/// HAROM dolgot jelent: mertekegyseg, SZERVEZETI EGYSEG (helyszin) es EGYSEGAR.
/// A masodik foglalja a kodbazist: az `Asset.unitId` a HELYSZIN, a felulet
/// `UnitPicker`-rel valasztja, es tizennegy ag neve kezdodik igy. Egy `Unit`
/// nevu tabla mellett az `asset.unitId` es az `asset.unitId` kozott semmi nem
/// mondana meg a kulonbseget -- es az olvasaskor nem latszik, csak hasznalatkor.
/// AZ ESZKOZ KATEGORIAJA -- SAJAT TORZSADAT, NEM SZABAD SZOVEG.
///
/// Balazs kerese, 2026-09-22: „az eszkozfelvitelniel a kategoria legyen
/// legordulomenu". Az indok mert: 110 eszkozon TIZ kulonbozo ertek allt, de
/// csak HAT valodi -- a masik negy elgepeles volt (`VÍzkezelés`,
/// `Kízekezelés`, `Segédeszkőz`, `Ventúri`). A „Vízkezelés" szuro ezert KET
/// eszkozt hagyott ki, es senki nem vette eszre: a lista helyesnek latszott.
///
/// === MIERT KULON TABLA, ES NEM A `UnitOfMeasure` BOVITESE ===
///
/// NEM azert, mert ket kulonbozo dolog -- hanem mert a KOZOS TABLAN AZ
/// ADATBAZIS NEM TUDNA MEGKULONBOZTETNI OKET.
///
/// Az `Asset.performanceUnitId` MAR a `UnitOfMeasure`-re mutat. Egy kozos
/// tablan a kategoria-kapcsolat UGYANODA mutatna, es semmilyen megkotes nem
/// zarna ki, hogy valaki egy mertekegyseget valasszon kategorianak. Ma ezt a
/// `kind` diszkriminator teszi meg, adatbazis-szinten; egy kozos tablan csak
/// alkalmazas-kod tenne -- es az csendben romlik el, miközben a szabaly
/// tovabbra is ott all leirva.
///
/// AMI VISZONT KOZOS A KETTOBEN, es szandekosan: a kivezetes `isActive`-kal
/// (nem torlessel), a `sortOrder`, es a vegpontok alakja. A SZERKEZET kozos,
/// a TABLA nem.
model AssetCategory {
  id        String   @id @default(cuid())
  /// A nev, ahogy a valasztoban all: „Vízkezelés". EGYEDI: ket azonos nevu
  /// kategoria pont azt a helyzetet allitana vissza, ami miatt ez a tabla
  /// letrejott.
  name      String   @unique
  /// A FANK JELMAGYARAZATABOL JON, ROVID AZONOSITO (peldak: AIP, CAR, COM,
  /// VAL_SUR, VAL_BOT). Balazs kerese, 2026-09-23. NULLAZHATO: a szerkezet
  /// nem koti harom karakterhez, es nem tiltja az alahuzast -- ket meglevo
  /// kod is tartalmaz. EGYEDI, ha ki van toltve; tobb `NULL` sor Postgres
  /// alatt nem utkozik.
  code      String?  @unique
  /// A kivezetett kategoria NEM torlodik: eszkozok hivatkoznak ra. A
  /// valasztobol esik ki, a MEGLEVO eszkozok mellett viszont olvashato marad.
  isActive  Boolean  @default(true)
  /// A felkinalas sorrendje. A gyakoriak elore: a `Vízkezelés` es a
  /// `Vízmozgatás` egyutt a sorok tobbseget adja, es egy betűrendes lista
  /// koze szorna oket.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets Asset[] @relation("AssetCategory")

  /// A valaszto lekerdezese: aktivak, sorrendben.
  @@index([isActive, sortOrder])
}

/// AZ ESZKOZ FUNKCIOJA -- KULON TORZSADAT, NEM A KATEGORIA BOVITESE.
///
/// Balazs kerese, 2026-09-23, szo szerint: "az eszkozoknel ezt a funkciok
/// reszt ugyanugy legordulo menube meg kellene jeleniteni". A SZERKEZET
/// (nev, kivezetes torles helyett, sorrend, vegpont-alak) az AssetCategory
/// mintajat koveti -- de KULON TABLA, mert MAS TENGELY: a kategoria azt
/// mondja meg, MI az eszkoz (kompakt szuro, ozon generator), a funkcio azt,
/// MIRE valo. A ketto kozott SZANDEKOSAN nincs kapcsolat -- acrobot
/// kikotese: "ne vezess be kozottuk kapcsolatot, amig nem kerik".
///
/// URESEN INDUL: Balazs sajat szavaval "ezt majd mi feltoltjuk" -- ez a
/// migracio ezert NEM ir kezdo sorokat, csak a tablat hozza letre.
model AssetFunction {
  id        String   @id @default(cuid())
  /// A nev, ahogy a valasztoban all. EGYEDI, ugyanazert, mint a kategorianal.
  name      String   @unique
  /// A kivezetett funkcio NEM torlodik: eszkozok hivatkoznak ra.
  isActive  Boolean  @default(true)
  /// A felkinalas sorrendje.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets Asset[] @relation("AssetFunction")

  /// A valaszto lekerdezese: aktivak, sorrendben.
  @@index([isActive, sortOrder])
}

model UnitOfMeasure {
  id        String            @id @default(cuid())
  /// A rovid jel, ahogy a feluleten all: `db`, `óra`, `W`, `mg/l`.
  code      String
  /// A teljes nev, ami a listaban segit valasztani: "watt", "liter per óra".
  name      String
  kind      UnitOfMeasureKind
  /// A kivezetett mertekegyseg NEM torlodik: sorok hivatkoznak ra. A
  /// valasztokbol esik ki, a MEGLEVO ertekek mellett viszont olvashato marad.
  isActive  Boolean           @default(true)
  /// A felkinalas sorrendje. A gyakori egysegek elore kerulnek, mert egy
  /// betűrendes lista a `db`-t a lista kozepere teszi.
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  performanceAssets Asset[] @relation("AssetPerformanceUnit")

  /// A KOD A FAJTAJAN BELUL EGYEDI, nem globalisan. Egy jel ket vilagban is
  /// allhat (a `l` mennyiseg is, meres is lehet), es egy globalis egyediseg
  /// ilyenkor az egyiket ZARNA KI -- olyan dontest hozva, amit ma semmi nem
  /// indokol. Visszafele viszont barmikor szukitheto.
  @@unique([kind, code])
  /// A valaszto lekerdezese: fajtara szurve, aktivak, sorrendben.
  @@index([kind, isActive, sortOrder])
}

model AssetLabel {
  id         String           @id @default(cuid())
  /// Melyik generalasi tetelbol szuletett. NULLAZHATO: a mezo elott kiadott
  /// kodoknak nincs tetelük, es egy migracio nem talalhat ki nekik egyet.
  batchId    String?
  batch      AssetLabelBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  /// A matricán álló, emberi szemnek szánt azonosító (egy betű és négy szám,
  /// például V2196). Balázs döntése, 2026-09-02, a 42056ab0 kártyán.
  code       String           @unique
  /// Mikor adtuk ki (nyomtattuk). A kiadás önmagában nem köti eszközhöz.
  issuedAt   DateTime         @default(now())
  /// NULL, amíg a matrica szabad. Egyedi: egy eszközön egy matrica.
  assetId    String?          @unique
  assignedAt DateTime?

  /// `SetNull`, nem `Cascade`: egy eszköz törlése nem semmisítheti meg a
  /// matricát, mert az fizikailag ott marad valamin. A sor visszakerül a
  /// szabad készletbe, és a kód újra kiosztható.
  asset Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  /// A szabad készlet lekérdezése ezen megy: `assetId IS NULL`, kiadás szerint.
  @@index([assetId, issuedAt])
}

/// Eszközhöz csatolt, jogosultsággal védett PDF. A tartalom első körben az
/// adatbázisban marad, hogy külön object storage nélkül is konzisztensen
/// menthető és backupolható legyen; később Paperless hivatkozásra migrálható.
/// A tartalom KET HELYEN allhat, es PONTOSAN AZ EGYIKEN.
///
/// A `content` a mai, adatbazisban tarolt bajtok; a `storageKey` a kulso
/// dokumentum-taroloban allo fajl kulcsa. A ket mezo kozul mindig pontosan az
/// egyik nem null, es ezt adatbazis-szintu CHECK orzi, nem csak a kod: egy
/// hattermunka, egy migracio vagy egy uj vegpont nem orokli az alkalmazas
/// ellenorzeseit, a tabla megkotesét viszont igen.
///
/// A REGI SOROK ERINTETLENEK: content megvan, storageKey null, tehat a regi
/// olvasasi ut valtozatlanul mukodik, migracio nelkul.
model AssetDocument {
  id           String            @id @default(cuid())
  assetId      String
  type         AssetDocumentType
  fileName     String
  contentType  String
  sizeBytes    Int
  sha256       String            @db.VarChar(64)
  content      Bytes?
  storageKey   String?
  /// A CSEMPE KEPE -- egy kicsi, szerver-oldalon eloallitott valtozat. A teljes
  /// indoklas a `ServiceJobDocument.thumbnail` fejlecen all; a harom
  /// dokumentum-tabla alakja SZANDEKOSAN azonos.
  thumbnail    Bytes?
  uploadedById String?
  /// A CSATOLMANY FELIRATA -- MIT LATUNK A KEPEN. Elhagyhato, es utolag is
  /// irhato. A teljes indoklas a `ServiceJobDocument.caption` fejlecen all; a
  /// harom dokumentum-tabla alakja SZANDEKOSAN azonos, tehat a mezo mind a
  /// haromon ugyanugy szerepel.
  caption      String?           @db.VarChar(500)
  createdAt    DateTime          @default(now())

  asset      Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("AssetDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([assetId, type, createdAt])
  @@index([sha256])
}

/// Append-only üzleti előzmény az eszköz létrehozásáról, áthelyezéséről,
/// státusz- és hierarchiaváltásáról, valamint QR-token cseréjéről.
/// A MUNKALAPHOZ CSATOLT FAJL FAJTAJA.
///
/// KET ERTEK, ES EGYIK SEM SPEKULACIO. A `PHOTO` az, amiert a tabla keszul: a
/// szerelo a helyszinen fenykepez. Az `OTHER` a menekulout, hogy egy masfajta
/// csatolmany ne kivanjon migraciot -- a nevek szandekosan ugyanabbol a
/// keszletbol valok, mint az eszkoznel.
enum WorksheetDocumentType {
  PHOTO
  OTHER
  /// A LEZARASKOR GENERALT MUNKALAP. Nem feltoltott csatolmany: EZT allitjuk
  /// hitelesnek, es erre szol a kesobbi alairas.
  ///
  /// MIERT KELL KULON ERTEK, ES MIERT NEM ELEG AZ `OTHER`: az `OTHER` alatt ma
  /// kezzel feltoltott fajlok allnak. Ha a generalt lap is oda kerulne, egy
  /// feltoltott PDF MEGKULONBOZTETHETETLEN lenne tole -- es a "a tarolt fajl a
  /// hiteles" allitas olyan sorra mutatna, amit barki letrehozhatott.
  GENERATED_SHEET

  /// AZ ALAIRAS UTAN KESZULT, VEGLEGES MUNKALAP.
  ///
  /// === MIERT KELL, ES MIERT NEM ELEG A `GENERATED_SHEET` ATIRASA ===
  ///
  /// A lezaraskori lapon PISZKOZAT felirat all, es ez NEM elirat: a felirat
  /// feltetele (`status !== "SIGNED"`) helyes, csak a SORREND mas. A lapot a
  /// `close()` allitja elo, az alairas pedig CSAK AZUTAN jon -- tehat a
  /// generalas pillanataban az allapot SOHA nem `SIGNED`. (A lelet ebben az
  /// alakban murenatol jon, 2026-09-21; ugyanarra a sorra jutott, mint acrobot,
  /// ket fuggetlen meresbol.)
  ///
  /// Balazs a B alakot hagyta jova (2026-09-21 09:02:39 UTC, Discord, digitalis
  /// alairas szal, message_id 1551519015673929841, szo szerint: "igen jo igy"):
  /// az alairas tegyen MELLE egy kulon, vegleges dokumentumot, a lezaraskori
  /// lap maradjon ERINTETLEN.
  ///
  /// AZ ELUTASITOTT ALAK (ujragyartas alairaskor) egy MAR ELTAROLT hiteles
  /// dokumentum tartalmat ES lenyomatat irna at. Ez utkozik a 2026-08-21-i
  /// dontessel (Balazs: "Igen jol erted"): az alairt munkalap vegleges, sem
  /// szerkesztessel, sem uj verzioval nem nyul hozza senki.
  ///
  /// ES AZERT UJ ERTEK, NEM UJ SOR A REGI TIPUSSAL: az egyedi index a
  /// `(worksheetVersionId, type)` parosra szol, tehat ket sor UGYANAZZAL a
  /// tipussal nem fer meg egy verzio alatt.
  SIGNED_SHEET
}

/// MUNKALAPHOZ CSATOLT FENYKEP VAGY EGYEB FAJL.
///
/// === MIERT A LAPHOZ, ES NEM A VERZIOHOZ ===
///
/// A kep BIZONYITEK a munkarol, nem a lap SZOVEGENEK resze. A lapnak verzioi
/// vannak, es egy alairt verzio valtozatlan: ha a kep a verziohoz tartozna, egy
/// kesobb erkezo fenykep VAGY nem ferne fel, VAGY egy alairt valtozatot irna at.
/// Az egyik adatot veszit, a masik egy alairt rekordot modosit -- egyik sem
/// vallalhato, tehat a verzio-hivatkozas nem "kevesbe jo", hanem kiesik.
/// (acrobot dontese, 2026-09-03, a 11553-as uzenetben; felulirhato.)
///
/// ALAIRAS UTAN IS FELKERULHET, ugyanabbol az okbol: a bizonyitek gyakran keson
/// erkezik, es a lap tartalmat nem valtoztatja meg.
///
/// === A TARTALOM KET HELYEN ALLHAT, ES PONTOSAN AZ EGYIKEN ===
///
/// Ugyanaz a szabaly, mint az `AssetDocument`-nel, es SZANDEKOSAN ugyanaz: a
/// ket modell elterese azt jelentene, hogy minden kesobbi valtozast ketszer
/// kell megcsinalni, es a masodik mindig lemarad. A megkotest adatbazis-szintu
/// CHECK orzi (`WorksheetDocument_content_or_storage_key`), nem csak a kod: egy
/// hattermunka vagy egy kesobbi vegpont nem orokli az alkalmazas
/// ellenorzeseit, a tabla megkoteset viszont igen.
model WorksheetDocument {
  id          String @id @default(cuid())
  worksheetId String

  /// MELYIK VERZIOHOZ TARTOZIK -- ES EZ CSAK A GENERALT LAPNAL VAN KITOLTVE.
  ///
  /// A feltoltott fenykep a MUNKALAPHOZ tartozik: egy keszulek fenykepe nem egy
  /// verziorol szol. A lezaraskor generalt lap viszont EGY VERZIO tartalmat
  /// rogziti, es egy munkalapnak tobb verzioja lehet (a piszkozat is kap lapot).
  ///
  /// Verzio-kotes nelkul ket lezaras ket fajlt tenne ugyanarra a munkalapra, es
  /// semmi nem mondana meg, melyik melyik -- vagyis epp az a kerdes maradna
  /// nyitva, amire a "a tarolt fajl a hiteles" dontes valaszolni akar.
  worksheetVersionId String?
  type               WorksheetDocumentType @default(PHOTO)
  fileName           String
  contentType        String
  sizeBytes          Int
  sha256             String                @db.VarChar(64)
  content            Bytes?
  storageKey         String?
  /// A CSEMPE KEPE -- egy kicsi, szerver-oldalon eloallitott valtozat. A teljes
  /// indoklas a `ServiceJobDocument.thumbnail` fejlecen all; a harom
  /// dokumentum-tabla alakja SZANDEKOSAN azonos.
  thumbnail          Bytes?
  uploadedById       String?
  /// A CSATOLMANY FELIRATA -- MIT LATUNK A KEPEN. Elhagyhato, es utolag is
  /// irhato. A teljes indoklas a `ServiceJobDocument.caption` fejlecen all; a
  /// harom dokumentum-tabla alakja SZANDEKOSAN azonos, tehat a mezo mind a
  /// haromon ugyanugy szerepel.
  caption            String?               @db.VarChar(500)
  /// A KEP SAJAT IDEJE. Nem a lap ideje es nem a verzioe: utolag ebbol latszik,
  /// melyik napi munkahoz keszult.
  createdAt          DateTime              @default(now())

  worksheet        Worksheet         @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  worksheetVersion WorksheetVersion? @relation(fields: [worksheetVersionId], references: [id], onDelete: Cascade)
  uploadedBy       User?             @relation("WorksheetDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  /// EGY VERZIOHOZ EGY GENERALT LAP -- ES EZ SZERKEZETI, NEM SZOKAS.
  ///
  /// A `worksheetVersionId` elhagyhato, es a Postgresben TOBB NULL is megfer egy
  /// egyedi indexben: a fenykepekre (ahol ures) ez a megkotes tehat nem hat.
  /// Ahol viszont ki van toltve, ott verzionkent es tipusonkent EGY sor lehet.
  ///
  /// Enelkul az "egy verziohoz egy hiteles lap" allitas konvencio lenne, amit
  /// egy masodik iras csendben megtorhet. Igy az adatbazis tagadja meg.
  @@unique([worksheetVersionId, type])
  @@index([worksheetId, createdAt])
  @@index([sha256])
}

enum ServiceJobDocumentType {
  PHOTO
  OTHER
}

/// HIBAJEGYHEZ CSATOLT FENYKEP VAGY EGYEB FAJL.
///
/// Balazs kerese (2026-09-14 19:41, Discord, Szerviz ticketing szal, szo
/// szerint): „Ami meg kellene a foto feltoltesi lehetoseg. Hibajegy rogzitesekor
/// lehessen fotot illetve egyeb fajlokat is csatolni"
///
/// === MIERT SAJAT TABLA, ES MIERT NEM A MUNKALAPE ===
///
/// A kezenfekvo rovidites az lenne, hogy a kep a jegy ala csatolt MUNKALAPRA
/// megy, es akkor nem kell uj tabla. Ez ket okbol nem all:
///
/// 1. A JEGYNEK NEM KELL MUNKALAPJA. A `Worksheet.serviceJobId` nullazhato, es a
///    jegy-felvitel egyetlen utja (`ServiceJobsService.create`) nem hoz letre
///    lapot. A hiba BEJELENTESEKOR tehat tipikusan NINCS mire csatolni.
/// 2. A KETTO MAST BIZONYIT. A munkalap kepe az ELVEGZETT munkarol szol, a jegye
///    a BEJELENTETT hibarol. Ha egy helyen allnanak, a jegy megnyitasakor
///    feltoltott kep utolag ugy latszana, mintha a szerelo keszitette volna.
///
/// === MIERT UGYANAZ AZ ALAK, MINT A `WorksheetDocument` ===
///
/// Mezore es kulcsra egyezoen, es ez nem masolas kenyelembol: a feltoltes
/// SZABALYAI kozos modulban allnak (`documents/document-intake.ts`), es a sor
/// alakja az a szerzodes, amit az a modul kitolt. Egy harmadik alak ugyanarra a
/// fogalomra azt jelentene, hogy minden kesobbi valtozast haromszor kell
/// megcsinalni, es a harmadik mindig lemarad.
///
/// === A TARTALOM KET HELYEN ALLHAT, ES PONTOSAN AZ EGYIKEN ===
///
/// A megkotest adatbazis-szintu CHECK orzi
/// (`ServiceJobDocument_content_or_storage_key`), nem csak a kod: egy
/// hattermunka vagy egy kesobbi vegpont nem orokli az alkalmazas
/// ellenorzeseit, a tabla megkoteset viszont igen.
///
/// === AMI ITT NINCS: A LATHATOSAG ===
///
/// Azt, hogy KI lathatja egy jegy csatolmanyait, ez a tabla nem mondja meg, es
/// nem is mondhatja: a jegy lathatosaga ket tengelyen all
/// (`service-job-visibility.ts`), es a szuro a JEGYRE vonatkozik, nem a
/// csatolmanyra. A vegpontnak tehat ELOSZOR a jegyet kell megtalalnia a hivo
/// hatokorevel -- egy dokumentum-vegpont, ami tagabb, mint a jegy sajat
/// lathatosaga, a jegy LETEZESET szivarogtatna ki.
model ServiceJobDocument {
  id           String                 @id @default(cuid())
  serviceJobId String
  type         ServiceJobDocumentType @default(PHOTO)
  fileName     String
  contentType  String
  sizeBytes    Int
  sha256       String                 @db.VarChar(64)
  content      Bytes?
  storageKey   String?
  /// A CSEMPE KEPE -- EGY KICSI, SZERVER-OLDALON ELOALLITOTT VALTOZAT.
  ///
  /// A MERT HIANY (acrobot merese az eles adatbazison, 2026-09-18, a `0e8abe19`
  /// kartyan): belyegkep-ut nem letezett, tehat a galeria MINDEN csempeje a
  /// teljes meretu fajlbol keszult. Egy eszkoz-galeria megnyitasa atlagosan
  /// 5,3 MB letoltes volt, a legrosszabb 9,9 MB -- huszonkilenc kepbol.
  /// Egyetlen munkalap-fenykep 8,85 MB, es az a telefonon, mobilneten, egy
  /// csempeben jelent meg.
  ///
  /// NEM HELYETTESITI AZ EREDETIT, es ez megkotes, nem megvalositasi reszlet
  /// (acrobot, 2026-09-18): a letoltes, a PDF es a hiteles peldany tovabbra is
  /// a teljes meretu fajlbol megy. Ezert KULON oszlop, es ezert nem ir felul
  /// semmit -- a `content` es a `storageKey` erintetlen.
  ///
  /// ELHAGYHATO, ES A HIANY HAROM KULONBOZO ALLAPOTOT JELENTHET: a fajl nem kep
  /// (PDF), a sor a belyegkep-ut ELOTT keletkezett, vagy az eloallitas
  /// elhasalt. Mindharomnal a csempe az EREDETIRE esik vissza, es ezt a
  /// kiszolgalo vegpont donti el -- nem a kliens, mert akkor harom kliensnek
  /// kellene ugyanazt a szabalyt tudnia.
  ///
  /// NEM SZAMIT A KERETBE. A kvota a `sizeBytes` oszlopok osszege, es az az
  /// EREDETI merete. A belyegkep ehhez kepest ket nagysagrenddel kisebb
  /// (mert: ~33 kB egy 10,7 MB-os fenykepnel), tehat a keret jelentese nem
  /// csuszik el erzekelhetoen -- de kimondva all, nem hallgatolagosan.
  thumbnail    Bytes?
  uploadedById String?
  /// A CSATOLMANY FELIRATA -- MIT LATUNK A KEPEN.
  ///
  /// Balazs kerese (2026-09-17, Discord, szo szerint): „jo lenne valami galeria
  /// szeru, akar ugy, higy megjegyzest lehessen irni a kephez akar mar a
  /// feltoltesnel is"
  ///
  /// ELHAGYHATO, ES EZ NEM KENYELEM. Kotelezove teve ket rossz valasztas
  /// maradna: vagy a MAR MEGLEVO sorokra kellene kitalalni egy szoveget (az
  /// hazudna arrol, hogy valaki leirta), vagy a migracio hasalna el rajtuk. A
  /// hiany itt ERVENYES allapot: egy kep magaert beszelhet.
  ///
  /// A FELIRAT UTOLAG IS IRHATO, nem csak feltolteskor: a bizonyitek gyakran
  /// elobb keszul el, mint a magyarazata -- a szerelo fenykepez, es az iroda
  /// nevezi meg, mit latunk rajta.
  ///
  /// MIND A HAROM DOKUMENTUM-TABLAN UGYANIGY ALL, mert a harom alak
  /// SZANDEKOSAN azonos (lasd a `ServiceJobDocument` fejlecet): a feltoltes
  /// szabalyai kozos modulban allnak, es egy harmadik alak azt jelentene, hogy
  /// minden kesobbi valtozast haromszor kell megcsinalni -- a harmadik pedig
  /// mindig lemarad.
  caption      String?                @db.VarChar(500)
  /// A CSATOLMANY SAJAT IDEJE. Nem a jegye: a bizonyitek gyakran keson erkezik,
  /// es utolag ebbol latszik, mikor.
  createdAt    DateTime               @default(now())

  serviceJob ServiceJob @relation(fields: [serviceJobId], references: [id], onDelete: Cascade)
  uploadedBy User?      @relation("ServiceJobDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([serviceJobId, createdAt])
  /// A TAROLO-EGYEZTETES ES A DUPLIKATUM-KERESES UTJA, ugyanugy, mint a masik
  /// ket dokumentum-tablan.
  @@index([sha256])
}

model AssetEvent {
  id          String         @id @default(cuid())
  assetId     String
  type        AssetEventType
  actorUserId String?
  payload     Json
  occurredAt  DateTime       @default(now())

  asset     Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([assetId, occurredAt])
  @@index([actorUserId, occurredAt])
}

/// Ami a hibajeggyel TÖRTÉNT, időrendben.
///
/// A részletlap egy naplót mutat, legújabb felül (Balázs döntése, 2026-09-02),
/// és abban HÁROM forrás keveredik: a csatolt munkalapok, az érintett eszközök
/// és az állapotváltások. Az első kettőt a saját kapcsolótábláik hordozzák -
/// EZ a harmadik.
///
/// MIÉRT KÜLÖN TÁBLA, ÉS NEM EGY MEZŐ A JEGYEN. Egy `statusChangedAt` mező azt
/// mondaná meg, mikor változott UTOLJÁRA - a napló viszont azt kérdezi, mi
/// történt VÉGIG. A kettő nem ugyanaz, és egy mezőből az előzmény soha nem
/// állítható vissza.
///
/// A `fromStatus` NULLÁZHATÓ: a jegy létrejötte is esemény, és annak nincs
/// előzménye. Egy kitalált `NEW -> NEW` sor azt állítaná, hogy volt egy lépés,
/// ami nem történt meg.
///
/// AZ AKTOR NULLÁZHATÓ, ÉS EZ SEM KÉNYELEM: egy törölt felhasználó nem viheti
/// magával a naplót. Ami történt, megtörtént - a sor akkor is igaz, ha már nem
/// tudjuk, ki csinálta.
model ServiceJobEvent {
  id           String              @id @default(cuid())
  serviceJobId String
  /// MI TORTENT. Kimondott mezo, nem kovetkeztetes (ADR-013).
  ///
  /// Az alapertek NEM kenyelmi kerdes: a migracio pillanataban MINDEN meglevo
  /// sor allapotvaltas volt, es az alapertek ezt KIMONDJA rajtuk, ahelyett
  /// hogy a `toStatus` kitoltottsegebol kellene visszafejteni.
  kind         ServiceJobEventKind @default(STATUS_CHANGE)
  /// Ahonnan lépett; `null` a jegy létrejöttekor.
  fromStatus   ServiceJobStatus?
  /// Ahova lepett. `null` MINDEN nem allapotvalto esemenyen -- de a fajtat NEM
  /// ez mondja meg, hanem a `kind`. A ketto egyutt allasat adatbazis-szintu
  /// CHECK tartja (`ServiceJobEvent_status_change_has_to_status`), tehat egy
  /// `STATUS_CHANGE` sor `toStatus` nelkul nem is keletkezhet.
  toStatus     ServiceJobStatus?
  /// A munkalap, amelyikrol az esemeny szol. `null` az allapotvaltasokon.
  ///
  /// `SetNull` a torlesre, nem `Cascade`: ami megtortent, megtortent. Egy
  /// torolt munkalap nem viheti magaval a jegy naplojat -- ugyanaz a szabaly,
  /// mint az aktornal.
  worksheetId  String?
  /// Szabad szöveg, amit a lépő hozzátehet (miért vár alkatrészre, mit
  /// beszéltek meg az ügyféllel). A napló ebből lesz olvasható emberi
  /// szemmel is.
  note         String?
  actorUserId  String?
  createdAt    DateTime            @default(now())

  serviceJob ServiceJob @relation(fields: [serviceJobId], references: [id], onDelete: Cascade)
  actor      User?      @relation("ServiceJobEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  worksheet  Worksheet? @relation("ServiceJobEventWorksheet", fields: [worksheetId], references: [id], onDelete: SetNull)

  /// A napló mindig egy jegyre, időrendben visszafelé olvasva.
  @@index([serviceJobId, createdAt])
}

/// Egy szervizmunka több eszközt érinthet, és ugyanazon eszköznek több
/// szervizelőzménye lehet. A kapcsolótábla ezt a sok-sok kapcsolatot őrzi.
model ServiceJobAsset {
  id           String   @id @default(cuid())
  serviceJobId String
  assetId      String
  notes        String?
  createdAt    DateTime @default(now())

  serviceJob ServiceJob @relation(fields: [serviceJobId], references: [id], onDelete: Cascade)
  asset      Asset      @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([serviceJobId, assetId])
  @@index([assetId, createdAt])
}

/// A MUNKALAP ALTAL ERINTETT ESZKOZOK.
///
/// Balazs kerese (2026-09-15 10:11, Discord, Szerviz ticketing szal, szo
/// szerint): „Ugyanugy ha mar a hibajegynel kivalasztok eszkozt az se jelenik
/// meg a munkalap nyitasnal"
///
/// === EZ NEM ELOTOLTESI HIBA VOLT, HANEM HIANYZO KAPCSOLAT ===
///
/// A kerdes ugy hangzott, mintha a felulet felejtene el egy erteket. Merve
/// (2026-09-15): a `Worksheet` modellnek EGYALTALAN nem volt eszkoz-kapcsolata
/// -- nem elveszett, hanem nem is letezett. A jegyen viszont tobb eszkoz all
/// (`ServiceJobAsset`), tehat a ket oldal kozott nem volt mit atvezetni.
///
/// === A LAP SAJAT ADATA, NEM A JEGY TUKRE ===
///
/// A kapcsolotabla a LAPE, es ez donti el a torles iranyat is: ha a lapot
/// LEVALASZTJAK a jegyrol, az itt allo sorok MARADNAK. A jegy eszkozei csak az
/// INDULO ERTEKET adjak; onnantol a lapon levehetok es tovabbiak felvehetok.
/// Egy tukor-megoldas (mindig a jegybol olvasni) epp ezt venne el, es egy
/// levalasztas csendben kiuritene a lapot.
///
/// === MIERT A `ServiceJobAsset` ALAKJA, MEZORE EGYEZOEN ===
///
/// Ugyanaz a fogalom (egy munkadarab es az altala erintett eszkozok), es a ket
/// oldal ugyanabban a menetben olvasodik. Egy harmadik alak ugyanarra a
/// fogalomra azt jelentene, hogy minden kesobbi valtozast ketszer kell
/// megcsinalni, es a masodik mindig lemarad.
///
/// A `notes` mezo SZANDEKOSAN nincs itt: a jegyen sem ir bele ma semmi (merve),
/// es egy mezo, amit senki nem tolt, a kovetkezo olvasot arra kesztetne, hogy
/// megkeresse, hol vesz el a tartalma.
model WorksheetAsset {
  id          String   @id @default(cuid())
  worksheetId String
  assetId     String
  createdAt   DateTime @default(now())

  worksheet Worksheet @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  /// `Restrict`, ugyanugy, mint a jegynel: egy eszkoz torlese nem viheti
  /// magaval a munkalap tortenetet. Ami megtortent, megtortent.
  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([worksheetId, assetId])
  @@index([assetId, createdAt])
}

/// A partner egy alegysége (pl. a Fánk „PP Üzemeltetés" vagy „Biodóm"
/// egysége). Ez EGY fogalom, nem kettő: ugyanaz a sor adja a munkalap-szám
/// első tagját (`BIO`) és a lapon megjelenő szöveget (`Biodóm`) is
/// (Balázs döntése, megerősítve 2026-08-18 00:56, Discord).
///
/// A kód PARTNEREN BELÜL egyedi, és ez azóta is így van, hogy a számláló
/// évenként egy sorozatot visz az egész cégre (`WorksheetYearSequence`):
/// a partneren belüli egyediség attól kell, hogy a partner lapjain a `BIO`
/// egyetlen egységet jelentsen. A SZÁM egyediségét viszont nem ez adja, hanem
/// a sorozat - két partner `BIO` egysége nyugodtan létezhet egyszerre.
model WorksheetDepartment {
  id         String   @id @default(cuid())
  customerId String
  /// A FA SZULOJE. `null` a legfelso szinten, ami ma az EGYETLEN szint: a
  /// meglevo sorok mind ilyenek maradnak, tehat a lapos lista a fa elso
  /// szintje lesz, adatvesztes es atszamozas nelkul.
  parentId   String?
  /// Öt karakterig tágítva 2026-09-23-tól (Balázs döntése, "b") -- lásd
  /// WORKSHEET_DEPARTMENT_CODE_PATTERN jegyzetét (@acropora/types).
  code       String   @db.VarChar(5)
  name       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer    Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  parent      WorksheetDepartment?      @relation("WorksheetDepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    WorksheetDepartment[]     @relation("WorksheetDepartmentTree")
  worksheets  Worksheet[]
  assets      Asset[]
  /// A helyszinre nyitott hibajegyek. A lanc ezzel lett teljes: eddig csak a
  /// munkalap es az eszkoz tudta, hol van, a BEJELENTES nem.
  serviceJobs ServiceJob[]
  /// Kik latjak ezt az alegyseget (es vele a reszfajat).
  assignees   UserWorksheetDepartment[]

  /// TESTVEREK KOZOTT EGYEDI A KOD. Ket kulonbozo ag alatt ugyanaz a kod
  /// (`BIO`) megengedett es termeszetes, egy szulon belul viszont nem.
  ///
  /// EZ A MEGKOTES A LEGFELSO SZINTRE NEM ER: a Postgresben a NULL nem egyenlo
  /// onmagaval, tehat ket gyoker-sor azonos koddal ATMENNE rajta. A mai
  /// garanciat ezert egy RESZLEGES egyedi index tartja meg
  /// (`WorksheetDepartment_customer_root_code_key`, `WHERE "parentId" IS
  /// NULL`), amit a Prisma sema nem tud kifejezni, ezert a migracioban all
  /// nyers SQL-kent. A ketto egyutt adja azt, amit eddig egy megkotes adott.
  @@unique([customerId, parentId, code])
  @@index([customerId, isActive])
  @@index([parentId])
}

/// KI MELYIK ALEGYSEGET LATJA -- A LATHATOSAGI HOZZARENDELES.
///
/// Balazs modellje (2026-08-31): egy emberhez EGY VAGY TOBB csomopontot
/// rendelunk, es o azt a csomopontot ES MINDENT ALATTA latja, feljebb semmit. A
/// muszaki vezeto foegyseget kap, a korletvezeto lejjebbit -- de ez NEM ket
/// szabaly, hanem egy: a ket szerepkor kozott nincs mechanizmusbeli kulonbseg,
/// csak az, hogy MELYIK SZINTEN kapjak a hozzarendelest.
///
/// EZERT KAPCSOLOTABLA ES NEM MEZO A FELHASZNALON: mert egy ember TOBB egyseget
/// is kaphat (pelda a dontesbol: PALMAHAZ es VARAZSHEGY egyszerre). Egy mezovel
/// indulni a masodik egysegnel adatbazis-koltoztetes lenne.
///
/// A RESZFA NEM ITT LAKIK. Ez a tabla a hozzarendelt CSOMOPONTOKAT tarolja; az
/// alattuk levok a `collectUnitSubtreeIds` bejarasabol jonnek, lekerdezeskor. Ha
/// a reszfat ide irnank ki, egy uj alcsomopont felvetele CSENDBEN kihagyna azt
/// mindenkinek, akinek a hozzarendelese korabban keszult.
///
/// `Cascade` mindket iranyban, es ez KULONBOZIK a naplotol: egy hozzarendeles
/// nem tortenelem, hanem AKTUALIS allapot. Ha a felhasznalo vagy az alegyseg
/// megszunik, a hozzarendelesnek nincs mit jelentenie.
/// ERTESITESI SZEREPEK -- MEGNEVEZETT KESZLET, NEM KULON LOGIKAI OSZLOPOK.
///
/// Balazs 2026-09-22-en MASODSZOR kert ertesitesi jelolonegyzetet a sajat
/// felhasznaloinkra, es maga mondta, hogy tobb pont jon. Ket logikai mezo meg
/// nem rendszer -- de a harmadik mar az, es akkor mar hat helyen kell
/// karbantartani ugyanazt.
///
/// EZERT KESZLET: a kovetkezo pontok UJ ELEMKENT kerulnek ide, nem uj
/// OSZLOPKENT a `User`-re. Egy elemmel indul, es nem epul ra adminisztracio,
/// amit senki nem kert.
enum NotificationRole {
  /// Ugyfel hibajegyet nyitott a partnerportalon.
  SERVICE_JOB_OPENED
  /// A MASODIK PONT, AMIT A FEJLEC MEGJOSOLT. Szervizes anyagigenyt kuldott a
  /// munkalaprol (Balazs kerese, 2026-09-22 12:15:46 UTC). Csak az ERTESULES
  /// szerepe -- a beerkezes JELOLESE kulon jogosultsag, lasd
  /// `ServiceCapability.MATERIAL_REQUEST_MARK_RECEIVED`: Balazs kifejezetten
  /// KET FUGGETLEN jelolonegyzetet kert (2026-09-22 20:28:56 UTC, "Nem. Ket
  /// kulon jelolo legyen"), es a ketto EGYMAS NELKUL is allithato.
  MATERIAL_REQUEST_CREATED
}

/// KI KAP ERTESITEST, ES MIROL.
///
/// KAPCSOLOTABLA, NEM TOMB-OSZLOP a `User`-en, es ez a haz mintaja: a semaban
/// EGYETLEN enum-tomb oszlop sincs, a tobbszoros hozzarendelesek mind sajat
/// tablaban allnak (`ServiceJobAssignee`, `UserWorksheetDepartment`).
///
/// A `role` INDEXELT, es ez nem elorelatas: a kuldes pontosan erre az oszlopra
/// kerdez ra ("kinek van meg ez a szerepe"), minden egyes ugyfel-bejelentesnel.
model UserNotificationRole {
  userId     String
  role       NotificationRole
  assignedAt DateTime         @default(now())

  user User @relation("UserNotificationRole", fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
}

/// KI VEGEZHET EGY MUVELETET, MEGNEVEZETT KESZLET -- UGYANAZ A HAZI MINTA,
/// MINT `UserNotificationRole`-NAL, DE SZANDEKOSAN KULON TABLA.
///
/// A ketto MAS TENGELY: az ertesites arrol szol, KI ERTESUL, ez arrol, KI
/// VEGEZHETI EL. Egy kozos tablaba tenni oket pontosan az a hiba lenne, amit
/// ez a haz mashol elkerul (lasd a mobil valasz-tukor orzojet, 2026-09-22
/// este): egy megkulonbozteto ket szerepet viselne, es a kesobbi olvaso nem
/// tudna, melyiket nezi.
///
/// Balazs a ket jelolot KIFEJEZETTEN fuggetlennek kerte (2026-09-22 20:28:56
/// UTC): ugyanaz az ember lehet mindkettő, csak egyik sem, vagy barmelyik
/// egyedul.
enum ServiceCapability {
  /// A "szerviz anyagbeszerzes" jelolonegyzet MASODIK fele: az "anyag
  /// beerkezett" gomb megnyomasa a munkalapnal. SZANDEKOSAN NEM
  /// "MATERIAL_REQUEST_FULFILL" -- az a szerepet neveznte meg (a beszerzest
  /// vegzi), holott a jelolo csak EGY dolgot enged: a beerkezes RÖGZITESET.
  /// A ketto ma egyben jar (aki beszerzi, az jelzi is), de a nev a
  /// MUVELETET mondja, nem a szemelyt mogotte -- acrobot javaslata,
  /// 2026-09-22 22:41.
  MATERIAL_REQUEST_MARK_RECEIVED
}

/// LASD `UserNotificationRole` FEJLECET -- BETURE UGYANAZ AZ ALAK, MAS
/// TENGELYRE. A `role` nev helyett `capability`, hogy egy olvaso a mezo
/// nevebol is lassa, melyik tablat nezi.
model UserServiceCapability {
  userId     String
  capability ServiceCapability
  assignedAt DateTime          @default(now())

  user User @relation("UserServiceCapability", fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, capability])
  @@index([capability])
}

model UserWorksheetDepartment {
  id           String   @id @default(cuid())
  userId       String
  departmentId String
  createdAt    DateTime @default(now())

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  department WorksheetDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  /// UGYANAZT AZ EGYSEGET KETSZER hozzarendelni ertelmetlen, es a duplikatum a
  /// reszfa-bejarasban NEM okozna hibat -- csak ketszer jarna be ugyanazt.
  /// Vagyis a hiba NEMA lenne, ezert all adatbazis-szinten.
  @@unique([userId, departmentId])
  /// A LEKERDEZES IRANYA: egy felhasznalo osszes hozzarendelese, minden
  /// jegy-listazasnal. Ez az index a forgalmas ut.
  @@index([userId])
}

/// A munkalap-sorszám számlálója partner + részleg + év hármasonként.
///
/// Szándékosan tábla és nem PostgreSQL szekvencia: a `nextval` a
/// A MUNKALAPSZÁM SOROZATA: EGY SZÁMLÁLÓ ÉVENKÉNT, az egész cégre.
///
/// A szám 2026-08-27 óta nem hordozza a partner rövidítését (a lap címe már
/// azonosítja), tehát az egyediséget nem a kód megválasztása adja, hanem MAGA
/// A SOROZAT. Ha a számláló partnerenként futna tovább, két különböző partner
/// azonos kódú egysége ugyanabban az évben ugyanazt a számot kapná, és a
/// második lap LEZÁRÁSA hasalna el a `Worksheet.number` egyediségén.
///
/// KÜLÖN TÁBLA, ÉS NEM A RÉGI KÉT KÓDMEZŐJE NULLÁZHATÓVÁ TÉVE. Az a kézenfekvő
/// alak ugyanaz a csapda lenne, mint a helyszín-fánál: a Postgresben a NULL nem
/// egyenlő önmagával, tehát a `@@unique` a globális soron NEM érne semmit, és
/// két párhuzamos lezárás két számláló-sort hozna létre ugyanarra az évre.
///
/// A régi `WorksheetNumberSequence` érintetlen marad: a benne álló kurzorok a
/// RÉGI, partneres sorozatokat írják le, és azok visszakereshetők maradnak.
model WorksheetYearSequence {
  id        String   @id @default(cuid())
  year      Int      @unique
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// tranzakció visszagörgetésekor sem adja vissza a kiosztott értéket, tehát
/// hézagot hagy. A munkalapnál a hiánytalanság könyvelési követelmény, ezért
/// a számláló ugyanabban a tranzakcióban nő, mint amelyikben a lezárás
/// megtörténik: ha a lezárás elhasal, a sorszám sem kerül elhasználásra. A
/// párhuzamos lezárást a sor szintű zár sorosítja (`ON CONFLICT DO UPDATE`).
model WorksheetNumberSequence {
  id             String   @id @default(cuid())
  partnerCode    String   @db.VarChar(8)
  departmentCode String   @db.VarChar(3)
  year           Int
  lastValue      Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([partnerCode, departmentCode, year])
}

/// A munkalap azonossága: ez az, amire a szám vonatkozik. A tartalom nem itt
/// van, hanem a verziókban - egy munkalapnak legalább egy verziója van, és a
/// lezárt verziók soha többé nem változnak.
///
/// A `number` szándékosan `null`, amíg a lap piszkozat: a sorszám a
/// LEZÁRÁSKOR kerül kiosztásra. Ha a létrehozáskor osztanánk, minden
/// eldobott piszkozat kilyukasztaná a sorozatot, és a hiányzó sorszámot
/// utólag senki nem tudná megmagyarázni a könyvelésnek.
///
/// A vevő és a részleg a lezárás után nem módosítható. A RÉSZLEG azért, mert
/// a kiosztott szám első tagja, tehát cseréje a számot érvénytelenítené, a
/// szám pedig verziók között sem változik. A VEVŐ azért, mert a lap kiléte
/// hozzá van kötve: a szám 2026-08-27 óta nem hordozza, de egy lezárt lapot
/// másik partnerre átírni nem javítás, hanem egy másik lap.
model Worksheet {
  id                   String    @id @default(cuid())
  /// A KLIENS ÁLTAL ADOTT MŰVELET-AZONOSÍTÓ, A HELYSZÍNI RÖGZÍTÉS
  /// IDEMPOTENCIA-KULCSA. Ugyanaz a fogalom és ugyanaz a szabály, mint az
  /// `Asset.clientOperationId` mezőnél -- SZÁNDÉKOSAN egy minta a kettőre,
  /// mert a telefonon EGY sor viszi mind a kettőt, és két különböző
  /// idempotencia-szabály abban a sorban a legrosszabb hely.
  ///
  /// ELHAGYHATÓ: a webes felvitel nem küld kulcsot, és ma működik. EGYEDI: a
  /// létrehozás előtti keresés mellett ez vágja el a két párhuzamos kérést is.
  clientOperationId    String?   @unique
  /// Teljes, emberi olvasású szám (`BIO-2026-001`) - csak lezárt lapnál.
  number               String?   @unique
  /// A sorozat éve és a sorszám nyers értéke, hogy a hiánytalanság
  /// ellenőrzéséhez ne kelljen szöveget visszafejteni.
  numberYear           Int?
  sequence             Int?
  customerId           String
  departmentId         String
  createdById          String?
  /**
   * A HIBAJEGY, AMI MÖGÖTT EZ A LAP ÁLL - ELHAGYHATÓAN, ÉS UTÓLAG IS FELVEHETŐEN.
   * A lap KELETKEZHET hibajegy nélkül, és ez nem kivétel, hanem az egyik
   * rendes út: karbantartás közben derül ki, hogy valami elromlott, a szerelő
   * ott helyben felveszi a lapot, és a hibajegy NÁLUNK születik meg utólag
   * (Balázs, 2026-09-02). Ezért nullable.
   * ÉS EZÉRT KELL AZ UTÓLAGOS CSATOLÁS IS: nem elég, hogy a hibajegy
   * létrehozásakor lehessen lapot választani - egy MÁR MEGLÉVŐ lapnak is
   * hibajegy alá kell tudnia kerülni. Enélkül a fenti út második fele nem megy
   * végig.
   * Egy hibajegyhez több lap tartozhat; ez a mező annak a másik oldala, és
   * épp ezért nem kell kapcsolótábla.
   */
  serviceJobId         String?
  /**
   * AZ ÁTADÁS: A SZERELŐ VÉGZETT, ÉS A LAP A SZOLGÁLTATÓÉ.
   * KÜLÖN MEZŐ, NEM ÚJ ÁLLAPOT A `WorksheetVersionStatus` ENUMBAN, és ez a
   * megkülönböztetés fontosabb, mint amilyennek látszik: az a négy állapot az
   * ÜGYFÉL aláírásáról szól (piszkozat, aláírásra vár, aláírva, elutasítva),
   * az átadás pedig arról, hogy a SZERELŐ végzett. Két külön tengely.
   * Egy ötödik enum-érték azt jelentené, hogy az átadott lap se nem `DRAFT`,
   * se nem `AWAITING_SIGNATURE` - tehát minden mai ellenőrzés, ami erre a
   * párra épül, más ágra futna. Az a fajta változás, ami zölden átmegy, és
   * később egy egészen más helyen robban.
   * A CÍMZETT NINCS TÁROLVA, mert nincs is: a lap hozzánk kerül vissza, a
   * szolgáltatóhoz. Amikor a lap hibajegy nélkül születik, még felelős sincs,
   * akinek címezni lehetne.
   * === A JELENTÉSE 2026-09-21-ÉN BŐVÜLT, ÉS EL IS DŐLT ===
   * A fenti bekezdés 2026-09-02-i, és AKKOR IGAZ VOLT: a mezőnek nem volt
   * írója, tehát csak a LAP mozgásáról szólt (a szerelő végzett, a lap a
   * szolgáltatóé). Egy író nélküli mező dokumentációja nem viselkedést ír le,
   * hanem egy feltevést.
   * 2026-09-21-én írót kapott (#908), és ezzel a jelentése az ESZKÖZRE
   * szélesedett. Balázs döntése (2026-09-21 09:39, Discord, Munkalap
   * folyamatok szál), szó szerint: „ne zarhassuk le amig nalunk van".
   * Vagyis az átadás NEM dátum-mező, hanem FELTÉTEL: a hibajegy lezárásának
   * egyik kapuja.
   * A KÉT OLVASAT ELLENTÉTES IRÁNYÚ VOLT (az egyik szerint az átadás felénk
   * történik, a másik szerint tőlünk), és a gazda mondata döntött: TŐLÜNK.
   * === AMIT EBBŐL A KÓDNAK TUDNIA KELL ===
   * A HELYSZÍNI MUNKÁNÁL NINCS MIT VISSZAADNI, és a mező mégis kitöltendő.
   * Ez tudatos: a jelölés MINDEN lapra kell, mert nem a gép helyét tároljuk
   * (azt nem tudjuk), hanem azt, hogy a szerelő LEZÁRTA-e a lap útját. Ezért
   * a felhasználónak szóló szöveg sem azt mondja, hogy az eszköz nálunk van,
   * hanem hogy az átadás nincs rögzítve -- az utóbbi helyszíni munkánál is
   * igaz marad.
   * ÉS EGY MÉRT TÉNY, AMIRE NE ÉPÍTSEN SENKI: a kapu bevezetésekor (mérve az
   * éles adaton, 2026-09-21) KÉT MÁR LEZÁRT hibajegynek volt jelöletlen
   * lapja. Vagyis a `COMPLETED` állapot megléte NEM bizonyítja, hogy a lapjai
   * át voltak adva. Aki ebből visszafelé következtet, hibás eredményt kap.
   */
  handedOverAt         DateTime?
  handedOverById       String?
  /**
   * A REJTES: A LAP KIKERUL A LISTAKBOL, DE MEGMARAD.
   * Balazs kerese, 2026-09-18 08:01 UTC, szo szerint: "tunjenek el" -- a
   * kerdesre, hogy a probalapok tunjenek el a listakrol VAGY legyenek vegleg
   * torolve. Az elso agat valasztotta.
   * IDOBELYEG PLUSZ SZERZO, NEM `isActive` BOOLEAN, es a minta a KOZVETLEN
   * szomszed (`handedOverAt` plusz `handedOverById`), nem a
   * `WorksheetDepartment.isActive`. A par a "mikor" es a "ki" kerdesre is
   * valaszol; egy boolean csak arra, hogy "rejtett-e".
   * AMIT EZ NEM CSINAL, ES EZ A LENYEG: nem torol. Sem sort, sem fajlt. A lap
   * dokumentumai mogott VALODI fajlok allnak a taroloban -- egy rejtes, ami
   * takarit, mar torles, csak mas neven. Es a SZAM is foglalva marad: a
   * `number` egyedi, es a papiron mar kint levo peldany kulonben egyszer csak
   * valami masra mutatna.
   * A RESZLETLAP ELERHETO MARAD azonositoval. Egy rejtett lap nem "nem
   * letezik", csak nincs a listaban.
   */
  hiddenAt             DateTime?
  hiddenById           String?
  /// A lap, aminek ez a folytatása.
  ///
  /// Egy aláírt munkalap végleges: nem készül róla új verzió, a munka
  /// folytatása ÚJ lap. Az új lap a SAJÁT sorszámát kapja ugyanabból a
  /// sorozatból, mert két külön dokumentum, amit külön írnak alá, nem
  /// osztozhat egy számon.
  ///
  /// NEM egyedi, tehát egy lapnak több folytatása is lehet. Az egyediség
  /// tiltaná azt az esetet, amikor egy aláírt lap után két külön munka
  /// következik, és arra nincs döntés -- egy megkötés, ami valódi esetet zár
  /// ki, drágább, mint egy lánc, ami elágazhat.
  continuesWorksheetId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer         Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  department       WorksheetDepartment @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdBy        User?               @relation("WorksheetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// `SetNull`: egy törölt hibajegy nem viheti magával a lapot. A lap önálló
  /// dokumentum, ami a hibajegy nélkül is létezhet - épp ezzel kezdődik a
  /// második út.
  serviceJob       ServiceJob?         @relation(fields: [serviceJobId], references: [id], onDelete: SetNull)
  handedOverBy     User?               @relation("WorksheetHandedOverBy", fields: [handedOverById], references: [id], onDelete: SetNull)
  /// `SetNull`, ugyanugy, mint az atadonal: ha a rejto kollega sora eltunik, a
  /// lap REJTVE MARAD, csak a nev veszik el. Forditva (kaszkad) egy torolt
  /// kollega osszes rejtese visszaallna, es a probalapok ujra megjelennenek.
  hiddenBy         User?               @relation("WorksheetHiddenBy", fields: [hiddenById], references: [id], onDelete: SetNull)
  versions         WorksheetVersion[]
  assignees        WorksheetAssignee[]
  /// `Restrict`: a folytatás a régi lapra hivatkozik mint előzményre, és egy
  /// lánc, aminek eltűnt az egyik vége, könyvelésnél használhatatlan.
  continues        Worksheet?          @relation("WorksheetContinuation", fields: [continuesWorksheetId], references: [id], onDelete: Restrict)
  /// Amit ebből a lapból folytattak. A visszahivatkozás azért kell, mert a
  /// RÉGI lapon is látszania kell, hogy van folytatása -- egy lánc, aminek
  /// csak az egyik vége ismeri a másikat, nem lánc.
  continuedBy      Worksheet[]         @relation("WorksheetContinuation")
  /// A jegy naploja, ahol EZ a lap szerepel (csatolas es levalasztas).
  serviceJobEvents ServiceJobEvent[]   @relation("ServiceJobEventWorksheet")
  /// A lap által érintett eszközök. A hibajegyből nyitott lap a jegyéivel
  /// indul; onnantól a lap saját adata.
  assets           WorksheetAsset[]

  documents        WorksheetDocument[]
  /// A MUNKANAPLO: mit csinalt a szerelo, sajat szavaival.
  entries          WorksheetEntry[]
  /// ANYAGIGENYEK -- A LAPHOZ KOTVE, NEM A VERZIOHOZ, UGYANAZON OKBOL, MINT A
  /// `documents` ES AZ `assignees`: a munka kozben merul fel, nem a szamlazott
  /// tartalom resze, es egy lezart verzio nem korlatozhatja. Lasd a
  /// `MaterialRequest` fejlecet.
  materialRequests MaterialRequest[]

  @@index([customerId, createdAt])
  @@index([departmentId])
  @@index([numberYear, sequence])
  @@index([continuesWorksheetId])
  /// A hibajegy lapjainak listázása ezen megy: egy hibajegyhez több lap.
  @@index([serviceJobId])
  /// MINDEN LISTA EZEN SZUR, ALAPBOL. Nem "hatha" index: a rejtes bevezetese
  /// utan a lista-lekerdezesnek NINCS olyan utja, ami ne nezne ezt az oszlopot.
  @@index([hiddenAt])
}

/// Ki dolgozik a munkalapon. Kapcsolótábla és nem `assigneeId` mező, mert
/// egy lapnak TÖBB felelőse lehet (Balázs döntése, 2026-08-19 11:16) - egy
/// mezőt utólag több-értékűvé alakítani migráció és kódátírás, most még nem az.
///
/// A hozzárendelés a munkalap AZONOSSÁGÁHOZ tartozik, nem a verzióhoz. Aki a
/// lapon dolgozik, az nem a dokumentum tartalma: ha a verzióra kerülne, egy
/// aláírt lap módosításakor a verzió-eltérésben jelenne meg (pedig nem a
/// dokumentum változott), és a lezárt verzión soha többé nem lehetne
/// hozzárendelést javítani.
///
/// A `createdBy` ettől külön marad: aki a lapot felvette, és aki a munkát
/// végzi, tipikusan nem ugyanaz - az iroda nyit lapot a szerelőnek.
model WorksheetAssignee {
  worksheetId  String
  userId       String
  assignedAt   DateTime @default(now())
  assignedById String?

  worksheet  Worksheet @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  user       User      @relation("WorksheetAssignee", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?     @relation("WorksheetAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  /// A páros maga az azonosság, ezért nincs külön `id`: egy pótkulcs mellett
  /// ugyanaz az ember kétszer is felkerülhetne ugyanarra a lapra.
  @@id([worksheetId, userId])
  /// A szerelő saját lapjainak listája ezen az indexen fut.
  @@index([userId, assignedAt])
}

/// Egy munkalap egy változata, teljes tartalommal. A módosítás nem írja át a
/// lezárt lapot, hanem új verziót hoz létre; a korábbi verzió változatlanul
/// megmarad, megnyithatóan és nyomtathatóan. A szám nem változik, a verzió
/// külön tag: `BIO-2026-001/2`.
///
/// A `changeReason` az 1. verziónál `null`, minden továbbinál kötelező - a
/// napló üres indoklással nem ér semmit. Az, hogy MIT változott, nem külön
/// táblában áll: mindkét verzió teljes és megváltoztathatatlan, tehát a
/// mezőnkénti eltérés belőlük bármikor pontosan előállítható (lásd
/// `apps/api/src/worksheets/worksheet-diff.ts`). Egy másolt diff ezzel
/// szemben el tudna térni attól, amit naplóz.
model WorksheetVersion {
  id          String                 @id @default(cuid())
  worksheetId String
  version     Int
  status      WorksheetVersionStatus @default(DRAFT)

  /// Munka tárgya, ma szabad szöveg.
  subject     String
  /// Az alegység neve ABBAN a pillanatban, amikor ez a verzió íródott. Nem
  /// külön szerkeszthető mező: a `Worksheet.department` sorból másolódik.
  /// Azért másolat, mert az alegység átnevezése különben visszamenőleg
  /// átírná a már lezárt (és esetleg aláírt) lapokon látható szöveget.
  unitName    String?
  description String?

  issueDate       DateTime? @db.Date
  fulfillmentDate DateTime? @db.Date
  dueDate         DateTime? @db.Date

  /// ISO 4217 pénznemkód.
  currency    String  @default("HUF") @db.VarChar(3)
  /// A sorokból számolt összegek, a kliens által küldött érték nélkül.
  netAmount   Decimal @default(0) @db.Decimal(19, 4)
  vatAmount   Decimal @default(0) @db.Decimal(19, 4)
  grossAmount Decimal @default(0) @db.Decimal(19, 4)

  changeReason String?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  closedAt     DateTime?
  closedById   String?

  /// MIKOR KULDTUK KI ALAIRASRA, ES KINEK.
  ///
  /// === MIERT KET MEZO, ES MIERT NEM UJ ALLAPOT (2026-09-21) ===
  ///
  /// A lezaras 2026-09-21-ig MAGA tette alairhatova a lapot: a `close()` a
  /// `DRAFT`-ot `AWAITING_SIGNATURE`-re allitja, es az alairas pontosan ezt az
  /// egy allapotot koveteli meg. Balazs kerese viszont KET dolgot kulonboztet
  /// meg: lezartuk, ES ki is kuldtuk. Amig ez a ket mezo nem letezett, MINDEN
  /// lezart lap alairhato volt a portalon -- akkor is, ha soha nem kuldtuk ki.
  ///
  /// UJ ENUM-ERTEK HELYETT AZERT MEZO:
  ///   - a CIMZETTET amugy is tarolni kell (Balazs dontese, 2026-09-21 14:00:58:
  ///     a lap tetejen is latszodjon, kinek kuldtuk el) -- azt egy enum-ertek
  ///     nem hordozza;
  ///   - additiv: a negy allapotot olvaso tizennegy forrasfajl egyike sem torik;
  ///   - es a kesobbi "a modositas ervenyteleniti a kerest" dontes (2026-09-21
  ///     13:59) igy egy mezo NULLAZASA, nem allapot-visszalepteles -- az utobbi
  ///     a SIGNED es a REJECTED aggal utkozne.
  ///
  /// NEM KELL BACKFILL, ES EZ MERVE VAN: az eles adatbazisban NULLA
  /// `AWAITING_SIGNATURE` sor all (a teljes tabla negy sor: 2 SIGNED, 2 DRAFT,
  /// merve 2026-09-21 18:05, acropora-prod-01). Nincs olyan meglevo lap, amit a
  /// `NULL` kezdoertek megbenitana.
  sentForSignatureAt       DateTime?
  sentForSignatureToUserId String?

  worksheet          Worksheet                  @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  createdBy          User?                      @relation("WorksheetVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  closedBy           User?                      @relation("WorksheetVersionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  /// A CIMZETT `SetNull`-lal all, mint a tobbi aktor-mezo: egy azota torolt
  /// felhasznalo nem viheti magaval a lap tortenetet. A KIKULDES TENYE
  /// (`sentForSignatureAt`) ilyenkor is megmarad -- a ketto kulon mezo, es a
  /// "kikuldtuk" allitas nem fugghet attol, hogy a cimzett fiokja meg el-e.
  sentForSignatureTo User?                      @relation("WorksheetVersionSentTo", fields: [sentForSignatureToUserId], references: [id], onDelete: SetNull)
  lines              WorksheetLine[]
  signature          WorksheetVersionSignature?
  /// A VERZIOHOZ KOTOTT DOKUMENTUMOK: ma kizarolag a lezaraskor generalt lap.
  /// A feltoltott fenykep NEM ide tartozik, hanem a MUNKALAPHOZ -- egy keszulek
  /// fenykepe nem egy verziorol szol.
  documents          WorksheetDocument[]

  @@unique([worksheetId, version])
  @@index([status, closedAt])
}

/// Munkalap-tétel. A `detail` a valódi dokumentum kiegészítő sora, ami ma
/// kézzel beírt gépazonosító; ha az eszköz nyilvántartott, az `assetId`
/// köti hozzá. Az eszköz `Restrict`, nem `SetNull`: egy lezárt verzió
/// tartalma nem változhat meg attól, hogy máshol törölnek egy sort.
model WorksheetLine {
  id                 String            @id @default(cuid())
  worksheetVersionId String
  position           Int
  description        String
  detail             String?
  assetId            String?
  quantity           Decimal           @db.Decimal(19, 6)
  /// Mértékegység (db, óra) - soronként változik, ma szabad szöveg.
  unit               String
  /// A tétel fajtája. Ez dönti el, beleszámít-e az összesített munkaórába --
  /// NEM a `unit` szövege. Lásd a WorksheetLineKind fejlécét.
  kind               WorksheetLineKind @default(OTHER)
  /// HÁNYAN DOLGOZTAK A TÉTELEN. A tétel munkaórája: `quantity * workerCount`.
  ///
  /// Balázs kérése és egyben a mérce (2026-09-17): "ha egy tétel 0,5 óra de
  /// ketten dolgoztak rajta akkor az 1 óra".
  ///
  /// MIÉRT KÖTELEZŐ, ALAPÉRTELMEZÉSSEL, ÉS NEM ELHAGYHATÓ: egy `null` és egy
  /// `1` UGYANAZT jelentené (egy ember dolgozott rajta), tehát két állapot
  /// állna egy jelentésre. Az alapértelmezés emellett a MA LÉTEZŐ sorokat is
  /// értelmessé teszi: mindegyik egy emberrel számol, és egyik összeg sem
  /// változik meg attól, hogy ez a mező megjelenik.
  workerCount        Int               @default(1)
  /// AZ ÁR HIÁNYOZHAT, ÉS EZ SZÁNDÉKOS.
  ///
  /// A szerelő a helyszínen azt rögzíti, MIT csinált és MENNYIT; az árat az
  /// iroda adja meg (Balázs döntése, 2026-09-02). Egy kötelező mező mellett a
  /// telefonnak találomra kellene értéket küldenie - és a kézenfekvő nulla a
  /// lapon ÉRTÉKKÉNT állna, nem hiányként: aki ránéz, nem tudja
  /// megkülönböztetni az ingyenes munkától, és semmi nem szól, ha valaki
  /// elfelejti kitölteni.
  ///
  /// AZ ÁR HIÁNYA 2026-09-17 ÓTA NEM AKADÁLY, ÉS EZ BALÁZS DÖNTÉSE.
  ///
  /// Eddig ár nélküli tétellel a lap nem volt lezárható. Balázs azt kérte, hogy
  /// a nettó, bruttó és áfa mezők SEHOL ne jelenjenek meg (sem a weben, sem az
  /// appban, sem a nyomtatott lapon), és a két elé tett út közül a "B"-t
  /// választotta: tűnjenek el mindenhonnan, és akkor a lezárásból is ki kell
  /// venni az ár-feltételt.
  ///
  /// Ha az ár sehol nem látszik, nincs hol megadni -- egy megmaradó feltétel
  /// mellett EGYETLEN lapot sem lehetett volna lezárni.
  ///
  /// AZ OSZLOP MARAD (Balázs: "ne töröljük ezeket"), és ár továbbra is
  /// RENDELHETŐ egy tételhez. Ami megszűnt, az az, hogy a hiánya megállít
  /// valamit -- és ebből következik, hogy a számlázási alap nem a munkalapról
  /// jön.
  unitNet            Decimal?          @db.Decimal(19, 4)
  vatRatePercent     Decimal?          @db.Decimal(5, 2)
  /// Az összegek az egységárból számolnak, tehát nélküle nincs mit tárolni.
  /// Nem nulla: a nulla összeg egy elvégzett, ingyenes munka, ami más.
  netAmount          Decimal?          @db.Decimal(19, 4)
  vatAmount          Decimal?          @db.Decimal(19, 4)
  grossAmount        Decimal?          @db.Decimal(19, 4)

  worksheetVersion WorksheetVersion @relation(fields: [worksheetVersionId], references: [id], onDelete: Cascade)
  asset            Asset?           @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([worksheetVersionId, position])
  @@index([assetId])
}

/// EGY BEJEGYZES A MUNKALAP MUNKANAPLOJABAN: mit csinalt a szerelo, sajat
/// szavaival (Balazs kerese, 2026-09-03: "legyen rajta egy bejegyzes nevu gomb
/// amire ha rakattint akkor szabadszavasan beirhatja, hogy mit csinalt").
///
/// === A MUNKALAPHOZ TARTOZIK, NEM A VERZIOHOZ ===
///
/// Az alairas a VERZIOE, mert azt egy adott tartalom igazolasa. A bejegyzes
/// nem tartalom, hanem NAPLO: arrol szol, MI TORTENT, nem arrol, mi all a
/// lapon. Egy uj verzio keszitese nem torolheti a munkanaplot -- ha a
/// verziohoz kotnenk, minden modositas ujrakezdene a tortenetet.
///
/// === ES NEM A `ServiceJobEvent`-BE KERUL, PEDIG ELSORE ODAILLIK ===
///
/// Annak van `note` mezoje, aktora es idopontja, sot `worksheetId`-ja is. A
/// kulonbseg szerkezeti: a `ServiceJobEvent` a HIBAJEGY ala van kotve,
/// KOTELEZO `serviceJobId` mezovel es Cascade torlessel. Egy hibajegy NELKULI
/// munkalap tehat nem tudna bejegyzest hordozni -- az pedig nem hibas eset,
/// hanem az egyik rendes ut (a szerelo a helyszinen felveszi a lapot, es a
/// jegy nalunk szuletik meg utolag). Oda teve a funkcio CSENDBEN nem mukodne
/// pont azokon a lapokon, amik a telefonon keletkeznek.
model WorksheetEntry {
  id          String   @id @default(cuid())
  worksheetId String
  /// A szoveg, ahogy a szerelo beirta. Nincs formazas es nincs szerkezet: a
  /// mezo egyetlen dolga, hogy megorizze, amit mondani akart.
  body        String
  /// KI IRTA. `SetNull` a felhasznalo torlesekor, es ez nem kenyelem: egy
  /// tavozo kollega bejegyzese NEM tunhet el, mert a naplo rola szol. A
  /// felulet KIMONDJA, hogy a szerzo ismeretlen, nem elrejti a sort.
  authorId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  worksheet Worksheet @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  author    User?     @relation("WorksheetEntryAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  /// A LISTA IDOREND SZERINT MEGY, es a lap az egyetlen szuro. Az index a
  /// parost fedi, mert a lekerdezes mindig egy lapra szol.
  @@index([worksheetId, createdAt])
  @@index([authorId])
}

/// ANYAG, AMI HIANYZIK A MUNKA ELVEGZESEHEZ. Balazs szo szerinti kerese,
/// 2026-09-22 12:15:46 UTC: a szervizes munka kozben veszi eszre, hogy kell
/// valami, felviszi a teteleket, es "ha kesz van ranyom az elkuld gombra".
///
/// === A MUNKALAPHOZ TARTOZIK, NEM A VERZIOHOZ ===
///
/// Nem talalgatas: a haz mar ketszer eldontotte ugyanezt a kerdest, es mindket
/// dontes ide illik.
///
///   WorksheetLine (szamlazhato, alairt TARTALOM)  -> worksheetVersionId
///   WorksheetDocument (a munkarol szolo BIZONYITEK) -> worksheetId
///   WorksheetAssignee (ki dolgozik a lapon)          -> worksheetId
///
/// Az anyagigeny a masodik ket fajtaba tartozik: nem szamlazott, nem az
/// ugyfel irja ala, es a munkavegzes KOZBEN keletkezik. A verziohoz kotve
/// vagy elveszne egy uj verzional, vagy egy lezart verziohoz kellene nyulni.
///
/// === A "BEJEGYZES" MAGA EZ A SOR, NINCS KULON NAPLO-TETEL ===
///
/// Balazs szava: "errol keszul egy bejegyzes". A hazban NINCS WorksheetEvent
/// (van AssetEvent, ServiceJobEvent, de a Worksheet-nek nincs sajat
/// esemeny-tablaja), es a `WorksheetEntry` (munkanaplo) szabad szoveg, nem
/// strukturalt tetel-lista. Uj altalanos esemeny-rendszert epiteni csak
/// emiatt tulepitesnek tunik -- ez a sor MAGA a bejegyzes: ki kerte, mikor,
/// mit, es (ha megtortent) ki es mikor jelolte beerkezettnek. EZ AZ EN
/// OLVASATOM, nem meres.
///
/// === KET LEPES, KET ALLAPOT -- JAVITVA, MIELOTT MEGEPULT VOLNA ===
///
/// Balazs kerese ket mozzanatot ir le (tetel-felvitel, majd kulon "elkuld"
/// gomb). Az ELSO valtozatom ezt UGY-kerdesnek nezte (a felhasznalo
/// helyileg allitja ossze a listat, a sor csak kuldeskor jon letre, EGY
/// hivasban) -- acrobot kijavitotta, mielott kod epult volna ra: "Az
/// API-reteg tudja, hogy a letrehozas es az ELKULDES ket kulon muvelet...
/// Ha ez a szeletbe nem kerul bele, a web-szelet fogja kitalalni, es akkor
/// az allapot-gep a feluleten szuletik meg -- rossz helyen."
///
/// EZERT A `MaterialRequestStatus` HAROM ERTEKET VESZ FEL, LASD LENT. A sor
/// MAR A FELVITELKOR letrejon `DRAFT` allapotban; a kuldes egy KULON,
/// KIMONDOTT atmenet (`DRAFT` -> `OPEN`), es CSAK ez inditja az elso
/// ertesitesi kort. Ha egy DRAFT sosem kerul elkuldesre, orokre igy marad
/// -- ez nem hiba, csak nem lehet lathatatlan (acrobot kikotese): a
/// szervizes lassa a SAJAT piszkozatat a munkalapon (webes/mobil szelet).
/// HAROM ALLAPOT, NEM KETTO -- acrobot kikotese, 2026-09-22 22:52:23 UTC:
/// "Az API-reteg tudja, hogy a letrehozas es az ELKULDES ket kulon muvelet,
/// es CSAK a masodik indit ertesitest." A DRAFT -> OPEN atmenet EGYETLEN,
/// KIMONDOTT lepes -- ha ez a mezoben nincs benne, az allapot-gep a
/// FELULETEN szuletne meg, rossz helyen (lasd `MaterialRequest` fejlecet).
enum MaterialRequestStatus {
  /// A szervizes MEG FELVISZI a teteleket, nem kuldte el. Ertesites NEM megy
  /// -- addig nincs mit ertesiteni. Ha egy DRAFT sosem kerul elkuldesre,
  /// orokre itt marad; ez nem hiba, de a feluleten LATHATO kell maradjon a
  /// SAJAT letrehozojanak (acrobot kikotese).
  DRAFT
  /// Elkuldve ("elkuld" gomb), a beszerzesre var. Ekkor indul az ELSO
  /// ertesitesi kor.
  OPEN
  /// Valaki megnyomta az "anyag beerkezett" gombot. Ekkor indul a MASODIK,
  /// tagabb ertesitesi kor.
  RECEIVED
}

model MaterialRequest {
  id            String                @id @default(cuid())
  worksheetId   String
  status        MaterialRequestStatus @default(DRAFT)
  requestedById String?
  /// A PISZKOZAT LETREHOZASANAK IDEJE -- NEM AZ ELKULDESE. Lasd
  /// `submittedAt` a masik idopontert.
  createdAt     DateTime              @default(now())
  /// MIKOR NYOMTA MEG AZ "ELKULD" GOMBOT. `null`, amig DRAFT. Kulon mezo a
  /// `createdAt` mellett, ugyanazon okbol, mint a `receivedAt` a
  /// `createdAt` mellett: ket kulon esemeny, ket kulon idopont.
  submittedAt   DateTime?
  receivedAt    DateTime?
  receivedById  String?

  worksheet   Worksheet             @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  /// `SetNull`, ugyanazon okbol, mint a `WorksheetEntry.authorId`-nal: egy
  /// tavozo kollega kerese nem tunhet el, csak a neve.
  requestedBy User?                 @relation("MaterialRequestRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  receivedBy  User?                 @relation("MaterialRequestReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  items       MaterialRequestItem[]

  /// A LISTA IDOREND SZERINT MEGY, es a lap az egyetlen szuro -- ugyanaz a
  /// minta, mint a `WorksheetEntry`-nel.
  @@index([worksheetId, createdAt])
  /// A BESZERZO SAJAT LISTAJA EZEN FUT: "ram varo anyagigenyek", vagyis a
  /// meg nem `RECEIVED` sorok, allapot szerint szurve.
  @@index([status, createdAt])
}

/// EGY TETEL AZ ANYAGIGENYEN. HAROM SZABAD SZOVEGES MEZO, NEM KETTO, ES EGYIK
/// SEM VALIDALT -- Balazs kifejezett kerese, 2026-09-22 20:26:14 UTC: "A nev
/// szabad szoveg utana a mennyiseg es egyseg kulon mezoben hogy legyen valami
/// formalya. Oda is azt irbe amit akar de legyen kulon."
///
/// A `quantity` SZANDEKOSAN String, NEM Decimal: az eredeti peldaja "10
/// meter" volt, ami egy szam-mezobe nem fer, es Balazs kimondta, hogy oda is
/// szabad szoveg megy ("kb 10" is). A harom mezo a FORMAROL szol, nem az
/// ellenorzesrol -- keszlet-kapcsolat, termek-azonosito es
/// egyseg-torzsadat MA nincs.
model MaterialRequestItem {
  id                String @id @default(cuid())
  materialRequestId String
  position          Int
  /// Pl. "40mm konyok".
  name              String
  /// Pl. "2", vagy "10 meter" -- szabad szoveg.
  quantity          String
  /// Pl. "db" -- szabad szoveg.
  unit              String

  materialRequest MaterialRequest @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)

  @@unique([materialRequestId, position])
}

/// Az aláírás a VERZIÓHOZ tartozik, nem a munkalaphoz. Ha egy már aláírt lap
/// módosul, a régi aláírás az előző verziót igazolja, és az újra nem
/// érvényes: az új verzió állapota "aláírásra vár". Enélkül előállna az az
/// eset, hogy egy aláírás olyan dokumentumot igazol, ami már nem létezik.
///
/// Ez a v0 minimális, belső változata: a döntést egy belépett felhasználó
/// rögzíti. Az e-mailes link, a külsős belépés, a megnyitás-nyom és a
/// küldéskori dokumentum-hash NEM része ennek a szeletnek.
/// HONNAN JOTT AZ ALAIRO NEVE.
///
/// Balazs kerese, 2026-09-04: az ugyfel neve legorduloből valaszthato, es ha
/// "egyik sem", akkor a szerelo irja be -- DE AKKOR JELEZNI KELL, hogy nem az
/// irta ala, akie a munkalap.
///
/// A JELZES TAROLT ALLAPOT, NEM KEPERNYO-SZOVEG (acrobot dontese, 2026-09-04).
/// Igy az uj sorok MAGUKROL mondjak meg, melyik agon keletkeztek.
///
/// ES AZ `null` A HARMADIK ALLAPOT: a 2026-09-04 ELOTTI sorokon ez a mezo
/// ures, es ott a `signerName` MAST jelentett -- a mobilon a SZERELO nevet, a
/// weben az ugyfelet. Visszamenoleg nem tudjuk eldonteni, melyiket, es egy
/// kitalalt ertek rosszabb, mint egy ketertelmu: ezert nincs ra migracio, es
/// ezert a HIANY maga a megkulonboztetes.
enum WorksheetSignerSource {
  /// A szerelo a lap partnerenek egy munkatarsat valasztotta a listarol.
  SELECTED
  /// "Egyik sem": a szerelo irta be a nevet. A lap ezt KIMONDJA.
  TYPED
  /// A SZOLGALTATO SAJAT MUNKATARSA irta ala, azonositva.
  ///
  /// Balazs kerese, 2026-09-18 07:01 UTC: "Es az elozo kepernyon utolso gomb
  /// Alairom." A sajat szervizesunk sajat maga ir ala, nem az ugyfel.
  ///
  /// A KLIENS NEM KULD AZONOSITOT: a szerver a HITELESITETT AKTORT veszi.
  /// Ettol nincs mit hamisitani a keres torzseben -- ha a kliens valaszthatna
  /// alairot, a mezo nevesitve adna at egy hatalmat, amit ma senki nem kapott.
  ///
  /// ES EZ AZ ERTEK A LAPON IS LATSZIK, nem csak a naploban. Egy alairt
  /// munkalap bizonyitek: ha a papiron nem latszik, hogy az alairo a
  /// SZOLGALTATO embere volt, a lap tobbet allit, mint ami tortent.
  INTERNAL
}

model WorksheetVersionSignature {
  id                 String                     @id @default(cuid())
  worksheetVersionId String                     @unique
  decision           WorksheetSignatureDecision
  /// Az aláíró neve, ahogy aláírta - nem a fiók megjelenített neve.
  ///
  /// 2026-09-04 OTA EZ AZ UGYFEL EMBERE, mindket feluleten (acrobot dontese).
  /// Korabban a mobilon a SZERELO neve allt itt, a weben az ugyfele: ugyanaz az
  /// oszlop, ket jelentes. A `signerSource` valasztja szet oket -- ahol az
  /// `null`, ott a regi, ketertelmu allapot van.
  signerName         String
  /// KIT VALASZTOTT A SZERELO a lap partnerenek munkatarsai kozul.
  ///
  /// `null`, ha "egyik sem" agon ment (a nev szabad szoveg), ES a regi sorokon
  /// is. A ketto kozott a `signerSource` kulonboztet.
  ///
  /// MIERT KELL A NEV MELLE: ket ember viselhet ugyanazt a nevet, es egy alairas
  /// utolag akkor is azonosithato kell legyen. `SetNull` a torleskor: az alairas
  /// tenye nem tunhet el egy fiok torlesevel.
  signerUserId       String?
  signerSource       WorksheetSignerSource?
  /// KI ROGZITETTE -- a bejelentkezett kollega, tipikusan a szerelo. NEM
  /// ugyanaz, mint az alairo: az elobbi a telefont kezeli, az utobbi alair.
  signedByUserId     String?
  signedAt           DateTime                   @default(now())
  note               String?

  worksheetVersion WorksheetVersion @relation(fields: [worksheetVersionId], references: [id], onDelete: Cascade)
  signedBy         User?            @relation("WorksheetSignedBy", fields: [signedByUserId], references: [id], onDelete: SetNull)
  signer           User?            @relation("WorksheetSigner", fields: [signerUserId], references: [id], onDelete: SetNull)

  @@index([signedByUserId, signedAt])
  @@index([signerUserId])
}

