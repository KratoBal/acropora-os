{
  "name": "@acropora/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "rm -rf test-dist && tsc -p tsconfig.test.json && specs=$(find test-dist -name '*.spec.js' ! -name '*.smoke.spec.js' ! -name '*.integration.spec.js') && { [ -n \"$specs\" ] || { echo 'Nem talaltam unit spec fajlt - nem jelentek sikert.' >&2; exit 1; }; } && node --test $specs",
    "test:assets": "tsc -p tsconfig.test.json && node --test test-dist/service-assets/qr-svg.spec.js test-dist/service-assets/service-assets.service.spec.js",
    "test:bootstrap": "tsc -p tsconfig.test.json && node --test test-dist/app.bootstrap.spec.js",
    "test:smoke": "tsc -p tsconfig.test.json && node --test test-dist/health/health.smoke.spec.js",
    "test:integration": "tsc -p tsconfig.test.json && RUN_DB_INTEGRATION=1 node --test --test-concurrency=1 test-dist/auth/auth-user-resolver.integration.spec.js test-dist/auth/session.repository.integration.spec.js test-dist/auth/auth.service.integration.spec.js test-dist/auth/partner-scope-endpoint.integration.spec.js test-dist/tasks/tasks.repository.integration.spec.js test-dist/tasks/task-ingest.integration.spec.js test-dist/imports/unas/unas-connection.repository.integration.spec.js test-dist/imports/unas/unas-import.integration.spec.js test-dist/imports/unas/unas-apply.integration.spec.js test-dist/imports/unas/unas-product-sync.integration.spec.js test-dist/inventory/unas-stock-sync-outbox.repository.integration.spec.js test-dist/orders/unas-order-sync/unas-order-sync.repository.integration.spec.js test-dist/worksheets/worksheets.repository.integration.spec.js test-dist/service-assets/unit-subtree.integration.spec.js test-dist/notifications/device-token.repository.integration.spec.js test-dist/integrations/medusa/medusa-connection.repository.integration.spec.js test-dist/integrations/medusa/medusa-product-link.integration.spec.js test-dist/suppliers/partner-code-null-semantics.integration.spec.js test-dist/products/product-write-gate.integration.spec.js test-dist/products/product-variant-selling-price.integration.spec.js test-dist/service-assets/asset-deletion.integration.spec.js test-dist/products/datasheet-refusal.integration.spec.js",
    "test:brands:integration": "tsc -p tsconfig.test.json && RUN_BRAND_INTEGRATION=1 AUTH_PROVIDER=development node --test --test-concurrency=1 test-dist/brands/brands.integration.spec.js",
    "test:unas:probe": "tsc -p tsconfig.test.json && node --test test-dist/imports/unas/unas-api.spec.js test-dist/imports/unas/unas-readonly-probe.spec.js",
    "test:unas:connection": "tsc -p tsconfig.test.json && node --test test-dist/imports/unas/unas-login-expiry.spec.js test-dist/imports/unas/unas-credential-crypto.service.spec.js test-dist/imports/unas/unas-credential.provider.spec.js test-dist/imports/unas/unas-auth.service.spec.js test-dist/imports/unas/unas-connection.service.spec.js test-dist/imports/unas/unas-connection.controller.spec.js test-dist/imports/unas/unas-connection-startup.validator.spec.js",
    "test:foxpost": "tsc -p tsconfig.test.json && node --test test-dist/integrations/foxpost/foxpost-settlement.parser.spec.js test-dist/integrations/foxpost/foxpost-monthly-report.xlsx.spec.js test-dist/integrations/foxpost/foxpost-gmail.client.spec.js test-dist/integrations/foxpost/foxpost-settlement.scheduler.spec.js test-dist/integrations/foxpost/foxpost-settlement.controller.spec.js test-dist/integrations/foxpost/foxpost-settlement.service.spec.js",
    "service-token": "tsc -p tsconfig.json && node --env-file=../../.env dist/tasks/service-token.cli.js",
    "medusa:project": "tsc -p tsconfig.json && node --env-file=../../.env dist/integrations/medusa/medusa-projection.cli.js",
    "medusa:inventory": "tsc -p tsconfig.json && node --env-file=../../.env dist/integrations/medusa/medusa-inventory.cli.js",
    "medusa:pricing": "tsc -p tsconfig.json && node --env-file=../../.env dist/integrations/medusa/medusa-pricing.cli.js",
    "datasheet:audit": "tsc -p tsconfig.json && node dist/products/datasheet-audit.cli.js",
    "ai-search:rebuild": "tsc -p tsconfig.json && node --env-file=../../.env dist/integrations/ai-product-search/ai-product-search.cli.js",
    "barcode-import": "tsc -p tsconfig.json && node --env-file=../../.env dist/products/barcode-import.cli.js",
    "unas:probe": "tsc -p tsconfig.json && node --env-file=../../.env dist/imports/unas/unas-readonly-probe.cli.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist test-dist"
  },
  "dependencies": {
    "@acropora/database": "workspace:*",
    "@acropora/types": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "exceljs": "4.4.0",
    "multer": "2.2.0",
    "pdfjs-dist": "6.2.108",
    "redis": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@acropora/config": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@types/multer": "2.2.0",
    "@types/node": "^26.1.1",
    "typescript": "^6.0.3"
  }
}
