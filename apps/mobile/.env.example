# The application environment shown in diagnostics. This value is public.
EXPO_PUBLIC_APP_ENV=development

# iOS simulator: http://localhost:3001
# Android emulator: http://10.0.2.2:3001
# Physical device: use the Mac's LAN address, for example http://192.168.1.50:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# How long the app may stay in the background before returning to the
# foreground has to pass the biometric gate again, in seconds. Defaults to
# 120. A short trip out - an incoming call, a photo from the gallery -
# should not cost a prompt; a phone left on a table should.
EXPO_PUBLIC_LOCK_THRESHOLD_SECONDS=120
